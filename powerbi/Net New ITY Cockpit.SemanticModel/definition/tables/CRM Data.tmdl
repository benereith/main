				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([bezeichnung_management] <> null and [bezeichnung_management] <> "" and [bezeichnung_management] <> "bezeichnung_management")),
				    #"Renamed Columns" = Table.RenameColumns(#"Filtered Rows", {{"NB Rohdaten", "NB/LB"}}),
				    #"Selected Columns" = Table.SelectColumns(#"Renamed Columns", {"NB/LB", "bezeichnung_management", "bezeichnung_region", "Werk - Bezeichnung", "ity_cluster", "name", "Info", "FY_JahrMonat", "ity_effect"}),
				    #"Extracted Month" = Table.TransformColumns(#"Selected Columns", {{"FY_JahrMonat", each Number.From(Text.End(_, 2)), Int64.Type}}),
				    
				    // 10. Daten sauber vorsortieren
				    #"Sorted Rows" = Table.Sort(#"Extracted Month", {{"NB/LB", Order.Ascending}, {"bezeichnung_management", Order.Ascending}, {"name", Order.Ascending}, {"FY_JahrMonat", Order.Ascending}}),
				
				    // --- NEU: Das Raster EINMALIG global definieren ---
				    GlobalePeriodenBasis = Table.TransformColumnTypes(Table.FromList({1..12}, Splitter.SplitByNothing(), {"FY_JahrMonat"}, null, ExtraValues.Error), {{"FY_JahrMonat", Int64.Type}}),
				
				    // 11. GRUPPIERUNG & LÜCKENLOSE ERWEITERUNG
				    #"Grouped" = Table.Group(#"Sorted Rows", {"NB/LB", "bezeichnung_management", "name"}, {
				        {"Data", (t as table) =>
				            let
				                JoinBasis = Table.NestedJoin(GlobalePeriodenBasis, {"FY_JahrMonat"}, t, {"FY_JahrMonat"}, "Inhalt", JoinKind.LeftOuter),
				                ExpandedInhalt = Table.ExpandTableColumn(JoinBasis, "Inhalt", {"bezeichnung_region", "Werk - Bezeichnung", "ity_cluster", "Info", "ity_effect"}),
				                FillTextCols = Table.FillDown(Table.FillUp(ExpandedInhalt, {"bezeichnung_region", "Werk - Bezeichnung", "ity_cluster", "Info"}), {"bezeichnung_region", "Werk - Bezeichnung", "ity_cluster", "Info"}),
				                SortBeforeFill = Table.Sort(FillTextCols, {{"FY_JahrMonat", Order.Ascending}}),
				                ReplaceNullEffects = Table.ReplaceValue(SortBeforeFill, null, 0, Replacer.ReplaceValue, {"ity_effect"}),
				                
				                // Performantere YTD-Berechnung über List.Generate
				                EffekteListe = ReplaceNullEffects[ity_effect],
				                YTDBerechnung = List.Skip(List.Generate(
				                    () => [Summe = 0, Index = 0],
				                    each [Index] <= List.Count(EffekteListe),
				                    each [Summe = [Summe] + EffekteListe{[Index]}, Index = [Index] + 1],
				                    each [Summe]
				                ), 1),
				                
				                TableMitYTD = Table.FromColumns(
				                    Table.ToColumns(ReplaceNullEffects) & {YTDBerechnung},
				                    Table.ColumnNames(ReplaceNullEffects) & {"ity_effect_cum"}
