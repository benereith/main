				    #"Hinzugefügte benutzerdefinierte Spalte1" = Table.AddColumn(#"Eingefügte letzte Zeichen", "Neueröffnung_CRM", each if [Eröffnungsdatum] >= #date(2025, 10, 1) and [#"NB/LB"]="NB Rohdaten" then 1 else 0),
				    #"Geänderter Typ3" = Table.TransformColumnTypes(#"Hinzugefügte benutzerdefinierte Spalte1",{{"Neueröffnung_CRM", Int64.Type}}),
				    #"Hinzugefügte benutzerdefinierte Spalte2" = Table.AddColumn(#"Geänderter Typ3", "Eröffnungsperiode", each if [Eröffnungsdatum] = null then null else if Date.Month([Eröffnungsdatum]) >= 10 then Date.Month([Eröffnungsdatum]) - 9 else Date.Month([Eröffnungsdatum]) + 3),
