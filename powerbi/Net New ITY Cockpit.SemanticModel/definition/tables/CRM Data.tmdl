table 'CRM Data'
	lineageTag: 5af530fe-3d99-42ef-abd5-98d2172b06ce

	/// Budgetierter unknown-ITY-Effekt aus der gepflegten Planungsdatei
	/// 2026_04_29_Planung_unknown_ITY_Effekt.xlsx (SharePoint, 08_Budget).
	///
	/// Bewusst NICHT aus dem Lakehouse, sondern direkt aus der Excel: die
	/// Datei ist ein manueller Planungsinput, der im Budgetprozess laufend
	/// fortgeschrieben wird. Wer die Zahl abstimmt, muss den Stand der Datei
	/// kennen – die Tabelle 'CRM Data' trägt ihn deshalb unverändert.
	measure 'Budget ITY Effect' = SUM('CRM Data'[ity effect])
		lineageTag: 5aced962-9c69-42e2-94e7-d5557c2bba61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Gesicherter plus erwarteter ITY-Anteil, also alles außer der reinen
	/// Pipeline. Die Größe, mit der sich belastbar planen lässt: Won und
	/// Lost stehen fest, Expected Win und Expected Loss liegen über der
	/// Wahrscheinlichkeitsschwelle.
	measure 'ITY relativ sicher' = [ITY gesichert]+[ITY erwartet]
		lineageTag: ad97217e-a36f-4b68-9ada-1066b94f16c8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Vollwert ohne Wahrscheinlichkeitsgewichtung, vorzeichenbehaftet.
	/// Obergrenze der Betrachtung: so viel entstünde, wenn jede Opportunity
	/// gewonnen und jeder Risikovertrag verloren würde.
	measure Unweighted = SUM('FCT Net New ITY'[Betrag ungewichtet (vorzeichenbehaftet)])
		lineageTag: 6d00cba6-d684-41e9-9d85-c0000e3be650

		annotation PBI_FormatHint = {"isGeneralNumber":true}

