/// Zentrale Faktentabelle: Perioden-Fanout aus CRM-Opportunities (New Business)
/// und CRM-Bestandsverträgen (Lost Business).
///
/// Granularität: eine Zeile je Entität und Monat.
/// Quelle: gold_fct_net_new_ity (siehe lakehouse/notebooks/nb_20_gold.py).
///
/// VORZEICHENKONVENTION – der wichtigste Unterschied zu den Altmodellen:
///   New Business  -> Betrag positiv
///   Lost Business -> Betrag negativ
/// Damit ist Net New ITY = SUM('Betrag gewichtet (vorzeichenbehaftet)').
/// In den Altmodellen wurde das Vorzeichen an mindestens fünf Stellen
/// unterschiedlich gedreht (M: *-1 in fct_opp/fct_retention; DAX: *-1 in
/// Retention_ITY, LY_REV, ARO_LY). Hier passiert es genau einmal, im Lakehouse.
table 'FCT Net New ITY'
	lineageTag: c1000000-0000-4000-8000-000000000001

	/// Schlüssel der Opportunity (opportunityid) bzw. des Vertrags
	/// (cgplc_cgcontractid).
	column 'Entität ID'
		dataType: string
		isHidden
		lineageTag: c1000000-0000-4000-8000-000000000101
		summarizeBy: none
		sourceColumn: entity_id

	/// Bezeichnung der Opportunity bzw. des Vertrags.
	column 'Entität'
		dataType: string
		lineageTag: c1000000-0000-4000-8000-000000000102
		summarizeBy: none
		sourceColumn: entity_name

	/// OPPORTUNITY oder CONTRACT.
	column 'Entitätstyp'
		dataType: string
		lineageTag: c1000000-0000-4000-8000-000000000103
		summarizeBy: none
		sourceColumn: entity_type

	/// NEW oder LOST. Steuert Vorzeichen und HFM-Kontenzuordnung.
	column Geschäftsart
		dataType: string
		lineageTag: c1000000-0000-4000-8000-000000000104
		summarizeBy: none
		sourceColumn: business_type

	/// Verknüpfung zu DIM Status (Won / Expected Win / Pipeline / …).
	column 'Status Code'
		dataType: string
		isHidden
		lineageTag: c1000000-0000-4000-8000-000000000105
		summarizeBy: none
		sourceColumn: status_code

	/// "unknown ITY" oder "unknown Roll" – wann die Entscheidung fällt und
	/// wohin sie dadurch wirkt. Bezeichner aus den Altmodellen beibehalten,
	/// damit Abstimmungen gegen die Altreports möglich bleiben.
	///
	/// unknown Roll → Abschluss im laufenden Geschäftsjahr, Umsatz überwiegend
	///   im Folgejahr. Das ist die Größe, die auf der Seite "Roll-Budget"
	///   gegen das Budget läuft: was jetzt noch gewonnen werden muss.
	/// unknown ITY → Abschluss im Folgejahr, Wirkung innerhalb desselben Jahres.
	column 'ITY Cluster'
		dataType: string
		lineageTag: c1000000-0000-4000-8000-000000000106
		summarizeBy: none
		sourceColumn: ity_cluster

	/// Herkunft der ITY-Monatsrate. "CRM-ITY" = aus cgplc_revenueity gerechnet,
	/// "ARO-Ersatz (Eroeffnung Folgejahr)" = ersatzweise ARO/12.
	///
	/// Hintergrund: cgplc_revenueity ist im CRM gegen das LAUFENDE
	/// Geschäftsjahr gerechnet. Liegt die Mobilisierung komplett im nächsten
	/// Jahr, steht dort systematisch 0 – nicht weil kein Umsatz entsteht,
	/// sondern weil er im laufenden Jahr nicht anfällt. nb_20_gold setzt für
	/// diese Fälle ARO/12 an, sonst fiele das gesamte erste Vertragsjahr auf
	/// null. Regel DQ-NEW-001 zählt, wie viel Volumen darüber läuft.
	column 'ITY Quelle'
		dataType: string
		lineageTag: c1000000-0000-4000-8000-000000000123
		summarizeBy: none
		sourceColumn: ity_quelle

	/// Gewinn- bzw. Verlustwahrscheinlichkeit als Dezimalzahl (0–1).
	/// New Business  : Win-% aus dem CRM.
	/// Lost Business : 1 − Retention-%.
	column Wahrscheinlichkeit
		dataType: double
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: c1000000-0000-4000-8000-000000000107
		summarizeBy: none
		sourceColumn: probability

	/// Erster Tag des Wirkungsmonats. Verbindung zu DIM Datum.
	column Periode
		dataType: dateTime
		formatString: dd.mm.yyyy
		isHidden
		lineageTag: c1000000-0000-4000-8000-000000000108
		summarizeBy: none
		sourceColumn: period_date

	column 'GJ Jahr'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: c1000000-0000-4000-8000-000000000109
		summarizeBy: none
		sourceColumn: fy_year

	column 'GJ Periode Nr'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: c1000000-0000-4000-8000-000000000110
		summarizeBy: none
		sourceColumn: fy_period

	/// Linearer Monatsindex, deckungsgleich mit 'DIM Datum'[Monatsindex].
	/// Zielspalte der Szenario-Verschiebung.
	column Monatsindex
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: c1000000-0000-4000-8000-000000000111
		summarizeBy: none
		sourceColumn: monat_index

	/// Laufende Nummer des Monats seit dem auslösenden Ereignis
	/// (Mobilisierung bzw. Vertragsende), beginnend bei 1.
	/// Niedrigkardinal (1–24) – deshalb kann die Anlaufkurve in DAX ohne
	/// Performance-Verlust über diese Spalte iterieren.
	column Periodenindex
		dataType: int64
		formatString: 0
		lineageTag: c1000000-0000-4000-8000-000000000112
		summarizeBy: none
		sourceColumn: period_index

	/// ITY  = Wirkung im ersten Geschäftsjahr (HFM MAP141a / MAP141c)
	/// ARO  = Dauerzustand ab dem zweiten Geschäftsjahr (MAP131 / MAP136)
	column Wertebene
		dataType: string
		lineageTag: c1000000-0000-4000-8000-000000000113
		summarizeBy: none
		sourceColumn: value_layer

	/// HFM-Konto laut Group Guidance (Feb 2025, S. 3).
	column 'HFM Konto'
		dataType: string
		lineageTag: c1000000-0000-4000-8000-000000000114
		summarizeBy: none
		sourceColumn: hfm_account

	/// Monatswert × Wahrscheinlichkeit, immer positiv.
	column 'Betrag gewichtet'
		dataType: decimal
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		isHidden
		lineageTag: c1000000-0000-4000-8000-000000000115
		summarizeBy: sum
		sourceColumn: amount_weighted

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Monatswert ohne Wahrscheinlichkeitsgewichtung (Vollwert).
	/// Antwortet auf "Was wäre, wenn alles eintritt?".
	column 'Betrag ungewichtet'
		dataType: decimal
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		isHidden
		lineageTag: c1000000-0000-4000-8000-000000000116
		summarizeBy: sum
		sourceColumn: amount_unweighted

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Gewichteter Monatswert mit Vorzeichen: NEW positiv, LOST negativ.
	/// Basis fast aller Measures.
	column 'Betrag'
		dataType: decimal
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		isHidden
		lineageTag: c1000000-0000-4000-8000-000000000117
		summarizeBy: sum
		sourceColumn: amount_signed

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Ungewichteter Monatswert mit Vorzeichen. Basis der Bewertungsbasis
	/// "Vollwert" – als eigene Spalte materialisiert, damit auch diese Sicht
	/// eine einfache Summe bleibt.
	column 'Betrag ungewichtet (vorzeichenbehaftet)'
		dataType: decimal
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		isHidden
		lineageTag: c1000000-0000-4000-8000-000000000128
		summarizeBy: sum
		sourceColumn: amount_unweighted_signed

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Auslösendes Datum: Mobilisierung (New) bzw. bereinigtes Vertragsende
	/// (Lost). Bereinigt heißt: Vertragsende, ersatzweise Entscheidungsdatum
	/// plus drei Monate.
	column 'Auslösendes Datum'
		dataType: dateTime
		formatString: dd.mm.yyyy
		lineageTag: c1000000-0000-4000-8000-000000000118
		summarizeBy: none
		sourceColumn: driver_date

	/// Entscheidungsdatum laut CRM. Laut Group Guidance (S. 2) maßgeblich für
	/// die Zuordnung zu "current year" bzw. "prior year" – NICHT das
	/// Mobilisierungs- oder Schließungsdatum.
	column Entscheidungsdatum
		dataType: dateTime
		formatString: dd.mm.yyyy
		lineageTag: c1000000-0000-4000-8000-000000000119
		summarizeBy: none
		sourceColumn: decision_date

	/// Ende des ersten Geschäftsjahres der Entität. Grenze zwischen ITY- und
	/// ARO-Phase.
	column 'Ende 1. GJ'
		dataType: dateTime
		formatString: dd.mm.yyyy
		isHidden
		lineageTag: c1000000-0000-4000-8000-000000000120
		summarizeBy: none
		sourceColumn: calc_first_fy_end

	/// Anzahl Monate der ITY-Phase. Teiler bei der Verteilung des ITY-Werts.
	column 'ITY Monate'
		dataType: int64
		formatString: 0
		lineageTag: c1000000-0000-4000-8000-000000000121
		summarizeBy: none
		sourceColumn: calc_ity_months

	/// KONFORME ATTRIBUTE (Sektor bis Verantwortlicher)
	///
	/// Diese fünf Merkmale liegen bewusst auf dem Fakt und nicht nur in den
	/// Dimensionen, weil sie für BEIDE Geschäftsarten gefüllt sind.
	///
	/// Grund: 'DIM Opportunity' und 'DIM Vertrag' sind getrennte Dimensionen.
	/// Ein Datenschnitt auf 'DIM Opportunity'[Sektor] filtert nur die
	/// New-Zeilen – die Lost-Zeilen hängen an dieser Dimension gar nicht und
	/// laufen unverändert durch. Das Ergebnis wäre ein "Net New ITY im Sektor
	/// Healthcare", das das gesamte Lost Business aller Sektoren enthält:
	/// falsch, ohne Fehlermeldung.
	///
	/// Für seitenübergreifende Datenschnitte deshalb IMMER diese Spalten
	/// verwenden, nicht die gleichnamigen der Dimensionen. Die
	/// Dimensionsspalten bleiben für Detailsichten innerhalb einer
	/// Geschäftsart.
	column Sektor
		dataType: string
		lineageTag: c1000000-0000-4000-8000-000000000122
		summarizeBy: none
		sourceColumn: sector

	/// Subsektor. Konform über beide Geschäftsarten – siehe Sektor.
	column Subsektor
		dataType: string
		lineageTag: c1000000-0000-4000-8000-000000000129
		summarizeBy: none
		sourceColumn: subsector

	/// Vertragsart. Konform über beide Geschäftsarten – siehe Sektor.
	column Vertragsart
		dataType: string
		lineageTag: c1000000-0000-4000-8000-000000000123
		summarizeBy: none
		sourceColumn: contract_type

	/// Kunde. Konform über beide Geschäftsarten – siehe Sektor.
	/// Auf der Lost-Seite über cgplc_accountid aus dem Konto nachgeschlagen.
	column Kunde
		dataType: string
		lineageTag: c1000000-0000-4000-8000-000000000124
		summarizeBy: none
		sourceColumn: account_name

	/// Verantwortlicher. Konform über beide Geschäftsarten – siehe Sektor.
	column Verantwortlicher
		dataType: string
		lineageTag: c1000000-0000-4000-8000-000000000125
		summarizeBy: none
		sourceColumn: owner_name

	/// SAP-Betriebsnummer. Verbindung zu DIM Betrieb und damit zu Region,
	/// Management und Verantwortungsbereich.
	///
	/// Aufgelöst über eine vierstufige Kette (nb_20_gold, Abschnitt 5d):
	///   1. Einzelfall-Ausnahme aus der Mapping-Tabelle
	///   2. cgplc_sapid am Vorgang selbst
	///   3. Mapping über Sektor UND Subsektor
	///   4. Mapping über Sektor allein
	/// Die Mapping-Tabelle (Mapping_Planwerke.xlsx) pflegt das Controlling –
	/// dort steht, welcher Sektor/Subsektor auf welchem Planbetrieb geplant
	/// wird. Die SAP-Nummer des Kontos wird bewusst nicht verwendet: sie ist
	/// ein Debitor, kein Betrieb.
	///
	/// Welche Stufe gegriffen hat, zeigt 'Werk Zuordnung'. Lücken zählt
	/// Regel DQ-MAP-001, fehlende Mapping-Zeilen listet DQ-MAP-002.
	column 'Werk'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: c1000000-0000-4000-8000-000000000126
		summarizeBy: none
		sourceColumn: sap_id

	/// Herkunft der Werk-Zuordnung: Ausnahme (Mapping) / CRM direkt /
	/// Mapping Sektor/Subsektor / Mapping Sektor / Nicht zugeordnet.
	///
	/// Macht je Vorgang sichtbar, ob eine Zahl auf gepflegten CRM-Daten oder
	/// auf der Mapping-Tabelle beruht – und priorisiert damit die Nachpflege:
	/// "Nicht zugeordnet" ist die Arbeitsliste.
	column 'Werk Zuordnung'
		dataType: string
		lineageTag: c1000000-0000-4000-8000-000000000130
		summarizeBy: none
		sourceColumn: werk_zuordnung

	/// Stichtag des Ladelaufs. Ermöglicht Snapshot-Vergleiche.
	column Stichtag
		dataType: dateTime
		formatString: dd.mm.yyyy
		isHidden
		lineageTag: c1000000-0000-4000-8000-000000000127
		summarizeBy: none
		sourceColumn: snapshot_date

	partition 'FCT Net New ITY' = m
		mode: import
		source = fnLakehouse("gold_fct_net_new_ity")

	annotation PBI_ResultType = Table
