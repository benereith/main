/// SZENARIO-PARAMETER 4 von 4 · Bewertungsbasis und Wahrscheinlichkeitsschwelle
///
/// Zwei Stellschrauben in einer Tabelle:
///
/// 1. BEWERTUNGSBASIS – wie wird der CRM-Wert in Geld übersetzt?
///    · "CRM-gewichtet"     Umsatz × Wahrscheinlichkeit (Standard, entspricht
///                          weighted_ity / weighted_ly_aro der Altmodelle)
///    · "Vollwert"          Umsatz ohne Gewichtung – die Obergrenze
///    · "Nur gesichert"     ausschließlich Won bzw. Lost, ungewichtet – die
///                          belastbare Untergrenze
///
///    Die drei Werte spannen den Korridor auf, in dem sich das tatsächliche
///    Net New ITY bewegen wird. Im Altbericht existierte nur die mittlere
///    Variante, weshalb die Bandbreite nie sichtbar war.
///
/// 2. SCHWELLE – ab welcher Wahrscheinlichkeit zählt eine Opportunity?
///    Filtert 'FCT Net New ITY'[Wahrscheinlichkeit]. Vorbelegung 0 % = alles.
table 'Szenario Bewertung'
	lineageTag: d4000000-0000-4000-8000-000000000001

	column Bewertungsbasis
		dataType: string
		lineageTag: d4000000-0000-4000-8000-000000000101
		summarizeBy: none
		sourceColumn: [Value1]
		sortByColumn: Sortierung

	column Beschreibung
		dataType: string
		lineageTag: d4000000-0000-4000-8000-000000000102
		summarizeBy: none
		sourceColumn: [Value2]

	column Sortierung
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: d4000000-0000-4000-8000-000000000103
		summarizeBy: none
		sourceColumn: [Value3]

	partition 'Szenario Bewertung' = calculated
		mode: import
		source =
				DATATABLE (
				    "Bewertungsbasis", STRING,
				    "Beschreibung", STRING,
				    "Sortierung", INTEGER,
				    {
				        { "Nur gesichert", "Nur Won bzw. Lost, ohne Gewichtung – belastbare Untergrenze", 1 },
				        { "CRM-gewichtet", "Umsatz × Wahrscheinlichkeit laut CRM – Standardsicht", 2 },
				        { "Vollwert", "Umsatz ohne Gewichtung – Obergrenze bei vollständigem Eintritt", 3 }
				    }
				)

	annotation PBI_Id = SzenarioBewertung
