expression FabricSql = ```
		let
		  // Bewusst statisch: genau ein Sql.Database-Aufruf, keine Fallunter-
		  // scheidung, keine Navigation ueber Sql.Databases. Power BI muss die
		  // Datenquelle beim Laden des Modells aufloesen koennen. Konstruiert
		  // der Ausdruck sie erst zur Laufzeit, gilt sie als dynamische
		  // Datenquelle und das Projekt laesst sich nicht oeffnen
		  // (InvalidDataSourceReference). Derselbe Grund verhindert spaeter
		  // den geplanten Refresh im Service.
		  Datenbank = Sql.Database(SqlEndpoint, WarehouseName)
		in
		  Datenbank
		```
	lineageTag: 8e1209c8-6229-5c05-ae04-e350696380ff

	annotation PBI_ResultType = Table
