expression FabricSql = ```
		let
		  // WarehouseName ist optional. Ist er gesetzt, gilt er unveraendert.
		  // Ist er leer, wird die Datenbank aufgeloest: stellt der Endpoint
		  // genau eine bereit, ist sie eindeutig und wird genommen. Stehen
		  // mehrere zur Auswahl, bricht die Abfrage mit deren Namen ab -
		  // dann ist der Parameter zu setzen.
		  Manuell = WarehouseName <> null and Text.Trim(WarehouseName) <> "",
		  Kandidaten = Sql.Databases(SqlEndpoint),
		  Namen = Text.Combine(List.Transform(Table.Column(Kandidaten, "Name"), Text.From), ", "),
		  Automatisch =
		      if Table.RowCount(Kandidaten) = 1 then
		          Kandidaten{0}[Data]
		      else
		          error "Der SQL-Endpoint stellt " & Text.From(Table.RowCount(Kandidaten))
		              & " Datenbanken bereit - bitte den Parameter WarehouseName setzen. Verfuegbar: "
		              & Namen,
		  Datenbank = if Manuell then Sql.Database(SqlEndpoint, WarehouseName) else Automatisch
		in
		  Datenbank
		```
	lineageTag: 8e1209c8-6229-5c05-ae04-e350696380ff

	annotation PBI_ResultType = Table
