	partition dim_sap_master_data_unit = m
		mode: import
		source = ```
				let
				  // SAP-Stammdaten aus dem bestehenden Dataflow der Gruppe.
				  // Liefert Sektor und Bezirk fuer dim_unit und fct_retention[sektor].
				  Quelle = PowerPlatform.Dataflows(null),
				  Workspaces = Quelle{[Id = "Workspaces"]}[Data],
				  Arbeitsbereich = Workspaces{[workspaceId = "ddc66bda-5a20-49f0-be6e-b68e17a1cc90"]}[Data],
				  Dataflow = Arbeitsbereich{[dataflowId = "a65e47b1-6a8b-4cf2-8131-c90e55bf14c7"]}[Data],
				  Entitaet = Dataflow{[entity = "sap_master_data_unit", version = ""]}[Data],
				  Spalten = Table.SelectColumns(Entitaet, {"betrieb", "bezeichnung_betrieb", "sektor", "bezeichnung_bezirk"}),
				  Eindeutig = Table.Distinct(Spalten, {"betrieb"})
				in
				  Eindeutig
				```

	annotation PBI_ResultType = Table
