	column Ret_Status = ```
			SWITCH (
			    TRUE (),
			    ISBLANK ( fct_retention[cgplc_retentionprobability] ), "No %",
			    fct_retention[cgplc_retentionprobability] = 0, "Lost",
			    fct_retention[cgplc_retentionprobability] <= 0.2, "Expected Loss",
			    fct_retention[cgplc_retentionprobability] < 1, "At Risk",
			    "No Risk"
			)
			```
		dataType: string
		lineageTag: 1b21823b-b560-5a50-9e73-6764bd29c556
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column LY_ARO_Status = IF ( ISBLANK ( fct_retention[cgplc_lastfyrevenuearo] ), "No ARO in CRM", "ARO in CRM" )
		dataType: string
		lineageTag: 360eb9cc-a0a9-5f04-8f92-af355d2a4b4d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column effective_enddate = ```
			COALESCE (
			    fct_retention[cgplc_contractenddate],
			    EDATE ( fct_retention[cgplc_decisiondate], 3 )
			)
			```
		dataType: dateTime
		formatString: Short Date
		lineageTag: 33fa7c72-9d7f-5b82-90e1-b0967f3576b8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column days_to_decision = ```
			VAR _UtcJetzt = UTCNOW ()
			VAR _Jahr = YEAR ( _UtcJetzt )
			VAR _MaerzEnde = DATE ( _Jahr, 3, 31 )
			VAR _OktoberEnde = DATE ( _Jahr, 10, 31 )
			VAR _SommerzeitBeginn =
			    _MaerzEnde - ( WEEKDAY ( _MaerzEnde, 1 ) - 1 ) + TIME ( 1, 0, 0 )
			VAR _SommerzeitEnde =
			    _OktoberEnde - ( WEEKDAY ( _OktoberEnde, 1 ) - 1 ) + TIME ( 1, 0, 0 )
			VAR _Versatz =
			    IF ( _UtcJetzt >= _SommerzeitBeginn && _UtcJetzt < _SommerzeitEnde, 2, 1 )
			VAR _BerlinJetzt = _UtcJetzt + _Versatz / 24
			VAR _HeuteBerlin =
			    DATE ( YEAR ( _BerlinJetzt ), MONTH ( _BerlinJetzt ), DAY ( _BerlinJetzt ) )
			RETURN
			    DATEDIFF (
			        _HeuteBerlin,
			        COALESCE (
			            fct_retention[cgplc_forecastdecisiondate],
			            fct_retention[cgplc_decisiondate]
			        ),
			        DAY
			    )
			```
		dataType: int64
		formatString: 0
		lineageTag: 60bfa6a1-b7f6-59e6-bb1c-de47c53d4969
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column sektor = ```
			LOOKUPVALUE (
			    dim_sap_master_data_unit[sektor],
			    dim_sap_master_data_unit[betrieb], fct_retention[cgplc_sapid]
			)
			```
		dataType: string
		lineageTag: 0da17037-84b2-575f-9ab1-dcce61cc0ead
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

