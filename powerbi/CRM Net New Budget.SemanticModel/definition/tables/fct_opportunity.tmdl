	column win_status = ```
			SWITCH (
			    TRUE (),
			    ISBLANK ( fct_opportunity[cgplc_win] ), "Ohne Wahrscheinlichkeit",
			    fct_opportunity[cgplc_win] < 0.80, "Pipeline",
			    fct_opportunity[cgplc_win] < 1, "Expected Win",
			    "Won"
			)
			```
		dataType: string
		lineageTag: d825acce-9cbe-54f3-aa2c-bc47afe964bf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column weighted_aro = fct_opportunity[cgplc_revenuearo] * fct_opportunity[cgplc_win]
		dataType: decimal
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 5d28030b-017f-557f-a8f3-8ddd939b0e1d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	column weighted_ity = fct_opportunity[cgplc_revenueity] * fct_opportunity[cgplc_win]
		dataType: decimal
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 7cae8d6f-fccd-5a62-a1ce-60c388db6b9a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	column close_fy = ```
			VAR _d = fct_opportunity[estimatedclosedate]
			VAR _start = IF ( MONTH ( _d ) >= 10, YEAR ( _d ), YEAR ( _d ) - 1 )
			RETURN
			    IF ( ISBLANK ( _d ), BLANK (), "FY" & _start & "/" & RIGHT ( _start + 1, 2 ) )
			```
		dataType: string
		lineageTag: 948bc536-f4bb-5f6f-bd5e-296493d3d2ff
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column sales_cycle_days = ```
			DATEDIFF (
			    fct_opportunity[cgplc_openingdate],
			    fct_opportunity[estimatedclosedate],
			    DAY
			)
			```
		dataType: int64
		formatString: 0
		lineageTag: ef735ace-b259-54e9-bc72-75c28a04b986
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Info = ```
			FORMAT ( fct_opportunity[cgplc_win], "0.00 %" ) & " - "
			    & FORMAT ( fct_opportunity[cgplc_revenuearo], "#,##0 €" ) & " - "
			    & FORMAT ( fct_opportunity[estimatedclosedate], "dd.MM.yyyy" ) & " - "
			    & FORMAT ( fct_opportunity[cgplc_openingdate], "dd.MM.yyyy" )
			```
		dataType: string
		lineageTag: f506e65a-022d-5a33-8e88-2026b16521a3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fct_opportunity = m
		mode: import
		source = ```
				let
				  Quelle = FabricSql,
				  Daten = Quelle{[Schema = "dbo", Item = "fct_opportunity_current"]}[Data]
				in
				  Daten
				```

	annotation PBI_ResultType = Table
