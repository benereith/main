table fct_budget_effect
	lineageTag: 83c9a5a7-977a-547b-a3f2-b57cb7e82f75

	column effect_type
		dataType: string
		lineageTag: 008a685e-c863-5385-83c7-0f5fd9970139
		summarizeBy: none
		isNameInferred
		sourceColumn: [effect_type]

		annotation SummarizationSetBy = Automatic

	column entity_id
		dataType: string
		lineageTag: 416bae14-90c5-517b-adc9-89994e11382f
		summarizeBy: none
		isNameInferred
		sourceColumn: [entity_id]

		annotation SummarizationSetBy = Automatic

	column sap_unit
		dataType: int64
		formatString: 0
		lineageTag: 74079bef-164a-5a3a-a4ec-c10f110413f1
		summarizeBy: none
		isNameInferred
		sourceColumn: [sap_unit]

		annotation SummarizationSetBy = Automatic

	column Period_Date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 3df5eddf-ff10-539b-a01f-833627be996f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Period_Date]

		annotation SummarizationSetBy = Automatic

	column Referenzdatum
		dataType: dateTime
		formatString: Short Date
		lineageTag: 607df69d-2f8e-57f9-997c-b79d537d07e3
		summarizeBy: none
		isNameInferred
		sourceColumn: [Referenzdatum]

		annotation SummarizationSetBy = Automatic

	column ity_cluster
		dataType: string
		lineageTag: a12a8a28-1f5a-5dcf-b634-864b5ca68959
		summarizeBy: none
		isNameInferred
		sourceColumn: [ity_cluster]

		annotation SummarizationSetBy = Automatic

	column Phasenwechsel
		dataType: dateTime
		formatString: Short Date
		lineageTag: eeca1f9c-db7f-5a52-bd6b-fd737e91a862
		summarizeBy: none
		isNameInferred
		sourceColumn: [Phasenwechsel]

		annotation SummarizationSetBy = Automatic

	column ITY_Value
		dataType: double
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: adb415e5-3dbe-5a92-8d15-ed33d133ff21
		summarizeBy: none
		isNameInferred
		sourceColumn: [ITY_Value]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	column ARO_Value
		dataType: double
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 07091a22-447e-5072-aae8-1fc5391223dc
		summarizeBy: none
		isNameInferred
		sourceColumn: [ARO_Value]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	partition fct_budget_effect = calculated
		mode: import
		source = ```
				UNION (
				    SELECTCOLUMNS (
				        fct_opp_phasing,
				        "effect_type", "New Business",
				        "entity_id", fct_opp_phasing[opportunityid],
				        "sap_unit", fct_opp_phasing[sap_unit],
				        "Period_Date", fct_opp_phasing[Period_Date],
				        "Referenzdatum", fct_opp_phasing[Referenzdatum],
				        "ity_cluster", fct_opp_phasing[ity_cluster],
				        "Phasenwechsel", fct_opp_phasing[Phasenwechsel],
				        "ITY_Value", fct_opp_phasing[ITY_Value],
				        "ARO_Value", fct_opp_phasing[ARO_Value]
				    ),
				    SELECTCOLUMNS (
				        fct_retention_phasing,
				        "effect_type", "Retention",
				        "entity_id", fct_retention_phasing[cgplc_cgcontractid],
				        "sap_unit", fct_retention_phasing[sap_unit],
				        "Period_Date", fct_retention_phasing[Period_Date],
				        "Referenzdatum", fct_retention_phasing[Referenzdatum],
				        "ity_cluster", fct_retention_phasing[ity_cluster],
				        "Phasenwechsel", fct_retention_phasing[Phasenwechsel],
				        // Explizit auf DOUBLE: die Opportunity-Seite liefert das Ergebnis
				        // von DIVIDE, die Retention-Seite einen Waehrungswert. UNION
				        // verlangt vergleichbare Typen je Position.
				        "ITY_Value", CONVERT ( fct_retention_phasing[ITY_Value], DOUBLE ),
				        "ARO_Value", CONVERT ( fct_retention_phasing[ARO_Value], DOUBLE )
				    )
				)
				```

	annotation PBI_ResultType = Table
