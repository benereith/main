table dim_account
	lineageTag: fd0e5d53-c397-5fa9-bb38-6025a777197e

	column accountid
		dataType: string
		lineageTag: cde70082-8028-5935-b83f-271613ee9f03
		summarizeBy: none
		isNameInferred
		sourceColumn: [accountid]

		annotation SummarizationSetBy = Automatic

	partition dim_account = calculated
		mode: import
		source = ```
				DISTINCT (
				    UNION (
				        SELECTCOLUMNS ( fct_opportunity, "accountid", fct_opportunity[accountid] ),
				        SELECTCOLUMNS ( fct_opportunity, "accountid", fct_opportunity[parentaccountid] )
				    )
				)
				```

	annotation PBI_ResultType = Table
