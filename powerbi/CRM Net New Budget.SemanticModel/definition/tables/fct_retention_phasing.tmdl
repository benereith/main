table fct_retention_phasing
	lineageTag: 4d997d02-9dc7-54fe-a243-06151a8615c6

	column cgplc_cgcontractid
		dataType: string
		lineageTag: 9befd6ee-dfc6-59e7-9e1c-be8d611b5e77
		summarizeBy: none
		isNameInferred
		sourceColumn: [cgplc_cgcontractid]

		annotation SummarizationSetBy = Automatic

