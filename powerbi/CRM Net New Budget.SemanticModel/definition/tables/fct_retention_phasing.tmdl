		dataType: int64
		formatString: 0
		lineageTag: 3ffc31c3-c651-5305-ae3f-9473050c4fef
		summarizeBy: none
		isNameInferred
		sourceColumn: [sap_unit]

		annotation SummarizationSetBy = Automatic

