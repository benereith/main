	measure 'Win Rate Value' = DIVIDE ( [Won ARO], [Won ARO] + [Lost ARO] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 78368089-76e9-507e-917c-4abf22120325

	measure 'Win Rate Count' = ```
			VAR _won =
			    CALCULATE (
			        DISTINCTCOUNT ( fct_opportunity[opportunityid] ),
			        fct_opportunity[win_status] = "Won"
			    )
			VAR _lost =
			    CALCULATE (
			        DISTINCTCOUNT ( fct_opportunity[opportunityid] ),
			        fct_opportunity[statecodename] = "Verloren"
			    )
			RETURN
			    DIVIDE ( _won, _won + _lost )
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 331f0d8f-8ee3-573a-b63b-3c9bbaf843ee

	measure 'Avg Sales Cycle Days' = ```
			CALCULATE (
			    AVERAGE ( fct_opportunity[sales_cycle_days] ),
			    fct_opportunity[win_status] = "Won"
			)
			```
		formatString: 0
		lineageTag: a2b49c82-7ccd-5349-92c9-bf5d785d7a0c

	measure 'Stale Pipeline ARO' = ```
			VAR _letzterStand = MAX ( fct_opportunity_changes[snapshot_date] )
			RETURN
			    CALCULATE (
			        SUM ( fct_opportunity[cgplc_revenuearo] ),
			        fct_opportunity[statecodename] = "Offen",
			        FILTER (
			            VALUES ( fct_opportunity[opportunityid] ),
			            VAR _letzteAenderung =
			                CALCULATE ( MAX ( fct_opportunity_changes[snapshot_date] ) )
			            RETURN
			                DATEDIFF ( _letzteAenderung, _letzterStand, DAY ) > 90
			        )
			    )
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: d78b911f-c808-5da6-a67b-9bea959f172c

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'Retention Exposure ARO' = ```
			CALCULATE (
			    SUM ( fct_retention[cgplc_lastfyrevenuearo] ),
			    fct_retention[statuscodename] = "Aktiv"
			)
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 8366f2cc-f5b7-58d8-a5ce-5b4ba5f9e4bb

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'At Risk ARO' = ```
			CALCULATE (
			    SUM ( fct_retention[cgplc_lastfyrevenuearo] ),
			    fct_retention[statuscodename] = "Aktiv",
			    fct_retention[Ret_Status] IN { "At Risk", "Expected Loss", "Lost" }
			)
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: a493b88b-c64a-5810-9ac8-c0e13f0e2c8a

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'At Risk Share' = DIVIDE ( [At Risk ARO], [Retention Exposure ARO] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 26c41222-af16-599e-8791-6d0d72a13edb

	measure 'Decisions Due 90d' = ```
			CALCULATE (
			    SUM ( fct_retention[cgplc_lastfyrevenuearo] ),
			    fct_retention[statuscodename] = "Aktiv",
			    fct_retention[days_to_decision] >= 0,
			    fct_retention[days_to_decision] <= 90
			)
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 6ad95110-8117-588d-b84b-7462c161317b

