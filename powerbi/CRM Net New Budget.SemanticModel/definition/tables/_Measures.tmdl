table _Measures
	lineageTag: 828f5323-66b9-5fe3-89e0-b0c014596280

	measure 'Vorzeichen ITY' = -1
		isHidden
		formatString: 0
		lineageTag: 20721ec4-c63f-549d-bd6f-917827b47726

	measure 'Vorzeichen Retention' = -1
		isHidden
		formatString: 0
		lineageTag: b71d1efa-7451-52af-b45f-3261836fc5d6

	measure 'ITY Volumen' = ```
			SUMX (
			    fct_budget_effect,
			    IF (
			        fct_budget_effect[Period_Date] <= fct_budget_effect[Phasenwechsel],
			        fct_budget_effect[ITY_Value],
			        0
			    )
			)
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: aea616d5-e40c-575c-bb2e-fdb01c6b1795

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'ARO Volumen' = ```
			SUMX (
			    fct_budget_effect,
			    IF (
			        fct_budget_effect[Period_Date] > fct_budget_effect[Phasenwechsel],
			        fct_budget_effect[ARO_Value],
			        0
			    )
			)
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: ded8badb-7c1d-5c0d-808e-6d03ea592ee1

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'Budget Volumen' = [ITY Volumen] + [ARO Volumen]
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 672c5390-52ed-581e-8ef8-7addb5d4685f

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'New Business ITY' = CALCULATE ( [ITY Volumen], fct_budget_effect[effect_type] = "New Business" )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 4e68b133-c687-5efb-80a5-96fa437d83d7

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'New Business ARO' = CALCULATE ( [ARO Volumen], fct_budget_effect[effect_type] = "New Business" )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 39887ee4-d069-5aaa-b059-b551e7558a63

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'New Business Volumen' = [New Business ITY] + [New Business ARO]
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 764213a2-e773-5497-97c4-4d75f1e28013

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'Retention Volumen' = CALCULATE ( [Budget Volumen], fct_budget_effect[effect_type] = "Retention" )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: df5549c5-351c-57ff-a781-9b560992203a

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'Netto Budgeteffekt' = ```
			[New Business ARO]
			    + [Vorzeichen ITY] * [New Business ITY]
			    + [Vorzeichen Retention] * [Retention Volumen]
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 2d94ea14-f2c2-591a-85ce-a59e1b329b9d

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'Netto Budgeteffekt VJ' = CALCULATE ( [Netto Budgeteffekt], SAMEPERIODLASTYEAR ( dim_date[Datum] ) )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 1a0459c8-1cb8-5e79-b9d2-5321b0746bc6

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'Netto Budgeteffekt Delta' = [Netto Budgeteffekt] - [Netto Budgeteffekt VJ]
