	measure 'Heute Berlin' = ```
			VAR _UtcJetzt = UTCNOW ()
			VAR _Jahr = YEAR ( _UtcJetzt )
			VAR _MaerzEnde = DATE ( _Jahr, 3, 31 )
			VAR _OktoberEnde = DATE ( _Jahr, 10, 31 )
			VAR _SommerzeitBeginn =
			    _MaerzEnde - ( WEEKDAY ( _MaerzEnde, 1 ) - 1 ) + TIME ( 1, 0, 0 )
			VAR _SommerzeitEnde =
			    _OktoberEnde - ( WEEKDAY ( _OktoberEnde, 1 ) - 1 ) + TIME ( 1, 0, 0 )
			VAR _Versatz =
			    IF ( _UtcJetzt >= _SommerzeitBeginn && _UtcJetzt < _SommerzeitEnde, 2, 1 )
			VAR _BerlinJetzt = _UtcJetzt + _Versatz / 24
			RETURN
			    DATE ( YEAR ( _BerlinJetzt ), MONTH ( _BerlinJetzt ), DAY ( _BerlinJetzt ) )
			```
		formatString: dd.mm.yyyy
		lineageTag: 471b0e52-5fa4-59b6-ac97-40bc9dc52965

