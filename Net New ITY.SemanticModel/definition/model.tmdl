model Model
	culture: de-DE
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: de-DE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup '1. Konfiguration'

	annotation PBI_QueryGroupOrder = 0

queryGroup '2. Funktionen'

	annotation PBI_QueryGroupOrder = 1

queryGroup '3. Stammdaten'

	annotation PBI_QueryGroupOrder = 2

queryGroup '4. Revenue-Quellen'

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Geschäftsjahresbeginn","Abgeschlossene_Periode","Parameter_BUD_Stammdaten","Parameter_RGF_Stammdaten","Parameter_R03_Stammdaten","Lakehouse_Server","Lakehouse_Datenbank","Reporting_Server","Reporting_Datenbank","FY_Startmonat","Aktuelles_Geschäftsjahr","Szenario_Konfig","fnFiscal_DatumZuPeriode","fnFiscal_DatumZuGJ","fnFiscal_PeriodeZuDatum","fnCoC_ZuMetricId","fnStammdaten_Snapshot","Stammdaten_Dataflow","Stammdaten_Basis","Snapshot_BUD","Snapshot_RGF","Snapshot_R03","Stammdaten_CoC","Stammdaten_Historie","SAP_Stammdaten","SAP_Revenues","Man_Rev","Man_Stamm","Revenues","DIM_DATE","DIM_Szenario","DIM_Berichtsjahr","DIM_Struktur","0. Measuretabelle","Retention_ITY_CRM","Sales_Pipeline_ITY","Zeitfilter"]

annotation PBI_ProTooling = ["WebModelingEdit","CopilotTooling","DevMode"]

ref table '0. Measuretabelle'
ref table DIM_DATE
ref table SAP_Stammdaten
ref table Granularität
ref table 'Abgeschlossene Periode'
ref table Retention_ITY_CRM
ref table Sales_Pipeline_ITY
ref table KPI
ref table Revenues
ref table Vergleichszeitpunkt
ref table Zeitansicht
ref table Zeitfilter
ref table DIM_Struktur
ref table DIM_Szenario
ref table DIM_Berichtsjahr

ref role All

ref cultureInfo de-DE
