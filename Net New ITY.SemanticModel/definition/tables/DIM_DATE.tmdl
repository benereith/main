	/// Kalenderjahr, in dem das Geschäftsjahr beginnt (z. B. 2025 für FY2025/26).
	column FY_Start
		dataType: int64
		formatString: 0
		lineageTag: e705b0e9-d8f0-42b0-ada1-a05d9bb656f5
		summarizeBy: none
		sourceColumn: FY_Start

		annotation SummarizationSetBy = User

	/// Geschäftsjahr relativ zum laufenden GJ: 0 = aktuell, -1 = Vorjahr, ...
	column FY_Offset
		dataType: int64
		formatString: 0
		lineageTag: e90c7d99-5d8d-494a-b91d-5ca889434574
		summarizeBy: none
		sourceColumn: FY_Offset

		annotation SummarizationSetBy = User

	partition DIM_DATE = m
		mode: import
		source = ```
				let
				    // Kalenderbereich rollierend um den konfigurierten GJ-Beginn
				    Startdatum = Date.StartOfYear(Date.AddYears(Geschäftsjahresbeginn, -6)),
				    Enddatum = Date.EndOfYear(Date.AddYears(Geschäftsjahresbeginn, 3)),

				    DatumsListe = List.Dates(Startdatum, Duration.Days(Enddatum - Startdatum) + 1, #duration(1, 0, 0, 0)),
				    DatumsTabelle = Table.FromList(DatumsListe, Splitter.SplitByNothing(), {"Datum"}),

				    // Kalender-Spalten
				    MitJahr        = Table.AddColumn(DatumsTabelle, "Jahr",             each Date.Year([Datum]),          Int64.Type),
				    MitMonatName   = Table.AddColumn(MitJahr,       "Monat",            each Date.MonthName([Datum]),     type text),
				    MitMonatNr     = Table.AddColumn(MitMonatName,  "Monat Nummer",     each Date.Month([Datum]),         Int64.Type),
				    MitTag         = Table.AddColumn(MitMonatNr,    "Tag",              each Date.Day([Datum]),           Int64.Type),
				    MitWochentag   = Table.AddColumn(MitTag,        "Wochentag",        each Date.DayOfWeekName([Datum]), type text),
				    MitWochentagNr = Table.AddColumn(MitWochentag,  "Wochentag Nummer", each Date.DayOfWeek([Datum], Day.Monday) + 1, Int64.Type),
				    MitQuartal     = Table.AddColumn(MitWochentagNr, "Quartal",         each "Q" & Text.From(Date.QuarterOfYear([Datum])), type text),
				    MitHalbjahr    = Table.AddColumn(MitQuartal,    "Halbjahr",         each if Date.Month([Datum]) <= 6 then "H1" else "H2", type text),

				    // Geschäftsjahres-Spalten – abgeleitet aus FY_Startmonat,
				    // dadurch gültig für beliebig viele Geschäftsjahre
				    MitFiscal = Table.AddColumn(MitHalbjahr, "FiscalTemp", each
				        let
				            FY_Start = fnFiscal_DatumZuGJ([Datum]),
				            FY_Ende = FY_Start + 1,
				            FY_Monat_Nr = fnFiscal_DatumZuPeriode([Datum]),
				            FY_Quartal_Nr = Number.RoundUp(FY_Monat_Nr / 3)
				        in
				            [
				                FY_Start      = FY_Start,
				                FY_Offset     = FY_Start - Aktuelles_Geschäftsjahr,
				                FY_Jahr       = "FY" & Text.From(FY_Start) & "/" & Text.End(Text.From(FY_Ende), 2),
				                FY_JahrLang   = Text.From(FY_Start) & "/" & Text.End(Text.From(FY_Ende), 2),
				                FY_Quartal    = "FQ" & Text.From(FY_Quartal_Nr),
				                FY_Monat      = "FM" & Text.PadStart(Text.From(FY_Monat_Nr), 2, "0"),
				                FY_Periode    = "P" & Text.PadStart(Text.From(FY_Monat_Nr), 2, "0"),
				                FY_JahrMonat  = Text.From(FY_Start) & "-" & Text.PadStart(Text.From(FY_Monat_Nr), 2, "0"),
				                FY_MonatNr    = FY_Monat_Nr,
				                FY_QuartalNr  = FY_Quartal_Nr
				            ]
				    ),
				    Erweitert = Table.ExpandRecordColumn(MitFiscal, "FiscalTemp",
				        {"FY_Start", "FY_Offset", "FY_Jahr", "FY_JahrLang", "FY_Quartal", "FY_Monat", "FY_Periode", "FY_JahrMonat", "FY_MonatNr", "FY_QuartalNr"}),

				    Typisiert = Table.TransformColumnTypes(Erweitert, {
				        {"Datum", type date},
				        {"Jahr", Int64.Type},
				        {"Monat Nummer", Int64.Type},
				        {"Tag", Int64.Type},
				        {"Wochentag Nummer", Int64.Type},
				        {"FY_Start", Int64.Type},
				        {"FY_Offset", Int64.Type},
				        {"FY_MonatNr", Int64.Type},
				        {"FY_QuartalNr", Int64.Type}
				    }),

				    Ergebnis = Table.SelectColumns(Typisiert, {
				        "Datum", "Jahr", "Monat Nummer", "Monat", "Tag",
				        "Wochentag", "Wochentag Nummer", "Quartal", "Halbjahr",
				        "FY_Start", "FY_Offset", "FY_Jahr", "FY_JahrLang", "FY_JahrMonat",
				        "FY_Quartal", "FY_QuartalNr", "FY_Monat", "FY_MonatNr", "FY_Periode"
				    })
				in
				    Ergebnis
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
