/// Zentrale Datumstabelle. Geschäftsjahreslogik vollständig aus dem Parameter
/// "Geschäftsjahresbeginn" abgeleitet (FY_Startmonat) und damit für beliebig
/// viele Geschäftsjahre gültig. FY_Offset = Geschäftsjahr relativ zum
/// laufenden GJ (0 = aktuell, -1 = Vorjahr, ...).
table DIM_DATE
	lineageTag: c9978af4-b0e0-449a-87be-5ce8065fa95f
	dataCategory: Time

	column Datum
		dataType: dateTime
		isKey
		formatString: Long Date
		lineageTag: de41bc51-bc70-4873-8270-0513005c43c5
		summarizeBy: none
		sourceColumn: Datum

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Jahr
		dataType: int64
		formatString: 0
		lineageTag: a4e60fd5-42eb-4f80-94d1-689e04bb6bcc
		summarizeBy: none
		sourceColumn: Jahr

		annotation SummarizationSetBy = User

	column Monat
