			        DISTINCT ( 'DIM_DATE'[Datum] ),
			        REMOVEFILTERS ( 'DIM_DATE' ),
			        VALUES ( 'DIM_DATE'[FY_Start] )
			    )
			RETURN
			    CALCULATE ( [BUD_Periodic], REMOVEFILTERS ( 'DIM_DATE' ), PeriodenGesamtGJ )
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 06 Net New Roll\Details
		lineageTag: fd71de7c-9ee1-4c18-b4f0-254ae621b692

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

