/// Zentrale Measure-Tabelle.
///
/// Aufbau nach dem Umbau:
///  - *_Periodic  = Monatswert (einfache Summe, Fakten liegen monatlich vor)
///  - *_Value     = YTD-Wert (kumuliert bis zur letzten Periode im Kontext;
///                  ohne Periodenfilter = Gesamtjahr)
///  - Szenarien (ACT/BUD/RGF/RF/P35/R03/FC02/ARO_RGF) kommen aus der Spalte
///    Revenues[Szenario], siehe Szenario_Konfig in den Abfragen.
///  - MetricId <> 99 blendet "Like for Like" aus (entspricht dem früheren
///    Filter "Mapping Wert <> 99").
table '0. Measuretabelle'
	lineageTag: eb0c82ac-27a9-4a47-8bea-d697799910f4

	/// Generischer Monatswert – reagiert auf das per DIM_Szenario gewählte
	/// Szenario. Für Vergleichsmatrizen (Budget/2+10/5+7/8+4/10+2/Actual
	/// nebeneinander): DIM_Szenario[Szenario] in die Spalten, dieses Measure
	/// als Wert – kein szenariospezifisches Measure nötig.
	measure Wert_Periodic = CALCULATE ( SUM ( Revenues[Betrag] ), Revenues[MetricId] <> 99 )
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 01 Szenario-Vergleich
		lineageTag: 22532937-16e2-498e-b238-86c2aa219e3e

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Generischer YTD-Wert (kumuliert bis zur Periode im Kontext), reagiert
	/// ebenfalls auf DIM_Szenario. Gegenstück zu Wert_Periodic.
	measure Wert_YTD = ```
			VAR p = MAX ( 'DIM_DATE'[FY_MonatNr] )
			VAR PeriodenYTD =
			    CALCULATETABLE (
			        DISTINCT ( 'DIM_DATE'[Datum] ),
			        REMOVEFILTERS ( 'DIM_DATE' ),
			        'DIM_DATE'[FY_MonatNr] <= p,
			        VALUES ( 'DIM_DATE'[FY_Start] )
			    )
			RETURN
			    CALCULATE ( [Wert_Periodic], REMOVEFILTERS ( 'DIM_DATE' ), PeriodenYTD )
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 01 Szenario-Vergleich
		lineageTag: 168fe963-2b19-4ce9-922d-81a4fbe49354

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Delta Actual − Budget (YTD). Positiv = über Budget.
	measure 'Δ Actual vs Budget' = [ACT_Value] - [BUD_Value]
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: 00 KPIs
		lineageTag: fd09cc05-2b12-4585-bdfe-1cb2cc70b3e9

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Delta Forecast − Budget (YTD). Positiv = Forecast über Budget.
	measure 'Δ Forecast vs Budget' = [RGF_Value] - [BUD_Value]
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: 00 KPIs
		lineageTag: 6a6914fc-d7d3-4d6f-9123-616eecaf636f

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Zielerreichung Actual gegenüber Budget (YTD).
	measure 'Zielerreichung Actual %' = DIVIDE ( [ACT_Value], [BUD_Value] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 00 KPIs
		lineageTag: 157ce513-7585-4323-814e-346b00fcf66f

	/// Zielerreichung Forecast gegenüber Budget (YTD).
	measure 'Zielerreichung Forecast %' = DIVIDE ( [RGF_Value], [BUD_Value] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 00 KPIs
		lineageTag: a1eb0132-44d1-408a-bb1d-fe36428c3444

	/// Forecast Accuracy: 1 − |Actual − Forecast| / Actual (YTD).
	/// 100 % = Forecast trifft Ist exakt.
	measure 'Forecast Accuracy %' = ```
			VAR Abweichung = ABS ( [ACT_Value] - [RGF_Value] )
			RETURN
			    IF ( [ACT_Value] <> 0, 1 - DIVIDE ( Abweichung, ABS ( [ACT_Value] ) ) )
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 00 KPIs
		lineageTag: 50fd8e5b-8a43-4c46-9468-8f50ca0e0308

	/// Net New Roll Delta relativ zum Budget (YTD).
	measure 'Net New Roll Delta %' = DIVIDE ( [Net New Roll Delta], [Net New Roll Budget] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 00 KPIs
		lineageTag: 78a172da-da3c-467c-afc4-37819f5a264c

	/// Vorjahresumsatz = Basis für die Net-New-%-Betrachtung.
	/// FY26: Planversion 35 des Vorjahres (FY_Offset = -1).
	/// Für das Berichtsjahr FY27 wäre die Basis RGF + R12 des FY26 – das
	/// setzt die Mehrjahr-/Berichtsjahr-Erweiterung voraus (siehe README).
	measure Vorjahresumsatz = ```
			CALCULATE (
			    SUM ( Revenues[Betrag] ),
			    Revenues[Werttyp_Version] = "Plan_35",
			    Revenues[FY_Offset] = -1
			)
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: 00 KPIs
		lineageTag: ea5a5c64-80cb-44b7-a663-3ee6417d45ed

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Net New (Forecast/Actual) in % des Vorjahresumsatzes.
	measure 'Net New % (Forecast/Actual)' = DIVIDE ( [Net New Roll Forecast/Actuals], [Vorjahresumsatz] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 00 KPIs
		lineageTag: 9b5f848d-f29f-43ec-be3b-186e15198a64

	/// Net New (Budget) in % des Vorjahresumsatzes.
	measure 'Net New % (Budget)' = DIVIDE ( [Net New Roll Budget], [Vorjahresumsatz] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 00 KPIs
		lineageTag: 20f2fb7a-3981-42a7-a7a1-e88e556da070

	/// Monatswerte Actuals (Ist laufendes GJ + Vorjahr, ohne Like for Like).
	measure ACT_Periodic = ```
			CALCULATE (
			    SUM ( Revenues[Betrag] ),
			    Revenues[Szenario] = "ACT",
			    Revenues[MetricId] <> 99
			)
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 02 Umsatz gesamt\Actual
		lineageTag: 252abade-6ec5-4791-8b54-c66fbbdafa90

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Monatswerte Budget (Plan_20 laufendes GJ + Plan_35 Vorjahr).
	measure BUD_Periodic = ```
			CALCULATE (
			    SUM ( Revenues[Betrag] ),
			    Revenues[Szenario] = "BUD",
			    Revenues[MetricId] <> 99
			)
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 02 Umsatz gesamt\Budget
		lineageTag: 21d138f0-367f-40ff-8c01-63f1ec315b42

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Monatswerte Rolling Forecast (Plan_RGF/R12 + Ist Vorjahr).
	measure RGF_Periodic = ```
			CALCULATE (
			    SUM ( Revenues[Betrag] ),
			    Revenues[Szenario] = "RGF",
			    Revenues[MetricId] <> 99
			)
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 02 Umsatz gesamt\Forecast
		lineageTag: fa014d4e-9023-4981-bb53-c5a48a38ac65

		annotation PBI_FormatHint = {"currencyCulture":"de"}

	/// Monatswerte Forecast RF/RTD (+ Ist Vorjahr).
	measure RF_Periodic = ```
			CALCULATE (
			    SUM ( Revenues[Betrag] ),
			    Revenues[Szenario] = "RF",
			    Revenues[MetricId] <> 99
			)
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 02 Umsatz gesamt\Forecast
		lineageTag: 08abeeb6-3d07-4704-89cd-7f02ac9405cf

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// YTD Actuals: kumuliert bis zur letzten Periode im Filterkontext,
	/// ohne Periodenfilter = Gesamtjahr. Ersetzt die frühere Logik auf
	/// YTD-kumulierten Quellzeilen.
	measure ACT_Value = ```
			VAR p = MAX ( 'DIM_DATE'[FY_MonatNr] )
			VAR PeriodenYTD =
			    CALCULATETABLE (
			        DISTINCT ( 'DIM_DATE'[Datum] ),
			        REMOVEFILTERS ( 'DIM_DATE' ),
			        'DIM_DATE'[FY_MonatNr] <= p,
			        VALUES ( 'DIM_DATE'[FY_Start] )
			    )
			RETURN
			    CALCULATE ( [ACT_Periodic], REMOVEFILTERS ( 'DIM_DATE' ), PeriodenYTD )
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 02 Umsatz gesamt\Actual
		lineageTag: a7b08c4e-e87c-4246-8147-45e9b4088f51

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// YTD Budget.
	measure BUD_Value = ```
			VAR p = MAX ( 'DIM_DATE'[FY_MonatNr] )
			VAR PeriodenYTD =
			    CALCULATETABLE (
			        DISTINCT ( 'DIM_DATE'[Datum] ),
