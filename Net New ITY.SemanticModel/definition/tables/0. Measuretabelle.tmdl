	/// Delta Forecast vs. Budget für Real-Betriebe mit CoC 1, Vertragsbeginn vor GJ-Beginn.
	measure New_Roll_Bud_Exp_LY = ```
			VAR GJBeginn =
			    CALCULATE ( MIN ( 'DIM_DATE'[Datum] ), REMOVEFILTERS ( 'DIM_DATE' ), 'DIM_DATE'[FY_Offset] = 0 )
			RETURN
			    CALCULATE (
			        [BUD_2_FC],
			        SAP_Stammdaten[Betriebstyp] = "Real-Betriebe",
			        Revenues[cause_of_change] = 1,
			        SAP_Stammdaten[vertragsbeginn] < GJBeginn
			    )
			```
