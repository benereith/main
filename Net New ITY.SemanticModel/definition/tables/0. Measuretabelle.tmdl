	/// Hybrid: bis zur abgeschlossenen Periode Actuals, danach Forecast Plan_02
	/// (laufendes GJ ohne Plan-Betriebe Roll) + Ist Vorjahr.
	measure Adj_FC_Value = ```
			VAR CurPeriode = MAX ( Revenues[Buchungsperiode] )
			VAR MaxActualPeriode = SELECTEDVALUE ( 'Abgeschlossene Periode'[Abgeschlossene Periode], 0 )
			VAR p = MAX ( 'DIM_DATE'[FY_MonatNr] )
			VAR PeriodenYTD =
			    CALCULATETABLE (
			        DISTINCT ( 'DIM_DATE'[Datum] ),
			        REMOVEFILTERS ( 'DIM_DATE' ),
			        'DIM_DATE'[FY_MonatNr] <= p,
			        VALUES ( 'DIM_DATE'[FY_Start] )
			    )
			RETURN
			    IF (
			        CurPeriode <= MaxActualPeriode,
			        [ACT_Value],
			        CALCULATE (
			            SUM ( Revenues[Betrag] ),
			            Revenues[Szenario] = "FC02",
			            Revenues[FY_Offset] = 0,
			            Revenues[MetricId] <> 99,
			            SAP_Stammdaten[Betriebstyp] <> "Plan-Betriebe Roll",
			            REMOVEFILTERS ( 'DIM_DATE' ),
			            PeriodenYTD
			        )
			            + CALCULATE (
			                SUM ( Revenues[Betrag] ),
			                Revenues[Szenario] = "FC02",
			                Revenues[FY_Offset] = -1,
			                Revenues[MetricId] <> 99,
			                REMOVEFILTERS ( 'DIM_DATE' ),
			                PeriodenYTD
			            )
			    )
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 02 Umsatz gesamt\Forecast
		lineageTag: dd3e3127-8f0e-43c2-8fe5-1b862f80d007

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Budget Gesamtjahr (Alt-Logik: "Buchungsperiode = 12").
