		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure ACT_Base = ```
			
			CALCULATE (
			    SUM ( Revenues[Betrag] ),
			    Revenues[Werttyp_Version] = "Actual_0",
			    Revenues[Mapping Wert] <> 99,
			    Revenues[Mapping Art] = "Mapping CoCh",
			    Revenues[Geschäftsjahr]
			        IN {
			            MAX ( 'N_Geschäftsjahr'[N_Geschäftsjahr] ),
			            MAX ( 'N_Geschäftsjahr-1'[N_Geschäftsjahr-1] )
			        }
			)
			
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 68acfd52-2ce7-4a1d-a0a4-57f52abc4132

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure RGF_Value = ```
			
			CALCULATE (
			    SUM ( Revenues[Betrag] ),
			    Revenues[Werttyp_Version] in { "Plan_RGF", "Plan_R12"},
			    Revenues[Mapping Wert] <> 99,
			    Revenues[Mapping Art] = "Mapping CoCh FY",
			    Revenues[Geschäftsjahr] = MAX ( 'N_Geschäftsjahr'[N_Geschäftsjahr] )
			)
			+
			CALCULATE (
			    SUM ( Revenues[Betrag] ),
			    Revenues[Werttyp_Version] = "Actual_0",
			    Revenues[Mapping Wert] <> 99,
			    Revenues[Mapping Art] = "Mapping CoCh FY",
			    Revenues[Geschäftsjahr] = MAX ( 'N_Geschäftsjahr-1'[N_Geschäftsjahr-1] )
			)
			
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 0d0592d4-6860-4f80-96bb-fd652e4f0fe4

		annotation PBI_FormatHint = {"currencyCulture":"de"}

	measure FC_Base_YTD = ```
			
			-- Wir speichern die gewählte Periode der Matrix-Spalte in einer Variable
			VAR MaxPeriode = SELECTEDVALUE ( Revenues[Buchungsperiode] )
			
			RETURN
			CALCULATE (
			    -- Wir rufen dein ursprüngliches Measure auf (das, was periodisch funktioniert)
			    [RGF_Value], 
			    
			    -- Wir entfernen den Filter der aktuellen Periode komplett
			    REMOVEFILTERS ( Revenues[Buchungsperiode] ),
			    
			    -- Wir setzen den "Summewenn"-Bereich neu: Alles von Anfang bis zur aktuellen Spalte
			    Revenues[Buchungsperiode] <= MaxPeriode
			)
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: de4e3269-8b01-42b0-a345-07e9e7a9c555

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure ACT_Periodic = ```
			
			-- 1. Bestehende Variablen
			VAR CurrentYTD = [ACT_Value]
			VAR CurPer = MAX(Revenues[Buchungsperiode])
			VAR HasRows = COUNTROWS(Revenues)
			
			-- 2. Die Vorperiode (nur berechnen, wenn ein Monat im Filterkontext ist)
			VAR PrevCum =
			    IF(
			        NOT(ISFILTERED(DIM_DATE[FY_MonatNr])) || CurPer = 1,
			        0,
			        CALCULATE([ACT_Value], DATEADD(DIM_DATE[Datum], -1, MONTH))
			    )
			
			-- 3. Das Ziel-YTD (Wenn nichts gefiltert ist, erzwinge P12)
			VAR TargetYTD = 
			    IF(
			        NOT(ISFILTERED(DIM_DATE[FY_MonatNr])),
			        CALCULATE([ACT_Value], ALL(DIM_DATE[FY_MonatNr]), DIM_DATE[FY_MonatNr] = 12),
			        CurrentYTD
			    )
			
			RETURN
			IF(
			    HasRows = 0 || ISBLANK(TargetYTD),
			    BLANK(),
			    TargetYTD - PrevCum
			)
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 252abade-6ec5-4791-8b54-c66fbbdafa90

