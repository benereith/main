		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 02 Umsatz gesamt\Forecast
		lineageTag: 0d0592d4-6860-4f80-96bb-fd652e4f0fe4

		annotation PBI_FormatHint = {"currencyCulture":"de"}

	/// YTD Budget, nur Plan_20 (laufendes GJ), inkl. Like for Like.
