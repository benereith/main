	/// Delta Forecast vs. Budget, Vertragsbeginn im laufenden GJ vor dem Retention-Snapshot.
	measure New_Roll_Bud_Exp_CY = ```
			VAR GJBeginn =
			    CALCULATE ( MIN ( 'DIM_DATE'[Datum] ), REMOVEFILTERS ( 'DIM_DATE' ), 'DIM_DATE'[FY_Offset] = 0 )
			VAR SnapshotR =
			    MAX ( Vergleichszeitpunkt[Timestamp] )
			RETURN
			    CALCULATE (
			        [BUD_2_FC],
			        SAP_Stammdaten[Betriebstyp] = "Real-Betriebe",
			        Revenues[cause_of_change] = 1,
			        SAP_Stammdaten[vertragsbeginn] >= GJBeginn,
			        SAP_Stammdaten[vertragsbeginn] < SnapshotR
			    )
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 06 Net New Roll\Details
		lineageTag: b8e0731b-1794-410c-9f67-be2af9081e02

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

