	/// Recherche-/Test-Measure (Alt): Ist Vorjahr, Bucket 7, CoC 4.
	measure Act_test = ```
			CALCULATE (
			    SUM ( Revenues[Betrag] ),
			    Revenues[Szenario] = "ACT",
			    Revenues[FY_Offset] = -1,
			    Revenues[MetricId] = 7,
			    SAP_Stammdaten[cause_of_change] = 4
			)
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: zz Recherche
		lineageTag: ea3f3dfa-0a62-4fec-826b-0b395d694f84

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Recherche-/Test-Measure (Alt): Plan_41 Vorjahr, Bucket 7, CoC 4.
	measure 41_test = ```
			CALCULATE (
			    SUM ( Revenues[Betrag] ),
			    Revenues[Szenario] = "R03",
			    Revenues[Werttyp_Version] = "Plan_41",
			    Revenues[FY_Offset] = -1,
			    Revenues[MetricId] = 7,
			    SAP_Stammdaten[cause_of_change] = 4
			)
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
