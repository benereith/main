	measure LT_Win% = ```
			
			-- 1. Greift das Datum ab, das du oben im Slicer "Vergleichszeitpunkt" gewählt hast
			VAR SelectedDate = ALLSELECTED('Snapshot_Timestamp_S'[Timestamp])
			
			VAR Result = 
			    CALCULATE(
			        MAX('Sales_Pipeline_ITY'[Win %]), 
			        -- 2. Wir überschreiben alle Datumsfilter und erzwingen das Slicer-Datum
			        KEEPFILTERS('Sales_Pipeline_ITY'[Timestamp] IN SelectedDate)
			    )
			
			RETURN
			    Result
