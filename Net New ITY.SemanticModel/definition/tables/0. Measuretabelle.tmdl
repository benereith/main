	/// Zeitfilter-gesteuert: MTD- oder YTD-Sicht auf Actuals (CoC 1/2).
	measure ACT_dynamisch = ```
			VAR Auswahl = SELECTEDVALUE ( 'Zeitfilter'[Ansicht], "MTD" )
			RETURN
			    CALCULATE (
			        SWITCH ( Auswahl, "MTD", [ACT_REV_Periodic], "YTD", [ACT_REV_YTD] ),
			        SAP_Stammdaten[cause_of_change] IN { 1, 2 }
			    )
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 04 Dynamisch (MTD-YTD)
		lineageTag: 1bdca7f9-50ff-4c2c-b477-af3a81cbb6ed

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Zeitfilter-gesteuert: MTD- oder YTD-Sicht auf das Budget (CoC 1/2).
	/// Filtert auf den im Budget eingefrorenen CoC-Stand der Faktenzeilen
	/// (früher: Spalte cause_of_change_BUD in den Stammdaten).
	measure BUD_dynamisch = ```
			VAR Auswahl = SELECTEDVALUE ( 'Zeitfilter'[Ansicht], "MTD" )
			RETURN
			    CALCULATE (
			        SWITCH ( Auswahl, "MTD", [BUD_REV_Periodic], "YTD", [BUD_REV_YTD] ),
			        Revenues[cause_of_change_szenario] IN { 1, 2 }
			    )
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 04 Dynamisch (MTD-YTD)
		lineageTag: 6c5cbdbb-457d-450c-a4df-e9ac46474bb8

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	/// Zeitfilter-gesteuert: MTD- oder YTD-Sicht auf den Forecast (CoC 1/2).
	measure FC_dynamisch = ```
			VAR Auswahl = SELECTEDVALUE ( 'Zeitfilter'[Ansicht], "MTD" )
			RETURN
			    CALCULATE (
			        SWITCH ( Auswahl, "MTD", [FC_REV_Periodic], "YTD", [FC_REV_YTD] ),
			        SAP_Stammdaten[cause_of_change] IN { 1, 2 }
			    )
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 04 Dynamisch (MTD-YTD)
		lineageTag: 56034549-cd31-4f9f-a35f-06c363ae30e4

