	measure 'R_Unweighted ITY' = ```
			
			SUMX(
			    VALUES(SAP_Stammdaten[Werk - Bezeichnung]),
			    IF(
			        [Retention_Status] = "At Risk",
			        [Retention_ITY] / (1 - [Retention%]),
			        [Retention_ITY]
			    )
			)
			
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 83ba9aca-8a08-46ad-b3d4-ba8cd79d7154

		annotation PBI_FormatHint = {"currencyCulture":"de"}

	measure 'Unweighted ITY' =
			
			SUMX(
			 VALUES(Sales_Pipeline_ITY[name]),
			    DIVIDE(
			        [Sales_ITY],
			        [Win%],
			        0 -- Gibt 0 statt Blank zurück, wenn Win% fehlt oder 0 ist
			    )
			)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 2326db22-2000-4ec5-9153-b991f7c60b24

		annotation PBI_FormatHint = {"currencyCulture":"de"}

	measure Anzahl_Opps_Act =
			
			VAR MaxTS = [Max_Timestamp_Sales]
			RETURN
			CALCULATE (
			    DISTINCTCOUNT(Sales_Pipeline_ITY[Name]),
			    KEEPFILTERS(Sales_Pipeline_ITY[Betrag] <> 0),
			    REMOVEFILTERS(Sales_Pipeline_ITY[Timestamp]),
			    Sales_Pipeline_ITY[Timestamp] = MaxTS
			)
		formatString: 0
		lineageTag: a143f20d-b7dd-4af9-b6cc-92b181ad94e7

	measure Anzahl_Opps =
			
