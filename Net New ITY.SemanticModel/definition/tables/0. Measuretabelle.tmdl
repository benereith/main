	measure Adj_FC_Value = ```
			
			VAR CurPeriode = MAX ( Revenues[Buchungsperiode] ) 
			
			VAR MaxActualPeriode = SELECTEDVALUE ( 'Abgeschlossene Periode'[Abgeschlossene Periode], 0 ) // Default 0, falls nichts ausgewählt
			
			RETURN IF ( CurPeriode <= MaxActualPeriode, -- Bis zur gewählten Periode: nur Actual (dein bestehendes Measure) 
			[Act_Value],
			 -- Danach: Plan_01 2025 + Actual_0 2024 wie bisher 
			 CALCULATE ( SUM ( Revenues[Betrag] ), Revenues[Werttyp_Version] = "Plan_02", Revenues[Geschäftsjahr] = max('N_Geschäftsjahr'[N_Geschäftsjahr]), Revenues[Mapping Wert] <> 99, Revenues[Mapping Art] = "Mapping CoCh FY", SAP_Stammdaten[Betriebstyp]<>"Plan-Betriebe Roll") + CALCULATE ( SUM ( Revenues[Betrag] ), Revenues[Werttyp_Version] = "Actual_0", Revenues[Geschäftsjahr] = max('N_Geschäftsjahr-1'[N_Geschäftsjahr-1]), Revenues[Mapping Wert] <> 99, Revenues[Mapping Art] = "Mapping CoCh FY"))
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: FC
		lineageTag: dd3e3127-8f0e-43c2-8fe5-1b862f80d007

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

