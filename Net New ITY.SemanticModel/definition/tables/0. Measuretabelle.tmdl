	/// Ist-Umsatz Vorjahr (Gesamtjahr, invertiert) der Retention-Werke.
	measure ARO_LY = ```
			VAR PeriodenGesamtGJ =
			    CALCULATETABLE (
			        DISTINCT ( 'DIM_DATE'[Datum] ),
			        REMOVEFILTERS ( 'DIM_DATE' ),
			        VALUES ( 'DIM_DATE'[FY_Start] )
			    )
			RETURN
			    CALCULATE (
			        SUM ( Revenues[Betrag] ),
			        Revenues[Szenario] = "ACT",
			        Revenues[FY_Offset] = -1,
			        REMOVEFILTERS ( 'DIM_DATE' ),
			        PeriodenGesamtGJ,
			        TREATAS ( VALUES ( Retention_ITY_CRM[Werk] ), Revenues[Werk] )
			    ) * -1
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: 05 Hybrid und ARO
		lineageTag: 89a69ec8-aee4-432b-a33c-94b3084daec2

