	measure Retention_% = ```
			
			VAR MaxTimestamp = 
			    MAX('Retention_ITY_CRM'[Timestamp]) -- 1. Finde den maximalen Timestamp in der aktuellen Filterung
			
			VAR Result = 
			    CALCULATE(
			        MAX(Retention_ITY_CRM[Retention-Wahrscheinlichkeit]), -- 2. Liefere das Opening Date
			        Retention_ITY_CRM[Timestamp] = MaxTimestamp -- 3. Filtert die Tabelle nur auf die Zeile(n) mit diesem maximalen Timestamp
			    )
			
			RETURN
			    Result
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: d538baee-4394-4f4d-aa4c-3293345d71b1

	measure RF_Value =
			
			
			CALCULATE (
			
			    SUM ( Revenues[Betrag] ),
			
			     Revenues[Werttyp_Version] in { "Plan_RF", "Plan_RTD"},
			
			    Revenues[Mapping Wert] <> 99,
			
			    Revenues[Mapping Art] = "Mapping CoCh FY",
			
			    Revenues[Geschäftsjahr] = MAX ( 'N_Geschäftsjahr'[N_Geschäftsjahr] )
			
			)
			
			+
			
			CALCULATE (
			
			    SUM ( Revenues[Betrag] ),
			
			    Revenues[Werttyp_Version] = "Actual_0",
			
			    Revenues[Mapping Wert] <> 99,
			
			    Revenues[Mapping Art] = "Mapping CoCh FY",
			
			    Revenues[Geschäftsjahr] = MAX ( 'N_Geschäftsjahr-1'[N_Geschäftsjahr-1] )
			
			)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 0a8aa4c0-4351-4f76-86d6-612db86804f1

		annotation PBI_FormatHint = {"currencyCulture":"de"}

	measure RF_Periodic = ```
			
			-- 1. Bestehende Variablen
			VAR CurrentYTD = [RF_Value]
			
			-- WICHTIG: Immer die Dimensionstabelle für Zeit-Variablen nutzen!
			VAR CurPer = MAX('DIM_DATE'[FY_MonatNr]) 
			
			-- 2. Die Vorperiode 
			VAR PrevCum =
			    IF(
			        NOT(ISFILTERED('DIM_DATE'[FY_MonatNr])) || CurPer = 1,
			        0,
			        CALCULATE([RF_Value], DATEADD('DIM_DATE'[Datum], -1, MONTH))
			    )
			
			-- 3. Das Ziel-YTD
			VAR TargetYTD = 
			    IF(
			        NOT(ISFILTERED('DIM_DATE'[FY_MonatNr])),
			        CALCULATE([RF_Value], ALL('DIM_DATE'[FY_MonatNr]), 'DIM_DATE'[FY_MonatNr] = 12),
			        CurrentYTD
			    )
			
			RETURN
			-- Den HasRows-Block entfernt, damit Forecast-Monate ohne Ist-Daten nicht gekillt werden
			IF(
			    ISBLANK(TargetYTD),
			    BLANK(),
			    TargetYTD - PrevCum
			)
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 08abeeb6-3d07-4704-89cd-7f02ac9405cf

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure Hybrid_Gesamtwert_RGF =
			
			VAR AusgewaehlterMonat = SELECTEDVALUE('Abgeschlossene Periode'[Abgeschlossene Periode], 12)
			
			RETURN
			SUMX(
			    VALUES(DIM_DATE[FY_MonatNr]), // Iteriere über alle Monate im aktuellen Filterkontext
			    IF(
			        DIM_DATE[FY_MonatNr] <= AusgewaehlterMonat,
			        [ACT_Periodic],
			        [RGF_Periodic]
			    )
			)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 458362a8-32c0-49ef-a150-960f3e07c1f7

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'LT_Contract End Date' = ```
			
			-- 1. Greift das Datum ab, das du oben im Slicer "Vergleichszeitpunkt" gewählt hast
			VAR SelectedDate = ALLSELECTED('Snapshot_Timestamp_R'[Timestamp])
			
			VAR Result = 
			    CALCULATE(
			        MAX('Retention_ITY_CRM'[Contract End Date]), 
			        -- 2. Wir überschreiben alle Datumsfilter und erzwingen das Slicer-Datum
			        KEEPFILTERS('Retention_ITY_CRM'[Timestamp] IN SelectedDate)
			    )
			
			RETURN
			    Result
			```
		formatString: Short Date
		lineageTag: 4ce9fd59-30e3-40fa-a4c0-746839ec93ac

	measure Contract_End_Date = ```
			
			VAR MaxTimestamp = 
			    MAX('Retention_ITY_CRM'[Timestamp]) -- 1. Finde den maximalen Timestamp in der aktuellen Filterung
			
			VAR Result = 
			    CALCULATE(
			        MAX(Retention_ITY_CRM[Contract End Date]), -- 2. Liefere das Opening Date
			        Retention_ITY_CRM[Timestamp] = MaxTimestamp -- 3. Filtert die Tabelle nur auf die Zeile(n) mit diesem maximalen Timestamp
			    )
			
			RETURN
			    Result
			```
		formatString: Short Date
		lineageTag: 21a6726b-db81-469b-8f87-949d5403ab50

	measure Hybrid_Gesamtwert_RF =
			
			VAR AusgewaehlterMonat = SELECTEDVALUE('Abgeschlossene Periode'[Abgeschlossene Periode], 12)
			
			RETURN
