	/// Recherche-Measure (versteckt): (Plan_01 laufendes GJ + Ist Vorjahr) / 4.
	measure RECH_adj_BUD_Value = ```
			VAR p = MAX ( 'DIM_DATE'[FY_MonatNr] )
			VAR PeriodenYTD =
			    CALCULATETABLE (
			        DISTINCT ( 'DIM_DATE'[Datum] ),
			        REMOVEFILTERS ( 'DIM_DATE' ),
			        'DIM_DATE'[FY_MonatNr] <= p,
			        VALUES ( 'DIM_DATE'[FY_Start] )
			    )
			RETURN
			    (
			        CALCULATE ( SUM ( Revenues[Betrag] ), Revenues[Szenario] = "R01", REMOVEFILTERS ( 'DIM_DATE' ), PeriodenYTD )
			            + CALCULATE ( SUM ( Revenues[Betrag] ), Revenues[Szenario] = "ACT", Revenues[FY_Offset] = -1, REMOVEFILTERS ( 'DIM_DATE' ), PeriodenYTD )
			    ) / 4
			```
		displayFolder: zz Recherche
		lineageTag: fb47418e-8a12-4ca7-8797-c3f66adc3ebd

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Ist-Umsatz Vorjahr der Werke aus der Retention-Pipeline (Recherche).
	measure REV_LY = ```
			VAR p = MAX ( 'DIM_DATE'[FY_MonatNr] )
			VAR PeriodenYTD =
			    CALCULATETABLE (
			        DISTINCT ( 'DIM_DATE'[Datum] ),
			        REMOVEFILTERS ( 'DIM_DATE' ),
			        'DIM_DATE'[FY_MonatNr] <= p,
			        VALUES ( 'DIM_DATE'[FY_Start] )
			    )
			RETURN
			    CALCULATE (
			        SUM ( Revenues[Betrag] ),
			        Revenues[Szenario] = "ACT",
			        Revenues[FY_Offset] = -1,
			        REMOVEFILTERS ( 'DIM_DATE' ),
			        PeriodenYTD,
			        TREATAS ( VALUES ( Retention_ITY_CRM[Werk] ), Revenues[Werk] )
			    )
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: zz Recherche
		lineageTag: 84c304e4-79d8-4409-97c5-ad3ff8d895e0

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

