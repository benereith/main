	/// Hybrid Gesamtwert: bis zur gewählten abgeschlossenen Periode Actuals,
	/// danach Forecast RF/RTD.
	measure Hybrid_Gesamtwert_RF = ```
			VAR AusgewaehlterMonat = SELECTEDVALUE ( 'Abgeschlossene Periode'[Abgeschlossene Periode], 12 )
			RETURN
			    SUMX (
			        VALUES ( DIM_DATE[FY_MonatNr] ),
			        IF (
			            DIM_DATE[FY_MonatNr] <= AusgewaehlterMonat,
			            [ACT_Periodic],
			            [RF_Periodic]
			        )
			    )
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 05 Hybrid und ARO
		lineageTag: 1e0c82e7-c40c-4ca4-8366-d0bb0c6ec78f

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'R_Unweighted ITY' = ```
			SUMX (
			    VALUES ( SAP_Stammdaten[Werk - Bezeichnung] ),
			    IF (
			        [Retention_Status] = "At Risk",
			        [Retention_ITY] / ( 1 - [Retention%] ),
			        [Retention_ITY]
			    )
			)
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 08 CRM Retention
		lineageTag: 83ba9aca-8a08-46ad-b3d4-ba8cd79d7154

		annotation PBI_FormatHint = {"currencyCulture":"de"}

	measure Win% = ```
			AVERAGEX (
			    KEEPFILTERS (
			        CROSSJOIN (
			            VALUES ( Sales_Pipeline_ITY[Name] ),
			            VALUES ( Sales_Pipeline_ITY[Timestamp] )
			        )
			    ),
			    CALCULATE ( AVERAGE ( Sales_Pipeline_ITY[Win %] ) )
			)
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: 09 CRM Sales
		lineageTag: 82ed9d2c-6475-4fa7-8cb0-9668804002fd

