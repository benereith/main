		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Sales_ITY_Act = ```
			
			VAR MaxTS = [Max_Timestamp_Sales]
			RETURN
			CALCULATE (
			    [Sales_ITY],  -- = SUM(Betrag)*-1
			    REMOVEFILTERS (Sales_Pipeline_ITY[Timestamp] ),     -- alte Timestamp-Filter weg
			    Sales_Pipeline_ITY[Timestamp] = MaxTS                -- nur der letzte Snapshot
			)
			
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 4e4a044a-92b9-4aa5-a174-f7bfea16f374

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure Sales_ITY_Hist = ```
			
			VAR SelTS =
			    SELECTEDVALUE ( Snapshot_Timestamp_s[Timestamp] )
			RETURN
			IF (
			    ISBLANK ( SelTS ),
			    BLANK (),          -- oder [Retention_ITY_Latest] als Default, wenn kein Slicer gewählt
			    CALCULATE (
			        [Sales_ITY],
			        REMOVEFILTERS ( Sales_Pipeline_ITY[Timestamp] ),
			        Sales_Pipeline_ITY[Timestamp] = SelTS
			    )
			)
			
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 865181b9-29f6-427c-8479-895643cb619b

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure Retention_ITY_Act = ```
			
			VAR MaxTS = [Max_Timestamp_Retention]
			RETURN
			CALCULATE (
			    [Retention_ITY],  -- = SUM(Betrag)*-1
			    REMOVEFILTERS ( Retention_ITY_CRM[Timestamp] ),     -- alte Timestamp-Filter weg
			    Retention_ITY_CRM[Timestamp] = MaxTS                -- nur der letzte Snapshot
			)
			
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 48ebf096-fb9e-4ab1-9ffd-a15fe686dbe6

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure Retention_ITY_Hist = ```
			
			VAR SelTS =
			    SELECTEDVALUE ( Snapshot_Timestamp_R[Timestamp] )
			RETURN
			IF (
			    ISBLANK ( SelTS ),
			    BLANK (),          -- oder [Retention_ITY_Latest] als Default, wenn kein Slicer gewählt
			    CALCULATE (
			        [Retention_ITY],
			        REMOVEFILTERS ( Retention_ITY_CRM[Timestamp] ),
			        Retention_ITY_CRM[Timestamp] = SelTS
			    )
			)
			
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: cc1a0ac2-5e03-4839-8523-3335e8335516

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure Max_Timestamp_Sales = ```
			
			MAXX (
			    ALL ( Sales_Pipeline_ITY[Timestamp] ),
			    Sales_Pipeline_ITY[Timestamp]
			)
			
			```
		formatString: General Date
		lineageTag: 5ea7362d-96eb-4be1-9995-c4a5c1a7e93a

	measure Max_Timestamp_Retention = ```
			
			MAXX (
			    ALL ( Retention_ITY_CRM[Timestamp] ),
			    Retention_ITY_CRM[Timestamp]
			)
			
			```
		formatString: General Date
		lineageTag: f62c9ad9-1982-454b-82f4-1199beb32ed5

	measure ARO_LY =
			
			CALCULATE(
			    SUM(Revenues[Betrag]),
			    Revenues[Geschäftsjahr] = MAX('N_Geschäftsjahr-1'[N_Geschäftsjahr-1]),
			    Revenues[Werttyp_Version] = "Actual_0",
			    Revenues[Mapping Art]= "Mapping CoCh",
			    Revenues[Buchungsperiode]=12,
			    TREATAS(
			        VALUES(Retention_ITY_CRM[Werk]), -- Die Werks-Werte aus der Retention-Tabelle
			        Revenues[Werk]                   -- werden auf die Werks-Spalte der Revenues-Tabelle angewandt
			    )
			)*-1
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 89a69ec8-aee4-432b-a33c-94b3084daec2

	measure BUD_2_FC = [RGF_Periodic]-[BUD_Periodic]
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 8210a8c7-8693-4713-a034-66ab7b9814c4

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'Opening Date' = ```
			
			VAR MaxTimestamp = 
			    MAX('Sales_Pipeline_ITY'[Timestamp]) -- 1. Finde den maximalen Timestamp in der aktuellen Filterung
			
			VAR Result = 
			    CALCULATE(
			        MAX(Sales_Pipeline_ITY[Opening Date]), -- 2. Liefere das Opening Date
			        Sales_Pipeline_ITY[Timestamp] = MaxTimestamp -- 3. Filtert die Tabelle nur auf die Zeile(n) mit diesem maximalen Timestamp
			    )
			
			RETURN
			    Result
			```
		formatString: Short Date
		lineageTag: aa908e4a-a3d1-42c3-bf98-d09932ce0a61

	measure Win%_Act =
			
			VAR MaxTS = [Max_Timestamp_Sales]
			RETURN
			CALCULATE (
			    AVERAGE(Sales_Pipeline_ITY[Win %]),
			    REMOVEFILTERS(Sales_Pipeline_ITY[Timestamp]),
			    Sales_Pipeline_ITY[Timestamp] = MaxTS
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 3c55d16e-1831-4e0f-98b5-0a046060c166

	measure New_Roll_Bud_Exp_LY =
			
			CALCULATE(
			    [BUD_2_FC],
			    SAP_Stammdaten[Betriebstyp] = "Real-Betriebe",
			    Revenues[cause_of_change] = 1,
			    SAP_Stammdaten[vertragsbeginn] < max('Geschäftsjahresbeginn'[Geschäftsjahresbeginn]) -- 💡 HIER IST DIE KORREKTUR
			)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: cff75afd-470b-4ecd-9641-fb4dd17c9c54

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure FC_ARO = ```
			
			
			    CALCULATE ( 
			        SUM ( Revenues[Betrag] ), 
			        Revenues[Werttyp_Version] = "Plan_RGF", 
			        Revenues[Geschäftsjahr] = MAX('N_Geschäftsjahr'[N_Geschäftsjahr]), 
			        Revenues[Mapping Wert] <> 99, 
			        Revenues[Mapping Art] = "Mapping CoCh RGF", 
			        SAP_Stammdaten[Betriebstyp] <> "Plan-Betriebe Roll", Revenues[Buchungsperiode]=12)
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 4461dfb1-417e-4bc2-815e-f5df133fdd6d

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure Bud_ARO = ```
			
			
			    CALCULATE ( 
			        SUM ( Revenues[Betrag] ), 
			        Revenues[Werttyp_Version] = "Plan_20", 
			        Revenues[Geschäftsjahr] = MAX('N_Geschäftsjahr'[N_Geschäftsjahr]), 
			        Revenues[Mapping Wert] <> 99, 
			        Revenues[Mapping Art] = "Mapping CoCh BUD", 
			        SAP_Stammdaten[Betriebstyp] <> "Plan-Betriebe Roll",
			        Revenues[Buchungsperiode]=12)
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 7c049c07-beb7-4b98-8316-2f3df4e797d7

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure New_Roll_Bud_Exp_CY =
			
			CALCULATE(
			    [BUD_2_FC],
			    SAP_Stammdaten[Betriebstyp] = "Real-Betriebe",
			    Revenues[cause_of_change] = 1,
			    SAP_Stammdaten[vertragsbeginn] >= max('Geschäftsjahresbeginn'[Geschäftsjahresbeginn]), SAP_Stammdaten[vertragsbeginn]< max(Snapshot_Timestamp_R[Timestamp]) -- 💡 HIER IST DIE KORREKTUR
			)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: b8e0731b-1794-410c-9f67-be2af9081e02

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure New_Roll_Bud_No_Exp =
			
			CALCULATE(
			    [BUD_2_FC],
			    SAP_Stammdaten[Betriebstyp] = "Real-Betriebe",
			    Revenues[cause_of_change] = 1,
			    -- Hier kommt der korrigierte Filter:
			    OR(
			        ISBLANK(SAP_Stammdaten[vertragsbeginn]), -- 1. Schließt Verträge mit leerem Beginn ein
			        SAP_Stammdaten[vertragsbeginn] > MAX(Snapshot_Timestamp_R[Timestamp]) -- 2. Schließt Verträge mit Beginn nach dem Snapshot-Timestamp ein
			    )
			)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 9be3305f-39c4-48ac-8893-8dc10bbfbf89

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'Closing Date' = ```
			
			VAR MaxTimestamp = 
			    MAX('Sales_Pipeline_ITY'[Timestamp]) -- 1. Finde den maximalen Timestamp in der aktuellen Filterung
			
			VAR Result = 
			    CALCULATE(
			        MAX(Sales_Pipeline_ITY[Est Close Date]), -- 2. Liefere das Opening Date
			        Sales_Pipeline_ITY[Timestamp] = MaxTimestamp -- 3. Filtert die Tabelle nur auf die Zeile(n) mit diesem maximalen Timestamp
			    )
			
			RETURN
			    Result
			```
		formatString: Short Date
		lineageTag: ffa9aae1-3a98-4198-916c-d638b6c77eef

	measure New_Roll_Bud =
			
			CALCULATE(
			    [BUD_Periodic],
			    SAP_Stammdaten[Betriebstyp] = "Real-Betriebe",
			    Revenues[cause_of_change] = 1)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 84cebb7e-362a-4e39-9d28-610462eae716

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'New Roll Budget' = ```
			
			CALCULATE(
			    [BUD_Periodic],
			    KEEPFILTERS( DIM_Struktur[MetricId] IN { 1, 2 } )
			)
			
			```
		formatString: 0
		lineageTag: 721ea774-ef20-492b-8812-a689d82a2e81

	measure 'Unweighted ITY_Act' =
			
			SUMX(
			    KEEPFILTERS(VALUES(Sales_Pipeline_ITY[name])),
			    VAR currentSales = [Sales_ITY_Act]
			    VAR currentWin = [Win%_Act]
			    RETURN
			    IF(
			        NOT ISBLANK(currentSales) && currentWin > 0,
			        DIVIDE(currentSales, currentWin),
			        0
			    )
			)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: a8a05f3a-3d51-4db7-b7af-efc744b5029a

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'R_Unweighted ITY_ACT' = ```
			
			SUMX(
			    VALUES(SAP_Stammdaten[Werk - Bezeichnung]),
			    IF(
			        [Retention_Status] = "At Risk",
			        [Retention_ITY_Act] / (1 - [Retention%]),
			        [Retention_ITY_Act]
			    )
			)
			
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 8a8b3621-4886-4e61-b152-b08ce9a1f69e

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure Retention_Status = ```
			
			VAR MaxTimestamp = 
			    MAX('Retention_ITY_CRM'[Timestamp]) -- 1. Finde den maximalen Timestamp in der aktuellen Filterung
			
			VAR Result = 
			    CALCULATE(
			        MAX(Retention_ITY_CRM[Retention_Status]), -- 2. Liefere das Opening Date
			        Retention_ITY_CRM[Timestamp] = MaxTimestamp -- 3. Filtert die Tabelle nur auf die Zeile(n) mit diesem maximalen Timestamp
			    )
			
			RETURN
			    Result
			```
		lineageTag: 24c0fcdf-89c6-4ead-bb72-50f92224f81b

	measure Retention% = ```
			
			VAR MaxTimestamp = 
			    MAX('Retention_ITY_CRM'[Timestamp]) -- 1. Finde den maximalen Timestamp in der aktuellen Filterung
			
			VAR Result = 
			    CALCULATE(
			        MAX(Retention_ITY_CRM[Retention-Wahrscheinlichkeit]), -- 2. Liefere das Opening Date
			        Retention_ITY_CRM[Timestamp] = MaxTimestamp -- 3. Filtert die Tabelle nur auf die Zeile(n) mit diesem maximalen Timestamp
			    )
			
			RETURN
			    Result
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 0a582a06-9333-40a7-a9b7-337757b5c222

	measure 'New Roll Forecast/Actuals' = ```
			
			CALCULATE(
			    [RGF_Value],
			    KEEPFILTERS( DIM_Struktur[MetricId] IN { 1, 2 } )
			)
			
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: e8d0765f-0f0a-4760-843a-1c4ec15c6491

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'KPI Value' = ```
			
			VAR _KPI = SELECTEDVALUE ( 'KPI'[KPI] )
			RETURN
			IF (
			    ISBLANK(_KPI), 
			    BLANK(),
			    SWITCH (
			        TRUE(),
			        _KPI = " ", 0, -- Das zwingt die Zeile zur Anzeige. Zebra BI zeigt bei 0 oft einfach nichts an, lässt aber den Platz.
			        _KPI = "New Roll Budget",           [New Roll Budget],
			        _KPI = "New Roll Forecast/Actuals", [New Roll Forecast/Actuals],
			        _KPI = "New Roll Delta",            [New Roll Delta],
			        _KPI = "Lost Roll Budget",          [Lost Roll Budget],
			        _KPI = "Lost Roll Forecast/Actuals",[Lost Roll Forecast/Actuals],
			        _KPI = "Lost Roll Delta",           [Lost Roll Delta],
			        _KPI = "Net New Roll Budget",       [Net New Roll Budget],
			        _KPI = "Net New Roll Forecast/Actuals", [Net New Roll Forecast/Actuals],
			        _KPI = "Net New Roll Delta",        [Net New Roll Delta],
			        
			        -- WICHTIG: Damit die Zeile existiert, darf das Endergebnis nicht "echt" Blank sein.
			        -- Wir geben ein sehr kleines COALESCE mit 0 mit, falls es eine Leerzeile ist:
			        IF(_KPI = " ", 0, BLANK())
			    )
			)
			```
		formatString: " "
		lineageTag: ead5e93e-7d91-4ce7-a64f-7b49ef392f32

		annotation PBI_FormatHint = {"isCustom":true}

