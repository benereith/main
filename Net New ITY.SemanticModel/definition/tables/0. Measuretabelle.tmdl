			        CurrentYTD
			    )
			
			RETURN
			IF(
			    HasRows = 0 || ISBLANK(TargetYTD),
			    BLANK(),
			    TargetYTD - PrevCum
			)
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 7461a2f9-2312-480d-9f43-18f84a1c3cfb

