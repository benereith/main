	measure R03_Periodic = ```
			
			-- 1. Bestehende Variablen
			VAR CurrentYTD = [R03_Value]
			VAR CurPer = MAX(Revenues[Buchungsperiode])
			VAR HasRows = COUNTROWS(Revenues)
			
			-- 2. Die Vorperiode (nur berechnen, wenn ein Monat im Filterkontext ist)
			VAR PrevCum =
			    IF(
			        NOT(ISFILTERED(DIM_DATE[FY_MonatNr])) || CurPer = 1,
			        0,
			        CALCULATE([R03_Value], DATEADD(DIM_DATE[Datum], -1, MONTH))
