expression Aktuelles_Geschäftsjahr = Date.Year(Geschäftsjahresbeginn)
	lineageTag: afaf1a49-3109-4811-98a8-593a83412a1d
	queryGroup: '1. Konfiguration'

	annotation PBI_ResultType = Number

expression Szenario_Konfig = ```
		let
		    // Spalte Berichtsjahr_Start = absolutes Geschäftsjahr, auf das sich das
		    // Szenario bezieht. FY_Offset ist der Offset RELATIV dazu (0 = dieses
		    // Jahr, -1 = dessen Vorjahr). Absolutes Quelljahr = Berichtsjahr_Start
		    // + FY_Offset. So funktioniert dieselbe Engine für beliebig viele
		    // Berichtsjahre nebeneinander (FY26, FY27, …).
		    A = Aktuelles_Geschäftsjahr,
		    Quelle = #table(
		        type table [Szenario = text, Sort = Int64.Type, Berichtsjahr_Start = Int64.Type, FY_Offset = Int64.Type, Werttyp_Version = text, CoC_Quelle = text, CoC_Snapshot = nullable date, CoC_Spalte_Adjustments = text, Perioden_Freeze = logical],
		        {
		            // ===== Berichtsjahr FY26 (= Aktuelles_Geschäftsjahr) =====
		            // Actuals (Ist-Werte, CoC = aktueller Stand)
		            {"ACT",     1, A,  0, "Actual_0", "live",     null,                     "cause_of_change",     true},
		            {"ACT",     1, A, -1, "Actual_0", "live",     null,                     "cause_of_change",     true},
		            // Budget (vollständig eingefroren zum Budget-Snapshot)
		            {"BUD",     2, A,  0, "Plan_20",  "snapshot", Parameter_BUD_Stammdaten, "cause_of_change_BUD", false},
		            {"BUD",     2, A, -1, "Plan_35",  "snapshot", Parameter_BUD_Stammdaten, "cause_of_change_BUD", false},
		            // Rolling Forecast (RGF) = aktueller FC 8+4: Plan_RGF + R12-Aufsatz + Ist Vorjahr
		            {"RGF",     3, A,  0, "Plan_RGF", "live_fy",  null,                     "cause_of_change_fy",  true},
		            {"RGF",     3, A,  0, "Plan_R12", "live_fy",  null,                     "cause_of_change_fy",  true},
		            {"RGF",     3, A, -1, "Actual_0", "live_fy",  null,                     "cause_of_change_fy",  true},
		            // 5+7 = Plan_RGF ohne R12-Aufsatz (Basis von 8+4) + Ist Vorjahr.
		            {"FC57",   10, A,  0, "Plan_RGF", "live_fy",  null,                     "cause_of_change_fy",  true},
		            {"FC57",   10, A, -1, "Actual_0", "live_fy",  null,                     "cause_of_change_fy",  true},
		            // Forecast RF/RTD
		            {"RF",      4, A,  0, "Plan_RF",  "live_fy",  null,                     "cause_of_change_fy",  true},
		            {"RF",      4, A,  0, "Plan_RTD", "live_fy",  null,                     "cause_of_change_fy",  true},
		            {"RF",      4, A, -1, "Actual_0", "live_fy",  null,                     "cause_of_change_fy",  true},
		            // Plan 35 + RTD (= 10+2)
		            {"P35",     5, A,  0, "Plan_35",  "live_fy",  null,                     "cause_of_change_fy",  true},
		            {"P35",     5, A,  0, "Plan_RTD", "live_fy",  null,                     "cause_of_change_fy",  true},
		            {"P35",     5, A, -1, "Actual_0", "live_fy",  null,                     "cause_of_change_fy",  true},
		            // Forecast-Runde R03 (= 2+10, Snapshot-Stand R03)
		            {"R03",     6, A,  0, "Plan_R03", "snapshot", Parameter_R03_Stammdaten, "cause_of_change_R03", true},
		            {"R03",     6, A, -1, "Plan_41",  "snapshot", Parameter_R03_Stammdaten, "cause_of_change_R03", true},
		            // Forecast Plan 02 (für Adj_FC_Value)
		            {"FC02",    7, A,  0, "Plan_02",  "live_fy",  null,                     "cause_of_change_fy",  true},
		            {"FC02",    7, A, -1, "Actual_0", "live_fy",  null,                     "cause_of_change_fy",  true},
		            // ARO-Sicht auf den RGF-Snapshot (für FC_ARO)
		            {"ARO_RGF", 8, A,  0, "Plan_RGF", "snapshot", Parameter_RGF_Stammdaten, "cause_of_change_RGF", true},
		            // Recherche: Plan 01 (nur für verstecktes Measure RECH_adj_BUD_Value)
		            {"R01",     9, A,  0, "Plan_01",  "live",     null,                     "cause_of_change",     true},

		            // ===== Berichtsjahr FY27 (= Aktuelles_Geschäftsjahr + 1) =====
		            // Budget FY27: laufendes Jahr = Plan_20 (FY27), Vorjahres-Basis =
		            // FY26-Forecast (RGF + R12). CoC eingefroren zum Budget-FY27-
		            // Snapshot (cause_of_change_ny, Stichtag Parameter_BUD_FY27_Stammdaten).
		            {"BUD_FY27", 20, A + 1,  0, "Plan_20",  "snapshot", Parameter_BUD_FY27_Stammdaten, "cause_of_change_BUD", false},
		            {"BUD_FY27", 20, A + 1, -1, "Plan_RGF", "snapshot", Parameter_BUD_FY27_Stammdaten, "cause_of_change_BUD", false},
		            {"BUD_FY27", 20, A + 1, -1, "Plan_R12", "snapshot", Parameter_BUD_FY27_Stammdaten, "cause_of_change_BUD", false}
		        }
		    )
		in
		    Quelle
		```
	lineageTag: 9bb1b699-1027-4a2c-ac6b-c53f58eb2035
	queryGroup: '1. Konfiguration'

	annotation PBI_ResultType = Table

expression fnFiscal_DatumZuPeriode = ```
		// Liefert die Buchungsperiode (1..12) eines Datums im verschobenen GJ.
		// Beispiel bei GJ-Beginn Oktober: Okt=1, Nov=2, ..., Sep=12
		(datum as date) as number =>
		let
		    m = Date.Month(datum),
		    Periode = if m >= FY_Startmonat then m - FY_Startmonat + 1 else m + 12 - FY_Startmonat + 1
		in
		    Periode
		```
	lineageTag: b3391a5c-a380-4edf-9127-736b97b1a097
	queryGroup: '2. Funktionen'

	annotation PBI_ResultType = Function

expression fnFiscal_DatumZuGJ = ```
		// Liefert das Geschäftsjahr (= Kalenderjahr des GJ-Beginns) eines Datums.
		// Beispiel: 15.11.2025 -> 2025, 15.03.2026 -> 2025
		(datum as date) as number =>
		    if Date.Month(datum) >= FY_Startmonat then Date.Year(datum) else Date.Year(datum) - 1
		```
	lineageTag: 5f2249a8-fff9-49bf-9ed3-2262ca582bb5
	queryGroup: '2. Funktionen'

	annotation PBI_ResultType = Function

expression fnFiscal_PeriodeZuDatum = ```
		// Liefert den Monatsersten zu (Geschäftsjahr, Buchungsperiode).
		// Beispiel: (2025, 1) -> 01.10.2025, (2025, 4) -> 01.01.2026
		(gj as number, periode as number) as date =>
		let
		    m0 = FY_Startmonat + periode - 1,
		    Jahr = gj + Number.IntegerDivide(m0 - 1, 12),
		    Monat = Number.Mod(m0 - 1, 12) + 1
		in
		    #date(Jahr, Monat, 1)
		```
	lineageTag: a92172a6-ce13-4612-9c48-828b94b4c521
	queryGroup: '2. Funktionen'

	annotation PBI_ResultType = Function

expression fnCoC_ZuMetricId = ```
		// Ordnet (GJ-Offset, Cause of Change) der Berichtsstruktur (DIM_Struktur) zu.
		// MetricIds: 1 = PY revenue from contracts won PY, 2 = CY revenue from contracts won PY,
		//            4 = New Business ITY, 6 = Lost Business Roll,
		//            7 = PY revenue from contracts lost CY, 8 = CY revenue from contracts lost CY,
		//            99 = Like for Like
		// Für weitere Geschäftsjahre (Offset < -1) muss die Zuordnung hier erweitert werden.
		(fyOffset as number, coc as nullable number) as number =>
		let
		    c = coc ?? -1,
		    MetricId =
		        if fyOffset = -1 and c = 1 then 1
		        else if fyOffset = 0 and c = 1 then 2
		        else if fyOffset = 0 and c = 2 then 4
		        else if c = 3 then 6
		        else if fyOffset = -1 and c = 4 then 7
		        else if fyOffset = 0 and c = 4 then 8
		        else 99
		in
		    MetricId
		```
	lineageTag: f754784e-ae4b-4b6a-95ab-b58e89cfdc6a
	queryGroup: '2. Funktionen'

	annotation PBI_ResultType = Function

expression fnStammdaten_Snapshot = ```
		// Liefert den eingefrorenen Cause-of-Change-Stand aller Betriebe zu einem
		// Snapshot-Datum aus dem Lakehouse-Export (exports_md).
		// Ersetzt die früheren Einzelabfragen md_BUD / md_RGF / md_R03.
		// cocSpalte wählt, welcher CoC-Stand eingefroren wird:
		//   "cause_of_change_fy" = Stand zum GJ-Ende des LAUFENDEN Jahres (Standard, FY26)
		//   "cause_of_change_ny" = Stand im KOMMENDEN Geschäftsjahr (z. B. FY27-Budget)
		(snapshotDatum as date, optional cocSpalte as text) as table =>
		let
		    Spalte = cocSpalte ?? "cause_of_change_fy",
		    Quelle = Sql.Database(Lakehouse_Server, Lakehouse_Datenbank),
		    exports_md = Quelle{[Schema = "dbo", Item = "exports_md"]}[Data],
		    Typisiert = Table.TransformColumnTypes(exports_md, {{"update_ts", type date}}),
		    Gefiltert = Table.SelectRows(Typisiert, each [update_ts] = snapshotDatum),
		    Auswahl = Table.SelectColumns(Gefiltert, {"betrieb", Spalte}),
		    Umbenannt = Table.RenameColumns(Auswahl, {{Spalte, "coc"}}),
		    Dedupliziert = Table.Distinct(Umbenannt, {"betrieb"})
		in
		    Dedupliziert
		```
	lineageTag: c4cbc0a8-62e5-4178-81fd-fa118599e1ee
	queryGroup: '2. Funktionen'

	annotation PBI_ResultType = Function

expression Stammdaten_Dataflow = ```
		// BLATT-ABFRAGE: greift ausschließlich auf den Dataflow zu (keine
		// Referenz auf andere Abfragen) -> Formula-Firewall-konform.
		let
		    Quelle = PowerPlatform.Dataflows(null),
		    Workspaces = Quelle{[Id = "Workspaces"]}[Data],
		    Workspace = Workspaces{[workspaceId = "ddc66bda-5a20-49f0-be6e-b68e17a1cc90"]}[Data],
		    Dataflow = Workspace{[dataflowId = "a65e47b1-6a8b-4cf2-8131-c90e55bf14c7"]}[Data],
		    sap_master_data_unit = Dataflow{[entity = "sap_master_data_unit", version = ""]}[Data],
		    MitWerkBezeichnung = Table.AddColumn(sap_master_data_unit, "Werk - Bezeichnung", each Text.Combine({Text.PadStart(Text.From([betrieb], "de-DE"), 4, "0"), " - ", [bezeichnung_betrieb]}), type text),

		    // Zuordnung der Plan-Betriebe (Konfiguration)
		    PlanbetriebeRoll =
		    {   127, 1678, 1680, 1682, 1684, 1686, 1688, 1690, 1692, 1694, 1696, 1862, 1863,
		        2119, 4350, 4590, 5200, 5226, 7133, 7120, 7937, 8535, 8849, 9736, 9747, 9876, 9937 },
		    PlanbetriebeITY =
		    {   1679, 1681, 1683, 1685, 1687, 1689, 1691, 1693, 1695, 7933, 8385, 8386, 9911,
		        9913, 9916, 9920, 9922, 9924, 9926, 9933, 9936, 9940, 9944, 9945, 9946, 9947,
		        9950, 9952 },
		    MitBetriebstyp = Table.AddColumn(MitWerkBezeichnung, "Betriebstyp", each
		        if List.Contains(PlanbetriebeRoll, [betrieb]) then "Plan-Betriebe Roll"
		        else if List.Contains(PlanbetriebeITY, [betrieb]) then "Plan-Betriebe ITY"
		        else "Real-Betriebe", type text)
		in
		    MitBetriebstyp
		```
	lineageTag: b41d2d2b-cde2-4f3b-92a6-ae1342bfa511
	queryGroup: '3. Stammdaten'

	annotation PBI_ResultType = Table

expression Stammdaten_Basis = ```
		// KOMBINATIONS-ABFRAGE: referenziert nur andere Abfragen (Dataflow +
		// manuelle Werke), kein direkter Datenquellen-Zugriff -> Firewall-konform.
		// Stammdaten aus dem Dataflow + manuelle Werke, OHNE Snapshot-Spalten.
		// Eingefrorene CoC-Stände liegen in Stammdaten_CoC / Stammdaten_Historie.
		let
		    // Manuelle Werke ergänzen
		    MitManuellen = Table.Combine({Stammdaten_Dataflow, Man_Stamm}),

		    // HFM-Ableitungen (Logik unverändert übernommen)
		    HFM_Sektor = Table.TransformColumnTypes(Table.AddColumn(MitManuellen, "HFM_sektor", each
		        if [bezeichnung_verantwortungsbereich] = "Food Services" then
		            if [sektor] = "SE" then "HC"
		            else if [sektor] = "OV" then "BU"
		            else if [sektor] = "RE" then "HC"
		            else if [sektor] = "ED" then "HC"
		            else if [sektor] = "RT" then "BU"
		            else [sektor]
		        else if [bezeichnung_verantwortungsbereich] = "Support Service" then
		            if [sektor] = "OV" then "BU"
		            else [sektor]
		        else
		            [sektor]), {{"HFM_sektor", type text}}),
		    HFM_Bereich = Table.AddColumn(HFM_Sektor, "HFM_Bereich", each if [bezeichnung_verantwortungsbereich] = "Support Service" then "Support" else "Food"),
		    HFM_Sek_SE = Table.TransformColumnTypes(Table.AddColumn(HFM_Bereich, "HFM_Sek_SE", each
		        if [HFM_sektor] = "BU" then "SE11100"
		        else if [HFM_sektor] = "IN" then "SE12100"
		        else if [HFM_sektor] = "MT" then "SE11200"
		        else if [HFM_sektor] = "LE" then "SE41200"
		        else if [HFM_sektor] = "HC" then "SE39000"
		        else if [HFM_sektor] = "ST" then "SE42300"
		        else if [HFM_sektor] = "EV" then "SE42200"
		        else if [HFM_sektor] = "ED" then "SE22100"
		        else null), {{"HFM_Sek_SE", type text}}),

		    // Snapshot-Spalten gehören nicht mehr in die Stammdaten
		    Bereinigt = Table.RemoveColumns(HFM_Sek_SE, {"cause_of_change_BUD", "cause_of_change_RGF", "cause_of_change_R03"}, MissingField.Ignore)
		in
		    Bereinigt
		```
	lineageTag: dacd0e2a-6cb0-4861-a301-e0b39378eda9
	queryGroup: '3. Stammdaten'

	annotation PBI_ResultType = Table

expression Snapshot_BUD = fnStammdaten_Snapshot(Parameter_BUD_Stammdaten)
