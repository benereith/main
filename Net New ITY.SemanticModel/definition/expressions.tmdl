		  #"Höher gestufte Header" = Table.PromoteHeaders(#"Geänderter Spaltentyp", [PromoteAllScalars = true]),
		  #"Höher gestufte Header 1" = Table.PromoteHeaders(#"Höher gestufte Header", [PromoteAllScalars = true]),#"Entfernte Spalten" = Table.RemoveColumns(#"Höher gestufte Header 1",{"Auftragsart", "Column2", "", "Column4", "Column5", "Column6", "Column7"}),
		    #"Gefilterte Zeilen" = Table.SelectRows(#"Entfernte Spalten", each ([Geschäftsjahr] <> "Ergebnis")),
		    #"Geänderter Typ" = Table.TransformColumnTypes(#"Gefilterte Zeilen",{{"Werk", Int64.Type}, {"Werttyp", type text}, {"Version", type text}, {"EUR", type number}, {"Geschäftsjahr", Int64.Type}, {"Buchungsperiode", Int64.Type}}),
		    #"Umbenannte Spalten" = Table.RenameColumns(#"Geänderter Typ",{{"EUR", "Betrag"}}),
		    #"Gefilterte Zeilen1" = Table.SelectRows(#"Umbenannte Spalten", each [Werk] <> null and [Werk] <> ""),
		    Benutzerdefiniert1 = Table.AddColumn(#"Gefilterte Zeilen1", "Datum", each let
		            p = [Buchungsperiode],
		            y = [Geschäftsjahr],
