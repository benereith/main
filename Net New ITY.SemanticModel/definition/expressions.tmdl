expression Snapshot_R03 = fnStammdaten_Snapshot(Parameter_R03_Stammdaten)
	lineageTag: 9701f983-bd48-4340-82f6-2b509358a3a9
	queryGroup: '3. Stammdaten'

	annotation PBI_ResultType = Table

expression Stammdaten_CoC = ```
		// KOMBINATIONS-ABFRAGE: referenziert nur andere Abfragen (keine direkte
		// Datenquelle) -> Formula-Firewall-konform. Die Snapshot-Zugriffe liegen
		// in den Blatt-Abfragen Snapshot_BUD / Snapshot_RGF / Snapshot_R03.
		//
		// Cause-of-Change-Stand pro Betrieb und Szenario (langes Format).
		// Quelle je Szenario laut Szenario_Konfig: aktueller Stand ("live"/"live_fy")
		// oder eingefrorener Snapshot ("snapshot").
		// Manuelle Werke fehlen im Lakehouse-Export und werden aus Man_Stamm ergänzt.
		//
		// Neue Snapshot-Runde: hier in "SnapshotMap" die neue Blatt-Abfrage
		// unter ihrem Szenario-Kürzel ergänzen.
		let
		    SnapshotMap = [ BUD = Snapshot_BUD, ARO_RGF = Snapshot_RGF, R03 = Snapshot_R03 ],
		    Basis = Table.Buffer(Table.SelectColumns(Stammdaten_Basis, {"betrieb", "cause_of_change", "cause_of_change_fy"})),
		    Szenarien = Table.Distinct(Table.SelectColumns(Szenario_Konfig, {"Szenario", "CoC_Quelle", "CoC_Spalte_Adjustments"})),
		    ProSzenario = Table.AddColumn(Szenarien, "Daten", each
		        let
		            s = [Szenario],
		            q = [CoC_Quelle],
		            AdjSpalte = [CoC_Spalte_Adjustments],
		            LiveSpalte = if q = "live_fy" then "cause_of_change_fy" else "cause_of_change",
		            Live = Table.RenameColumns(Table.SelectColumns(Basis, {"betrieb", LiveSpalte}), {{LiveSpalte, "coc"}}),
		            Ergebnis =
		                if q = "snapshot" then
		                    let
		                        Snap = Record.Field(SnapshotMap, s),
		                        Manuelle = Table.RenameColumns(Table.SelectColumns(Man_Stamm, {"betrieb", AdjSpalte}), {{AdjSpalte, "coc"}}),
		                        NeueManuelle = Table.SelectRows(Manuelle, (zeile) => not List.Contains(Snap[betrieb], zeile[betrieb]))
		                    in
		                        Table.Combine({Snap, NeueManuelle})
		                else
		                    Live
		        in
		            Ergebnis),
		    Erweitert = Table.ExpandTableColumn(Table.SelectColumns(ProSzenario, {"Szenario", "Daten"}), "Daten", {"betrieb", "coc"}),
		    Typisiert = Table.TransformColumnTypes(Erweitert, {{"coc", Int64.Type}})
		in
		    Typisiert
		```
	lineageTag: fde90b40-e27f-4a8c-85df-cee2ce49de60
	queryGroup: '3. Stammdaten'

	annotation PBI_ResultType = Table

expression Stammdaten_Historie = ```
		// Zum jeweiligen Monatsabschluss eingefrorener Cause-of-Change-Stand
		// pro Betrieb und Buchungsperiode des laufenden Geschäftsjahres.
		// Konvention: Ein Stammdaten-Export im Monat m friert den Stand der
		// Vormonats-Periode ein (Export im November -> Periode 1 = Oktober).
		let
		    Quelle = Sql.Database(Lakehouse_Server, Lakehouse_Datenbank),
		    exports_md = Quelle{[Schema = "dbo", Item = "exports_md"]}[Data],
		    Typisiert = Table.TransformColumnTypes(exports_md, {{"update_ts", type date}}),
		    MitStichtag = Table.AddColumn(Typisiert, "Stichtag", each Date.AddMonths([update_ts], -1), type date),
		    MitPeriode = Table.AddColumn(MitStichtag, "Periode", each fnFiscal_DatumZuPeriode([Stichtag]), Int64.Type),
		    MitGJ = Table.AddColumn(MitPeriode, "Geschäftsjahr", each fnFiscal_DatumZuGJ([Stichtag]), Int64.Type),
		    NurAktuellesGJ = Table.SelectRows(MitGJ, each [Geschäftsjahr] = Aktuelles_Geschäftsjahr),
		    Auswahl = Table.SelectColumns(NurAktuellesGJ, {"betrieb", "Periode", "cause_of_change", "update_ts"}),
		    // Pro Betrieb und Periode gilt der jeweils letzte Export
		    Gruppiert = Table.Group(Auswahl, {"betrieb", "Periode"}, {{"coc_freeze", each Table.Max(_, "update_ts")[cause_of_change], type nullable Int64.Type}})
		in
		    Gruppiert
		```
	lineageTag: 39f82265-b572-40ea-b020-51b77c8f5c50
	queryGroup: '3. Stammdaten'

	annotation PBI_ResultType = Table

expression SAP_Revenues = ```
		let
		    Quelle = SharePoint.Contents("https://cpgplc.sharepoint.com/sites/GroupControlling/", [ApiVersion = 15]),
		    Navigation = Quelle{[Name = "Shared Documents"]}[Content],
		    #"Navigation 1" = Navigation{[Name = "Group Controlling"]}[Content],
		    #"Navigation 2" = #"Navigation 1"{[Name = "Net New ITY"]}[Content],
		    #"Navigation 3" = #"Navigation 2"{[Name = "02_Revenues"]}[Content],
		    #"Navigation 4" = #"Navigation 3"{[Name = "Revenues_SAP.xlsx"]}[Content],
		    Arbeitsmappe = Excel.Workbook(#"Navigation 4", null, true),
		    Blatt = Arbeitsmappe{[Item = "Revenues", Kind = "Sheet"]}[Data],
		    Spaltentypen = Table.TransformColumnTypes(Blatt, {{"Column1", type text}, {"Column3", type text}, {"Column8", type text}, {"Column9", type text}, {"Column10", type text}, {"Column11", type text}, {"Column12", type text}}, "de"),
		    Header1 = Table.PromoteHeaders(Spaltentypen, [PromoteAllScalars = true]),
		    Header2 = Table.PromoteHeaders(Header1, [PromoteAllScalars = true]),
		    OhneHilfsspalten = Table.RemoveColumns(Header2, {"Auftragsart", "Column2", "", "Column4", "Column5", "Column6", "Column7"}),
		    OhneErgebniszeilen = Table.SelectRows(OhneHilfsspalten, each ([Geschäftsjahr] <> "Ergebnis")),
		    Typisiert = Table.TransformColumnTypes(OhneErgebniszeilen, {{"Werk", Int64.Type}, {"Werttyp", type text}, {"Version", type text}, {"EUR", type number}, {"Geschäftsjahr", Int64.Type}, {"Buchungsperiode", Int64.Type}}),
		    Umbenannt = Table.RenameColumns(Typisiert, {{"EUR", "Betrag"}}),
		    OhneLeereWerke = Table.SelectRows(Umbenannt, each [Werk] <> null and [Werk] <> "")
		in
		    OhneLeereWerke
		```
	lineageTag: 2ecfe17d-cd77-4a79-958e-a1c69f41bb6f
	queryGroup: '4. Revenue-Quellen'

	annotation PBI_ResultType = Table

expression Man_Rev = ```
		// Manuelle Revenue-Adjustments. Diese Zeilen bringen ihren
		// Cause-of-Change-Stand pro Szenario explizit als Spalten mit.
		let
		    Quelle = SharePoint.Contents("https://cpgplc.sharepoint.com/sites/GroupControlling", [ApiVersion = 15]),
		    #"Shared Documents" = Quelle{[Name = "Shared Documents"]}[Content],
		    #"Group Controlling" = #"Shared Documents"{[Name = "Group Controlling"]}[Content],
		    #"Net New ITY" = #"Group Controlling"{[Name = "Net New ITY"]}[Content],
		    #"02_Revenues" = #"Net New ITY"{[Name = "02_Revenues"]}[Content],
		    Datei = #"02_Revenues"{[Name = "Manuelle_Adjustments.xlsx"]}[Content],
		    Arbeitsmappe = Excel.Workbook(Datei),
		    Blatt = Arbeitsmappe{[Item = "Adj_Revenues", Kind = "Sheet"]}[Data],
		    Header = Table.PromoteHeaders(Blatt, [PromoteAllScalars = true]),
		    Auswahl = Table.SelectColumns(Header, {"Werk", "Geschäftsjahr", "Buchungsperiode", "Werttyp", "Version", "Betrag", "cause_of_change", "cause_of_change_ny", "cause_of_change_BUD", "cause_of_change_RGF", "cause_of_change_fy", "cause_of_change_R03"}),
