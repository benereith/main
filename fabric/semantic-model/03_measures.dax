// =====================================================================
// Measures
//
// Teil A - Bestandsmeasures, 1:1 aus dem Altmodell uebernommen,
//          umgehaengt auf die neuen Phasing-Tabellen.
// Teil B - Leading KPIs. Basis sind die Aenderungsviews aus dem
//          Lakehouse (fct_opportunity_changes / fct_retention_changes),
//          die es ohne die Historisierung nicht gaebe.
// =====================================================================


// =====================================================================
// Teil A - Bestandsmeasures
// =====================================================================

// Nettoeffekt ueber beide Effektarten - eine Summe statt eines
// Measure-Paares, weil die Vorzeichen bereits im Phasing gesetzt sind.
Net ITY Effect = SUM ( fct_budget_effect[Budget_Value] )

// Die beiden Bestandteile als Filter auf derselben Tabelle.
ity_effect =
CALCULATE (
    [Net ITY Effect],
    fct_budget_effect[effect_type] = "New Business"
)

Lost ITY =
CALCULATE (
    [Net ITY Effect],
    fct_budget_effect[effect_type] = "Retention"
)

crm_ity = [ity_effect]

crm_ity_sply = CALCULATE ( [crm_ity], SAMEPERIODLASTYEAR ( dim_date[Datum] ) )

crm_ity_delta = [crm_ity] - [crm_ity_sply]

// Geschaeftsjahre nicht mehr hart codiert, sondern ueber den Filterkontext.
ity_effect_fy =
CALCULATE (
    [ity_effect],
    TREATAS ( VALUES ( dim_date[FY_Jahr] ), dim_date[FY_Jahr] )
)


// =====================================================================
// Teil B - Leading KPIs
// =====================================================================

// --- Pipeline-Bestand ------------------------------------------------

Pipeline ARO =
CALCULATE (
    SUM ( fct_opportunity[cgplc_revenuearo] ),
    fct_opportunity[statecodename] = "Offen"
)

Weighted Pipeline ARO =
CALCULATE (
    SUM ( fct_opportunity[weighted_aro] ),
    fct_opportunity[statecodename] = "Offen"
)

Opportunity Count =
CALCULATE (
    DISTINCTCOUNT ( fct_opportunity[opportunityid] ),
    fct_opportunity[statecodename] = "Offen"
)

// Deckungsgrad der gewichteten Pipeline gegen den Planwert.
// Werte deutlich unter 1 zeigen eine Zielluecke, bevor sie im Ist sichtbar wird.
Pipeline Coverage =
DIVIDE ( [Weighted Pipeline ARO], [90_Value] )


// --- Pipeline-Bewegung (nur mit Historisierung moeglich) -------------

// Volumen der Opportunities, die im gewaehlten Zeitraum neu entstanden sind.
Net New Pipeline =
CALCULATE (
    SUM ( fct_opportunity_changes[cgplc_revenuearo] ),
    fct_opportunity_changes[is_new] = TRUE ()
)

Net New Opportunity Count =
CALCULATE (
    DISTINCTCOUNT ( fct_opportunity_changes[opportunityid] ),
    fct_opportunity_changes[is_new] = TRUE ()
)

Net New Pipeline 30d =
CALCULATE (
    [Net New Pipeline],
    DATESINPERIOD ( dim_date[Datum], MAX ( dim_date[Datum] ), -30, DAY )
)

// Summe aller Wertveraenderungen an bestehenden Opportunities.
// Zeigt, ob die Pipeline organisch waechst oder nachtraeglich abgewertet wird.
Pipeline Value Movement =
CALCULATE (
    SUM ( fct_opportunity_changes[delta_revenuearo] ),
    fct_opportunity_changes[is_new] = FALSE ()
)

// Anzahl der Stage-Wechsel - Mass fuer die Bewegung in der Pipeline.
Stage Movements =
CALCULATE (
    COUNTROWS ( fct_opportunity_changes ),
    fct_opportunity_changes[stage_changed] = TRUE ()
)

// Summe der Verschiebungen des erwarteten Abschlussdatums in Tagen.
// Steigende Werte sind ein Fruehindikator fuer Planverfehlung.
Close Date Slippage Days =
CALCULATE (
    SUM ( fct_opportunity_changes[delta_closedate_days] ),
    fct_opportunity_changes[delta_closedate_days] > 0
)

Slipped Opportunities =
CALCULATE (
    DISTINCTCOUNT ( fct_opportunity_changes[opportunityid] ),
    fct_opportunity_changes[delta_closedate_days] > 0
)


// --- Qualitaet und Geschwindigkeit -----------------------------------

Won ARO =
CALCULATE (
    SUM ( fct_opportunity[cgplc_revenuearo] ),
    fct_opportunity[win_status] = "Won"
)

Lost ARO =
CALCULATE (
    SUM ( fct_opportunity[cgplc_revenuearo] ),
    fct_opportunity[statecodename] = "Verloren"
)

// Wertbasierte Win Rate. Der Vollextrakt macht sie erst moeglich -
// im Altmodell waren verlorene Opportunities herausgefiltert.
Win Rate Value = DIVIDE ( [Won ARO], [Won ARO] + [Lost ARO] )

Win Rate Count =
VAR _won =
    CALCULATE (
        DISTINCTCOUNT ( fct_opportunity[opportunityid] ),
        fct_opportunity[win_status] = "Won"
    )
VAR _lost =
    CALCULATE (
        DISTINCTCOUNT ( fct_opportunity[opportunityid] ),
        fct_opportunity[statecodename] = "Verloren"
    )
RETURN
    DIVIDE ( _won, _won + _lost )

Avg Sales Cycle Days =
CALCULATE (
    AVERAGE ( fct_opportunity[sales_cycle_days] ),
    fct_opportunity[win_status] = "Won"
)

// Opportunities, die seit mehr als 90 Tagen keinen Stage-Wechsel hatten.
// Klassischer Fruehindikator fuer nicht belastbare Pipeline.
Stale Pipeline ARO =
VAR _letzterStand = MAX ( fct_opportunity_changes[snapshot_date] )
RETURN
    CALCULATE (
        SUM ( fct_opportunity[cgplc_revenuearo] ),
        fct_opportunity[statecodename] = "Offen",
        FILTER (
            VALUES ( fct_opportunity[opportunityid] ),
            VAR _letzteAenderung =
                CALCULATE ( MAX ( fct_opportunity_changes[snapshot_date] ) )
            RETURN
                DATEDIFF ( _letzteAenderung, _letzterStand, DAY ) > 90
        )
    )


// --- Retention als Fruehindikator ------------------------------------

Retention Exposure ARO =
CALCULATE (
    SUM ( fct_retention[cgplc_lastfyrevenuearo] ),
    fct_retention[statuscodename] = "Aktiv"
)

At Risk ARO =
CALCULATE (
    SUM ( fct_retention[cgplc_lastfyrevenuearo] ),
    fct_retention[statuscodename] = "Aktiv",
    fct_retention[Ret_Status] IN { "At Risk", "Expected Loss", "Lost" }
)

At Risk Share = DIVIDE ( [At Risk ARO], [Retention Exposure ARO] )

// Vertraege mit anstehender Entscheidung - der operative Handlungsbedarf.
Decisions Due 90d =
CALCULATE (
    SUM ( fct_retention[cgplc_lastfyrevenuearo] ),
    fct_retention[statuscodename] = "Aktiv",
    fct_retention[days_to_decision] >= 0,
    fct_retention[days_to_decision] <= 90
)

// Veraenderung der Retention-Wahrscheinlichkeiten im Zeitraum.
// Negativ bedeutet: die Einschaetzung im CRM verschlechtert sich.
Retention Probability Movement =
CALCULATE (
    SUMX (
        fct_retention_changes,
        fct_retention_changes[delta_retentionprobability]
            * fct_retention_changes[cgplc_lastfyrevenuearo]
    ),
    fct_retention_changes[is_new] = FALSE ()
)

Newly At Risk ARO =
CALCULATE (
    SUM ( fct_retention_changes[cgplc_lastfyrevenuearo] ),
    fct_retention_changes[delta_retentionprobability] < 0
)


// --- Steuerung der manuellen Mappingpflege ---------------------------
// Das Mapping Opportunity -> SAP-Betrieb wird im Budget- und
// Forecast-Prozess von Hand gepflegt, weil die betroffenen Units noch
// nicht gewonnen sind. Diese Measures machen den Pflegestand messbar,
// damit eine Luecke vor dem Abschluss einer Runde auffaellt und nicht
// erst, wenn Effekte ohne Betrieb in der Auswertung stehen.

Unmapped Effect =
CALCULATE (
    [Net ITY Effect],
    FILTER ( VALUES ( fct_budget_effect[sap_unit] ), ISBLANK ( fct_budget_effect[sap_unit] ) )
)

Unmapped Opportunities =
CALCULATE (
    DISTINCTCOUNT ( fct_budget_effect[entity_id] ),
    fct_budget_effect[effect_type] = "New Business",
    FILTER ( VALUES ( fct_budget_effect[sap_unit] ), ISBLANK ( fct_budget_effect[sap_unit] ) )
)

// Anteil des Effekts, der noch keinem Betrieb zugeordnet ist.
Unmapped Share = DIVIDE ( ABS ( [Unmapped Effect] ), ABS ( [Net ITY Effect] ) )

// Effekt auf Units, die es in SAP noch nicht gibt - der eigentliche
// Net-New-Anteil. Kein Fehler, sondern die Kernaussage des Reports.
Planned Unit Effect =
CALCULATE ( [Net ITY Effect], dim_unit[unit_status] = "Geplant" )


// --- Zeitbezug -------------------------------------------------------
// Fuer Stichtagsanzeigen und Titel im Report. TODAY() waere hier UTC und
// zwischen Mitternacht und 02:00 Berliner Zeit einen Tag zu frueh.

Heute Berlin =
VAR _UtcJetzt = UTCNOW ()
VAR _Jahr = YEAR ( _UtcJetzt )
VAR _MaerzEnde = DATE ( _Jahr, 3, 31 )
VAR _OktoberEnde = DATE ( _Jahr, 10, 31 )
VAR _SommerzeitBeginn =
    _MaerzEnde - ( WEEKDAY ( _MaerzEnde, 1 ) - 1 ) + TIME ( 1, 0, 0 )
VAR _SommerzeitEnde =
    _OktoberEnde - ( WEEKDAY ( _OktoberEnde, 1 ) - 1 ) + TIME ( 1, 0, 0 )
VAR _Versatz =
    IF ( _UtcJetzt >= _SommerzeitBeginn && _UtcJetzt < _SommerzeitEnde, 2, 1 )
VAR _BerlinJetzt = _UtcJetzt + _Versatz / 24
RETURN
    DATE ( YEAR ( _BerlinJetzt ), MONTH ( _BerlinJetzt ), DAY ( _BerlinJetzt ) )

// Stand der Daten: juengster Snapshot, nicht der Zeitpunkt des Aufrufs.
Datenstand =
FORMAT ( MAX ( fct_opportunity[snapshot_date] ), "dd.MM.yyyy" )
