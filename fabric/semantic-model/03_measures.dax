// =====================================================================
// Measures
//
// Vollstaendig neu aufgebaut auf das neue Modell. Aufbau:
//   1. Vorzeichenkonvention - zwei Helfer, sonst nirgends ein Minus
//   2. Budgetwirkung        - Basis, Effektart, Nettoeffekt, Cluster
//   3. Leading KPIs         - Pipeline, Bewegung, Qualitaet, Retention
//   4. Betrieb              - Mappingpflege, Zeitbezug, Diagnose
//
// Grundsatz: alle Basiswerte sind POSITIVE Volumina. Vorzeichen
// entstehen ausschliesslich in [Netto Budgeteffekt], und zwar ueber
// die beiden Konventionsmeasures. Wer die Konvention aendern will,
// aendert genau eine Zahl - nicht verteilte Formeln.
// =====================================================================


// ---------------------------------------------------------------------
// Vorzeichenkonvention
// ---------------------------------------------------------------------

// Die einzige Stelle, an der die ITY-Konvention steht. Auf 1 setzen,
// wenn der ITY-Anteil positiv in den Nettoeffekt eingehen soll.
'Vorzeichen ITY' = -1

// Analog fuer die Retention. -1 = Verlust mindert den Nettoeffekt.
'Vorzeichen Retention' = -1


// ---------------------------------------------------------------------
// Budgetwirkung - Basis
// ---------------------------------------------------------------------

// Unterjaehriger Anteil, positiv. Die Phasengrenze steht je Zeile in
// Phasenwechsel - dem Ende des ersten Geschaeftsjahres der Zeile.
'ITY Volumen' =
SUMX (
    fct_budget_effect,
    IF (
        fct_budget_effect[Period_Date] <= fct_budget_effect[Phasenwechsel],
        fct_budget_effect[ITY_Value],
        0
    )
)

// Annualisierter Anteil, positiv.
'ARO Volumen' =
SUMX (
    fct_budget_effect,
    IF (
        fct_budget_effect[Period_Date] > fct_budget_effect[Phasenwechsel],
        fct_budget_effect[ARO_Value],
        0
    )
)

'Budget Volumen' = [ITY Volumen] + [ARO Volumen]


// ---------------------------------------------------------------------
// Budgetwirkung - nach Effektart
// ---------------------------------------------------------------------

'New Business ITY' = CALCULATE ( [ITY Volumen], fct_budget_effect[effect_type] = "New Business" )

'New Business ARO' = CALCULATE ( [ARO Volumen], fct_budget_effect[effect_type] = "New Business" )

'New Business Volumen' = [New Business ITY] + [New Business ARO]

// Gefaehrdetes Volumen, positiv. Das Vorzeichen setzt der Nettoeffekt.
'Retention Volumen' = CALCULATE ( [Budget Volumen], fct_budget_effect[effect_type] = "Retention" )


// ---------------------------------------------------------------------
// Budgetwirkung - Nettoeffekt
// ---------------------------------------------------------------------

// Der Nettoeffekt. Die Vorzeichen kommen ausschliesslich aus den beiden
// Konventionsmeasures - hier steht kein hart codiertes Minus.
'Netto Budgeteffekt' =
[New Business ARO]
    + [Vorzeichen ITY] * [New Business ITY]
    + [Vorzeichen Retention] * [Retention Volumen]

'Netto Budgeteffekt VJ' = CALCULATE ( [Netto Budgeteffekt], SAMEPERIODLASTYEAR ( dim_date[Datum] ) )

'Netto Budgeteffekt Delta' = [Netto Budgeteffekt] - [Netto Budgeteffekt VJ]


// ---------------------------------------------------------------------
// Clusterung Roll / ITY
// ---------------------------------------------------------------------

'Effekt Cluster Roll' = CALCULATE ( [Netto Budgeteffekt], fct_budget_effect[ity_cluster] = "Roll" )

'Effekt Cluster ITY' = CALCULATE ( [Netto Budgeteffekt], fct_budget_effect[ity_cluster] = "ITY" )

// Zeilen ausserhalb des Clusterfensters - sollten fachlich leer bleiben.
'Effekt ohne Cluster' =
CALCULATE (
    [Netto Budgeteffekt],
    FILTER (
        VALUES ( fct_budget_effect[ity_cluster] ),
        ISBLANK ( fct_budget_effect[ity_cluster] )
    )
)


// ---------------------------------------------------------------------
// Pipeline - Bestand
// ---------------------------------------------------------------------

'Pipeline ARO' =
CALCULATE (
    SUM ( fct_opportunity[cgplc_revenuearo] ),
    fct_opportunity[statecodename] = "Offen"
)

'Weighted Pipeline ARO' =
CALCULATE (
    SUM ( fct_opportunity[weighted_aro] ),
    fct_opportunity[statecodename] = "Offen"
)

'Opportunity Count' =
CALCULATE (
    DISTINCTCOUNT ( fct_opportunity[opportunityid] ),
    fct_opportunity[statecodename] = "Offen"
)


// ---------------------------------------------------------------------
// Pipeline - Bewegung (nur mit Historisierung)
// ---------------------------------------------------------------------

'Net New Pipeline' =
CALCULATE (
    SUM ( fct_opportunity_changes[cgplc_revenuearo] ),
    fct_opportunity_changes[is_new] = TRUE ()
)

'Net New Opportunity Count' =
CALCULATE (
    DISTINCTCOUNT ( fct_opportunity_changes[opportunityid] ),
    fct_opportunity_changes[is_new] = TRUE ()
)

'Net New Pipeline 30d' =
CALCULATE (
    [Net New Pipeline],
    DATESINPERIOD ( dim_date[Datum], MAX ( dim_date[Datum] ), -30, DAY )
)

// Wertveraenderung an bestehenden Opportunities - waechst die Pipeline
// organisch oder wird sie nachtraeglich abgewertet?
'Pipeline Value Movement' =
CALCULATE (
    SUM ( fct_opportunity_changes[delta_revenuearo] ),
    fct_opportunity_changes[is_new] = FALSE ()
)

'Stage Movements' =
CALCULATE (
    COUNTROWS ( fct_opportunity_changes ),
    fct_opportunity_changes[stage_changed] = TRUE ()
)

'Close Date Slippage Days' =
CALCULATE (
    SUM ( fct_opportunity_changes[delta_closedate_days] ),
    fct_opportunity_changes[delta_closedate_days] > 0
)

'Slipped Opportunities' =
CALCULATE (
    DISTINCTCOUNT ( fct_opportunity_changes[opportunityid] ),
    fct_opportunity_changes[delta_closedate_days] > 0
)


// ---------------------------------------------------------------------
// Qualitaet und Geschwindigkeit
// ---------------------------------------------------------------------

'Won ARO' =
CALCULATE (
    SUM ( fct_opportunity[cgplc_revenuearo] ),
    fct_opportunity[win_status] = "Won"
)

'Lost ARO' =
CALCULATE (
    SUM ( fct_opportunity[cgplc_revenuearo] ),
    fct_opportunity[statecodename] = "Verloren"
)

// Der Vollextrakt macht sie erst moeglich - im Altmodell waren die
// verlorenen Opportunities herausgefiltert.
'Win Rate Value' = DIVIDE ( [Won ARO], [Won ARO] + [Lost ARO] )

'Win Rate Count' =
VAR _won =
    CALCULATE (
        DISTINCTCOUNT ( fct_opportunity[opportunityid] ),
        fct_opportunity[win_status] = "Won"
    )
VAR _lost =
    CALCULATE (
        DISTINCTCOUNT ( fct_opportunity[opportunityid] ),
        fct_opportunity[statecodename] = "Verloren"
    )
RETURN
    DIVIDE ( _won, _won + _lost )

'Avg Sales Cycle Days' =
CALCULATE (
    AVERAGE ( fct_opportunity[sales_cycle_days] ),
    fct_opportunity[win_status] = "Won"
)

// Opportunities ohne Stage-Wechsel seit 90 Tagen - Fruehindikator fuer
// nicht belastbare Pipeline.
'Stale Pipeline ARO' =
VAR _letzterStand = MAX ( fct_opportunity_changes[snapshot_date] )
RETURN
    CALCULATE (
        SUM ( fct_opportunity[cgplc_revenuearo] ),
        fct_opportunity[statecodename] = "Offen",
        FILTER (
            VALUES ( fct_opportunity[opportunityid] ),
            VAR _letzteAenderung =
                CALCULATE ( MAX ( fct_opportunity_changes[snapshot_date] ) )
            RETURN
                DATEDIFF ( _letzteAenderung, _letzterStand, DAY ) > 90
        )
    )


// ---------------------------------------------------------------------
// Retention als Fruehindikator
// ---------------------------------------------------------------------

'Retention Exposure ARO' =
CALCULATE (
    SUM ( fct_retention[cgplc_lastfyrevenuearo] ),
    fct_retention[statuscodename] = "Aktiv"
)

'At Risk ARO' =
CALCULATE (
    SUM ( fct_retention[cgplc_lastfyrevenuearo] ),
    fct_retention[statuscodename] = "Aktiv",
    fct_retention[Ret_Status] IN { "At Risk", "Expected Loss", "Lost" }
)

'At Risk Share' = DIVIDE ( [At Risk ARO], [Retention Exposure ARO] )

'Decisions Due 90d' =
CALCULATE (
    SUM ( fct_retention[cgplc_lastfyrevenuearo] ),
    fct_retention[statuscodename] = "Aktiv",
    fct_retention[days_to_decision] >= 0,
    fct_retention[days_to_decision] <= 90
)

// Negativ bedeutet: die Einschaetzung im CRM verschlechtert sich.
'Retention Probability Movement' =
CALCULATE (
    SUMX (
        fct_retention_changes,
        fct_retention_changes[delta_retentionprobability]
            * fct_retention_changes[cgplc_lastfyrevenuearo]
    ),
    fct_retention_changes[is_new] = FALSE ()
)

'Newly At Risk ARO' =
CALCULATE (
    SUM ( fct_retention_changes[cgplc_lastfyrevenuearo] ),
    fct_retention_changes[delta_retentionprobability] < 0
)


// ---------------------------------------------------------------------
// Mappingpflege
// ---------------------------------------------------------------------

'Unmapped Effekt' =
CALCULATE (
    [Netto Budgeteffekt],
    FILTER (
        VALUES ( fct_budget_effect[sap_unit] ),
        ISBLANK ( fct_budget_effect[sap_unit] )
    )
)

'Unmapped Opportunities' =
CALCULATE (
    DISTINCTCOUNT ( fct_budget_effect[entity_id] ),
    fct_budget_effect[effect_type] = "New Business",
    FILTER (
        VALUES ( fct_budget_effect[sap_unit] ),
        ISBLANK ( fct_budget_effect[sap_unit] )
    )
)

'Unmapped Anteil' = DIVIDE ( ABS ( [Unmapped Effekt] ), ABS ( [Netto Budgeteffekt] ) )

// Der eigentliche Net-New-Anteil: Units, die es in SAP noch nicht gibt.
'Effekt geplante Units' = CALCULATE ( [Netto Budgeteffekt], dim_unit[unit_status] = "Geplant" )


// ---------------------------------------------------------------------
// Zeitbezug
// ---------------------------------------------------------------------

// TODAY() laeuft im Service in UTC und waere nachts einen Tag zu frueh.
'Heute Berlin' =
VAR _UtcJetzt = UTCNOW ()
VAR _Jahr = YEAR ( _UtcJetzt )
VAR _MaerzEnde = DATE ( _Jahr, 3, 31 )
VAR _OktoberEnde = DATE ( _Jahr, 10, 31 )
VAR _SommerzeitBeginn =
    _MaerzEnde - ( WEEKDAY ( _MaerzEnde, 1 ) - 1 ) + TIME ( 1, 0, 0 )
VAR _SommerzeitEnde =
    _OktoberEnde - ( WEEKDAY ( _OktoberEnde, 1 ) - 1 ) + TIME ( 1, 0, 0 )
VAR _Versatz =
    IF ( _UtcJetzt >= _SommerzeitBeginn && _UtcJetzt < _SommerzeitEnde, 2, 1 )
VAR _BerlinJetzt = _UtcJetzt + _Versatz / 24
RETURN
    DATE ( YEAR ( _BerlinJetzt ), MONTH ( _BerlinJetzt ), DAY ( _BerlinJetzt ) )

// Steht hier nicht das heutige Datum, ist die Ladestrecke stehen geblieben.
Datenstand = FORMAT ( MAX ( fct_opportunity[snapshot_date] ), "dd.MM.yyyy" )


// ---------------------------------------------------------------------
// Diagnose
// ---------------------------------------------------------------------

// Muss 1 sein. Mehr heisst: das Modell haengt an fct_opportunity statt
// an fct_opportunity_current - dann summiert alles ueber alle Tage.
'Diag Snapshots' = DISTINCTCOUNT ( fct_opportunity[snapshot_date] )

// Muss 1,00 sein. Groesser heisst doppelte Zeilen je Opportunity.
'Diag Fanout' =
DIVIDE (
    COUNTROWS ( fct_opportunity ),
    DISTINCTCOUNT ( fct_opportunity[opportunityid] )
)

// Muss <= 1 sein. Bei 100 ist cgplc_win nicht auf eine Quote normalisiert.
'Diag Max Win' = MAX ( fct_opportunity[cgplc_win] )

'Diag Opps gesamt' = DISTINCTCOUNT ( fct_opportunity[opportunityid] )

// Deutlich kleiner als Diag Opps gesamt - sonst greifen die Filter nicht.
'Diag Opps in Phasierung' = DISTINCTCOUNT ( fct_opp_phasing[opportunityid] )
