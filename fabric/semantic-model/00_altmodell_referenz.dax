// =====================================================================
// REFERENZ: 1:1-Nachbau des Altmodells
//
// Zweck: eine Basis, gegen die sich abstimmen laesst. Diese Datei
// interpretiert NICHTS. Sie bildet die Power-Query-Logik aus
// fct_opp / fct_retention Schritt fuer Schritt in DAX ab, inklusive
// aller Vorzeichen, Filter und hart codierten Datumsgrenzen.
//
// Erst wenn diese Werte gegen den Altbericht stimmen, ist eine
// fachliche Aenderung sinnvoll - vorher weiss niemand, ob eine
// Abweichung aus der Logik oder aus der Migration kommt.
//
// Die vier Parameter des Altmodells, hier bewusst hart codiert:
//   Est_Close_Date_A   = 01.10.2025
//   Est_Close_Date_E   = 30.09.2026
//   Est_Opening_Date_A = 01.10.2026
//   Est_Opening_Date_E = 30.09.2027
// =====================================================================


// ---------------------------------------------------------------------
// alt_opp_phasing  <-  fct_opp aus dem Altmodell
// ---------------------------------------------------------------------
alt_opp_phasing =
VAR _CloseA = DATE ( 2025, 10, 1 )
VAR _CloseE = DATE ( 2026, 9, 30 )
VAR _OpeningA = DATE ( 2026, 10, 1 )
VAR _OpeningE = DATE ( 2027, 9, 30 )
// Horizont wie List.Generate: bis 30.09.2027, Monatsschritte.
VAR _Horizont =
    SELECTCOLUMNS (
        GENERATESERIES ( 0, 47, 1 ),
        "Period_Date", EDATE ( DATE ( 2024, 10, 1 ), [Value] )
    )
// Gefilterte Zeilen 2 / Gefilterte Zeilen / Gefilterte Zeilen 1 / 3
VAR _Basis =
    FILTER (
        fct_opportunity,
        ( fct_opportunity[cgplc_openingdate] >= _CloseA )
            && ( fct_opportunity[estimatedclosedate] >= _CloseA )
            && fct_opportunity[statecodename] <> "Verloren"
            && NOT (
                fct_opportunity[cgplc_salesstagename]
                    IN { "Nobid", "Turndown/Lost", "Universe" }
            )
            && NOT ISBLANK ( fct_opportunity[cgplc_openingdate] )
    )
VAR _MitEckdaten =
    ADDCOLUMNS (
        _Basis,
        "@StartDate",
            DATE (
                YEAR ( fct_opportunity[cgplc_openingdate] ),
                MONTH ( fct_opportunity[cgplc_openingdate] ),
                1
            ),
        "@FirstFYEnd",
            DATE ( YEAR ( EDATE ( fct_opportunity[cgplc_openingdate], -9 ) ) + 1, 9, 30 ),
        "@WeightedAro", fct_opportunity[cgplc_revenuearo] * fct_opportunity[cgplc_win],
        "@WeightedIty", fct_opportunity[cgplc_revenueity] * fct_opportunity[cgplc_win]
    )
VAR _MitLaufzeit =
    ADDCOLUMNS (
        _MitEckdaten,
        "@ITY_Months",
            ( YEAR ( [@FirstFYEnd] ) - YEAR ( [@StartDate] ) ) * 12
                + MONTH ( [@FirstFYEnd] ) - MONTH ( [@StartDate] ) + 1
    )
VAR _MitWerten =
    ADDCOLUMNS (
        _MitLaufzeit,
        "@ITY_Value",
            IF (
                ISBLANK ( [@WeightedIty] ) || [@WeightedIty] = 0,
                0,
                DIVIDE ( [@WeightedIty], [@ITY_Months] )
            ),
        "@ARO_Value",
            IF (
                ISBLANK ( [@WeightedAro] ) || [@WeightedAro] = 0,
                0,
                DIVIDE ( [@WeightedAro], 12 )
            )
    )
VAR _Expandiert =
    FILTER (
        GENERATE ( _MitWerten, _Horizont ),
        [Period_Date] >= [@StartDate] && [Period_Date] <= _OpeningE
    )
RETURN
    SELECTCOLUMNS (
        _Expandiert,
        "opportunityid", fct_opportunity[opportunityid],
        "Period_Date", [Period_Date],
        "Calc_StartDate", [@StartDate],
        "Calc_FirstFYEnd", [@FirstFYEnd],
        "Calc_ITY_Months", [@ITY_Months],
        "Calc_ITY_Value", [@ITY_Value],
        "Calc_ARO_Value", [@ARO_Value],
        // Add_FinalValue - woertlich aus dem Altmodell
        "Budget_Value",
            IF ( [Period_Date] <= _CloseE, [@ITY_Value] * -1, [@ARO_Value] ),
        // ity_cluster - woertlich, inklusive der Originalschreibweise
        "ity_cluster",
            SWITCH (
                TRUE (),
                fct_opportunity[estimatedclosedate] <= _CloseE, "unknown Roll",
                fct_opportunity[estimatedclosedate] >= _OpeningA
                    && fct_opportunity[estimatedclosedate] <= _OpeningE, "unkown ITY",
                BLANK ()
            )
    )


// ---------------------------------------------------------------------
// alt_retention_phasing  <-  fct_retention aus dem Altmodell
// ---------------------------------------------------------------------
alt_retention_phasing =
VAR _CloseA = DATE ( 2025, 10, 1 )
VAR _CloseE = DATE ( 2026, 9, 30 )
VAR _OpeningA = DATE ( 2026, 10, 1 )
VAR _OpeningE = DATE ( 2027, 9, 30 )
VAR _Horizont =
    SELECTCOLUMNS (
        GENERATESERIES ( 0, 47, 1 ),
        "Period_Date", EDATE ( DATE ( 2024, 10, 1 ), [Value] )
    )
VAR _Basis =
    ADDCOLUMNS (
        FILTER ( fct_retention, fct_retention[statuscodename] = "Aktiv" ),
        // Adj_Enddate
        "@EndDateRaw",
            IF (
                NOT ISBLANK ( fct_retention[cgplc_contractenddate] ),
                fct_retention[cgplc_contractenddate],
                EDATE ( fct_retention[cgplc_decisiondate], 3 )
            )
    )
VAR _Gefiltert =
    FILTER (
        _Basis,
        NOT ISBLANK ( [@EndDateRaw] )
            && [@EndDateRaw] >= _CloseA
            && [@EndDateRaw] <= _OpeningE
    )
VAR _MitEckdaten =
    ADDCOLUMNS (
        _Gefiltert,
        "@EndDate",
            EDATE ( DATE ( YEAR ( [@EndDateRaw] ), MONTH ( [@EndDateRaw] ), 1 ), 1 ),
        "@FirstFYEnd",
            DATE ( YEAR ( EDATE ( [@EndDateRaw], -9 ) ) + 1, 9, 30 ),
        "@WeightedLyAro",
            fct_retention[cgplc_lastfyrevenuearo]
                * ( 1 - fct_retention[cgplc_retentionprobability] )
    )
VAR _MitLaufzeit =
    ADDCOLUMNS (
        _MitEckdaten,
        "@ITY_Months",
            ( YEAR ( [@FirstFYEnd] ) - YEAR ( [@EndDate] ) ) * 12
                + MONTH ( [@FirstFYEnd] ) - MONTH ( [@EndDate] ) + 1
    )
VAR _MitWerten =
    ADDCOLUMNS (
        _MitLaufzeit,
        // Multiplikationsspalte: Calc_ARO_Value * -1
        "@ARO_Value",
            IF (
                ISBLANK ( [@WeightedLyAro] ) || [@WeightedLyAro] = 0,
                0,
                DIVIDE ( [@WeightedLyAro], 12 )
            ) * -1
    )
// List.FirstN(..., 12) - maximal 12 Perioden, gedeckelt auf 30.09.2027
VAR _Expandiert =
    FILTER (
        GENERATE ( _MitWerten, _Horizont ),
        [Period_Date] >= [@EndDate]
            && [Period_Date] <= EDATE ( [@EndDate], 11 )
            && [Period_Date] <= _OpeningE
    )
RETURN
    SELECTCOLUMNS (
        _Expandiert,
        "cgplc_cgcontractid", fct_retention[cgplc_cgcontractid],
        "cgplc_sapid", fct_retention[cgplc_sapid],
        "Period_Date", [Period_Date],
        "Calc_EndDate", [@EndDate],
        "Calc_FirstFYEnd", [@FirstFYEnd],
        "Calc_ITY_Months", [@ITY_Months],
        "weighted_ly_aro", [@WeightedLyAro],
        "Calc_ARO_Value", [@ARO_Value],
        "ity_cluster",
            SWITCH (
                TRUE (),
                [@EndDateRaw] <= _CloseE, "unknown Roll",
                [@EndDateRaw] >= _OpeningA, "unknown ITY",
                BLANK ()
            )
    )


// ---------------------------------------------------------------------
// Measures - woertlich aus 0_Measuretabelle des Altmodells
// ---------------------------------------------------------------------

alt_ity_effect = SUM ( alt_opp_phasing[Budget_Value] )

alt_ity_effect_25_26 =
CALCULATE ( SUM ( alt_opp_phasing[Budget_Value] ), dim_date[FY_Jahr] = "FY2025/26" )

alt_ity_effect_26_27 =
CALCULATE ( SUM ( alt_opp_phasing[Budget_Value] ), dim_date[FY_Jahr] = "FY2026/27" )

alt_Lost_ITY = SUM ( alt_retention_phasing[Calc_ARO_Value] )
