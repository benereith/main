// =====================================================================
// ITY-Phasing als berechnete Tabellen im Semantic Model
//
// Ersetzt 1:1 die Monats-Expansion, die bisher in Power Query lief
// (List.Generate + Table.ExpandListColumn in fct_opp / fct_retention).
// Der Dataflow liefert jetzt eine Zeile je Opportunity bzw. Contract,
// die Aufloesung auf Monatsperioden passiert hier.
//
// Vorzeichenkonvention aus dem Altmodell beibehalten:
//   ITY-Phase  -> negativ (Effekt gegen das laufende Geschaeftsjahr)
//   ARO-Phase  -> positiv
//   Retention  -> durchgaengig negativ (Verlustwirkung)
//
// Geschaeftsjahr: 1. Oktober bis 30. September.
// Horizont und ITY-Cutoff werden aus dim_date abgeleitet, nicht mehr
// hart codiert - dim_date ist die einzige Stelle, an der der
// Betrachtungszeitraum gepflegt wird.
// =====================================================================


// ---------------------------------------------------------------------
// fct_opp_phasing
// Grain: 1 Zeile je (opportunityid, Period_Date)
// ---------------------------------------------------------------------
fct_opp_phasing =
VAR _Horizont =
    DISTINCT (
        SELECTCOLUMNS (
            dim_date,
            "Period_Date", DATE ( YEAR ( dim_date[Datum] ), MONTH ( dim_date[Datum] ), 1 )
        )
    )
// Ende des ersten Geschaeftsjahres im Betrachtungszeitraum.
// Bis hierhin gilt der ITY-Wert, danach greift der ARO-Wert.
VAR _ITY_Cutoff =
    DATE ( YEAR ( EDATE ( MIN ( dim_date[Datum] ), -9 ) ) + 1, 9, 30 )
// Nur Opportunities, die in die Budgetwirkung eingehen.
// Der Vollextrakt im Lakehouse bleibt unangetastet - diese Einschraenkung
// gilt ausschliesslich fuer die Budget-Phasierung.
VAR _Basis =
    FILTER (
        fct_opportunity,
        NOT ISBLANK ( fct_opportunity[cgplc_openingdate] )
            && fct_opportunity[statecodename] <> "Verloren"
            && NOT (
                fct_opportunity[cgplc_salesstagename]
                    IN { "Nobid", "Turndown/Lost", "Universe" }
            )
    )
VAR _MitEckdaten =
    ADDCOLUMNS (
        _Basis,
        // Start = 1. des Monats des Opening Date
        "@StartDate",
            DATE (
                YEAR ( fct_opportunity[cgplc_openingdate] ),
                MONTH ( fct_opportunity[cgplc_openingdate] ),
                1
            ),
        // Ende des ersten Geschaeftsjahres dieser Opportunity
        "@FirstFYEnd",
            DATE ( YEAR ( EDATE ( fct_opportunity[cgplc_openingdate], -9 ) ) + 1, 9, 30 ),
        "@WeightedAro", fct_opportunity[cgplc_revenuearo] * fct_opportunity[cgplc_win],
        "@WeightedIty", fct_opportunity[cgplc_revenueity] * fct_opportunity[cgplc_win],
        // Konforme Achse zur Retention: der SAP-Betrieb.
        // Primaer die gepflegte Mappingtabelle, ersatzweise die CRM-eigene
        // Bruecke Opportunity -> Contract -> SAP-ID.
        "@SapUnit",
            COALESCE (
                LOOKUPVALUE (
                    map_opportunity_unit[sap_unit],
                    map_opportunity_unit[opportunityid], fct_opportunity[opportunityid]
                ),
                LOOKUPVALUE (
                    fct_retention[cgplc_sapid],
                    fct_retention[cgplc_cgcontractid], fct_opportunity[cgplc_contractid]
                )
            )
    )
VAR _MitLaufzeit =
    ADDCOLUMNS (
        _MitEckdaten,
        // Laenge der ITY-Phase in Monaten, inklusive Start- und Endmonat
        "@ITY_Months",
            ( YEAR ( [@FirstFYEnd] ) - YEAR ( [@StartDate] ) ) * 12
                + MONTH ( [@FirstFYEnd] ) - MONTH ( [@StartDate] ) + 1
    )
VAR _MitWerten =
    ADDCOLUMNS (
        _MitLaufzeit,
        "@ITY_Value", DIVIDE ( [@WeightedIty], [@ITY_Months], 0 ),
        "@ARO_Value", DIVIDE ( [@WeightedAro], 12, 0 )
    )
VAR _Expandiert =
    FILTER (
        GENERATE ( _MitWerten, _Horizont ),
        [Period_Date] >= [@StartDate]
    )
RETURN
    SELECTCOLUMNS (
        _Expandiert,
        "opportunityid", fct_opportunity[opportunityid],
        "sap_unit", [@SapUnit],
        "Period_Date", [Period_Date],
        "Calc_StartDate", [@StartDate],
        "Calc_FirstFYEnd", [@FirstFYEnd],
        "Calc_ITY_Months", [@ITY_Months],
        "Calc_ITY_Value", [@ITY_Value],
        "Calc_ARO_Value", [@ARO_Value],
        "Budget_Value",
            IF ( [Period_Date] <= _ITY_Cutoff, [@ITY_Value] * -1, [@ARO_Value] ),
        "Phase", IF ( [Period_Date] <= _ITY_Cutoff, "ITY", "ARO" )
    )


// ---------------------------------------------------------------------
// fct_retention_phasing
// Grain: 1 Zeile je (cgplc_cgcontractid, Period_Date)
// Maximal 12 Perioden ab dem Monat nach Vertragsende.
// ---------------------------------------------------------------------
fct_retention_phasing =
VAR _Horizont =
    DISTINCT (
        SELECTCOLUMNS (
            dim_date,
            "Period_Date", DATE ( YEAR ( dim_date[Datum] ), MONTH ( dim_date[Datum] ), 1 )
        )
    )
// Vertragsende ersatzweise aus dem Entscheidungsdatum ableiten,
// wenn im CRM kein Enddatum gepflegt ist (Logik aus dem Altmodell).
VAR _Basis =
    ADDCOLUMNS (
        FILTER ( fct_retention, fct_retention[statuscodename] = "Aktiv" ),
        "@EndDateRaw",
            IF (
                NOT ISBLANK ( fct_retention[cgplc_contractenddate] ),
                fct_retention[cgplc_contractenddate],
                EDATE ( fct_retention[cgplc_decisiondate], 3 )
            )
    )
VAR _MitEckdaten =
    ADDCOLUMNS (
        FILTER ( _Basis, NOT ISBLANK ( [@EndDateRaw] ) ),
        // Wirkung beginnt im Monat NACH dem Vertragsende
        "@EndDate",
            EDATE ( DATE ( YEAR ( [@EndDateRaw] ), MONTH ( [@EndDateRaw] ), 1 ), 1 ),
        "@FirstFYEnd",
            DATE ( YEAR ( EDATE ( [@EndDateRaw], -9 ) ) + 1, 9, 30 ),
        "@WeightedLyAro",
            fct_retention[cgplc_lastfyrevenuearo]
                * ( 1 - COALESCE ( fct_retention[cgplc_retentionprobability], 0 ) )
    )
VAR _MitLaufzeit =
    ADDCOLUMNS (
        _MitEckdaten,
        "@ITY_Months",
            ( YEAR ( [@FirstFYEnd] ) - YEAR ( [@EndDate] ) ) * 12
                + MONTH ( [@FirstFYEnd] ) - MONTH ( [@EndDate] ) + 1
    )
VAR _MitWerten =
    ADDCOLUMNS (
        _MitLaufzeit,
        "@ARO_Value", DIVIDE ( [@WeightedLyAro], 12, 0 ) * -1
    )
VAR _Expandiert =
    FILTER (
        GENERATE ( _MitWerten, _Horizont ),
        [Period_Date] >= [@EndDate]
            && [Period_Date] <= EDATE ( [@EndDate], 11 )
    )
RETURN
    SELECTCOLUMNS (
        _Expandiert,
        "cgplc_cgcontractid", fct_retention[cgplc_cgcontractid],
        "sap_unit", fct_retention[cgplc_sapid],
        "Period_Date", [Period_Date],
        "Calc_EndDate", [@EndDate],
        "Calc_FirstFYEnd", [@FirstFYEnd],
        "Calc_ITY_Months", [@ITY_Months],
        "weighted_ly_aro", [@WeightedLyAro],
        "Calc_ARO_Value", [@ARO_Value]
    )


// ---------------------------------------------------------------------
// fct_budget_effect
// Grain: 1 Zeile je (effect_type, entity_id, Period_Date)
//
// Harmonisierung der beiden Phasing-Tabellen auf ihre gemeinsame Achse:
// Periode und SAP-Betrieb. Nur hier ist die Vereinigung fachlich korrekt -
// die Quelltabellen bleiben getrennt, weil Opportunity und Contract
// unterschiedliche Geschaeftsobjekte mit disjunkten Attributen sind.
//
// Vorzeichen sind bereits in den Phasing-Tabellen gesetzt, eine Summe
// ueber diese Tabelle ist damit direkt der Nettoeffekt.
// ---------------------------------------------------------------------
fct_budget_effect =
UNION (
    SELECTCOLUMNS (
        fct_opp_phasing,
        "effect_type", "New Business",
        "entity_id", fct_opp_phasing[opportunityid],
        "sap_unit", fct_opp_phasing[sap_unit],
        "Period_Date", fct_opp_phasing[Period_Date],
        "Phase", fct_opp_phasing[Phase],
        "Budget_Value", fct_opp_phasing[Budget_Value]
    ),
    SELECTCOLUMNS (
        fct_retention_phasing,
        "effect_type", "Retention",
        "entity_id", fct_retention_phasing[cgplc_cgcontractid],
        "sap_unit", fct_retention_phasing[sap_unit],
        "Period_Date", fct_retention_phasing[Period_Date],
        "Phase", "Retention",
        "Budget_Value", fct_retention_phasing[Calc_ARO_Value]
    )
)
