// =====================================================================
// ITY-Phasing als berechnete Tabellen im Semantic Model
//
// Ersetzt die Monats-Expansion, die bisher in Power Query lief
// (List.Generate + Table.ExpandListColumn in fct_opp / fct_retention).
// Der Dataflow liefert eine Zeile je Opportunity bzw. Contract, die
// Aufloesung auf Monatsperioden passiert hier.
//
// GRUNDSATZ: Die Tabellen speichern nur POSITIVE Betraege. Welcher je
// Periode gilt, entscheidet die Spalte Phasenwechsel - die Grenze
// zwischen ITY- und ARO-Phase der jeweiligen Zeile. Das Vorzeichen
// setzt ausschliesslich das Measure.
//
// Wichtig: Das Minus vor dem ITY-Betrag gehoert in die Roll- bzw.
// Delta-Betrachtung, nicht in den ITY-Wert selbst. Im Altmodell steckte
// beides zusammen in Budget_Value, weshalb sich der ITY-Wert dort nie
// fuer sich betrachten liess. Getrennt gibt es zwei saubere Sichten:
// die absoluten Werte (positiv) und die Bruecke ARO minus ITY.
//
// Die Grenze aus dem Filterkontext abzuleiten waere der falsche Weg
// zurueck: dann wird das jeweils gefilterte Jahr komplett zur ITY-Phase
// und damit durchgaengig negativ. Richtig ist die Grenze je Zeile - das
// Ende des ersten Geschaeftsjahres DIESER Opportunity. Damit zeigt jedes
// Jahr genau die Mischung, die ihm zusteht: die ITY-Anteile der in ihm
// eroeffneten Opportunities und die ARO-Anteile der frueheren.
//
// Geschaeftsjahr: 1. Oktober bis 30. September.
// Horizont, ITY-Grenze und Clustergrenzen leiten sich aus dim_date ab.
// =====================================================================


// ---------------------------------------------------------------------
// fct_opp_phasing
// Grain: 1 Zeile je (opportunityid, Period_Date)
// ---------------------------------------------------------------------
fct_opp_phasing =
VAR _Horizont =
    DISTINCT (
        SELECTCOLUMNS (
            dim_date,
            "Period_Date", DATE ( YEAR ( dim_date[Datum] ), MONTH ( dim_date[Datum] ), 1 )
        )
    )
// Untergrenze des Betrachtungszeitraums - im Altmodell Est_Close_Date_A.
VAR _Fenster_Ab = MIN ( dim_date[Datum] )
// Ende des Basisjahres (Est_Close_Date_E) und des Folgejahres
// (Est_Opening_Date_E). Nur fuer die Clusterung, nicht fuers Vorzeichen.
VAR _BasisFY_Ende = DATE ( YEAR ( EDATE ( _Fenster_Ab, -9 ) ) + 1, 9, 30 )
VAR _FolgeFY_Ende = DATE ( YEAR ( _BasisFY_Ende ) + 1, 9, 30 )
// Nur Opportunities, die in die Budgetwirkung eingehen.
// Der Vollextrakt im Lakehouse bleibt unangetastet.
//
// Die beiden Datumsuntergrenzen sind zwingend: der Extrakt zieht bewusst
// OHNE Datumsfilter, die Faktentabelle enthaelt also auch Opportunities
// aus abgeschlossenen Jahren. Ohne sie erzeugt jede davon volle
// Budgetwirkung ueber den gesamten Horizont.
VAR _Basis =
    FILTER (
        fct_opportunity,
        NOT ISBLANK ( fct_opportunity[cgplc_openingdate] )
            && NOT ISBLANK ( fct_opportunity[estimatedclosedate] )
            && fct_opportunity[cgplc_openingdate] >= _Fenster_Ab
            && fct_opportunity[estimatedclosedate] >= _Fenster_Ab
            && fct_opportunity[statecodename] <> "Verloren"
            && NOT (
                fct_opportunity[cgplc_salesstagename]
                    IN { "Nobid", "Turndown/Lost", "Universe" }
            )
    )
VAR _MitEckdaten =
    ADDCOLUMNS (
        _Basis,
        // Start = 1. des Monats des Opening Date
        "@StartDate",
            DATE (
                YEAR ( fct_opportunity[cgplc_openingdate] ),
                MONTH ( fct_opportunity[cgplc_openingdate] ),
                1
            ),
        // Ende des ersten Geschaeftsjahres dieser Opportunity
        "@FirstFYEnd",
            DATE ( YEAR ( EDATE ( fct_opportunity[cgplc_openingdate], -9 ) ) + 1, 9, 30 ),
        "@WeightedAro", fct_opportunity[cgplc_revenuearo] * fct_opportunity[cgplc_win],
        "@WeightedIty", fct_opportunity[cgplc_revenueity] * fct_opportunity[cgplc_win],
        // Konforme Achse zur Retention: der SAP-Betrieb.
        "@SapUnit",
            COALESCE (
                LOOKUPVALUE (
                    map_opportunity_unit[sap_unit],
                    map_opportunity_unit[opportunityid], fct_opportunity[opportunityid]
                ),
                LOOKUPVALUE (
                    fct_retention[cgplc_sapid],
                    fct_retention[cgplc_cgcontractid], fct_opportunity[cgplc_contractid]
                )
            )
    )
VAR _MitLaufzeit =
    ADDCOLUMNS (
        _MitEckdaten,
        // Laenge der ITY-Phase in Monaten, inklusive Start- und Endmonat
        "@ITY_Months",
            ( YEAR ( [@FirstFYEnd] ) - YEAR ( [@StartDate] ) ) * 12
                + MONTH ( [@FirstFYEnd] ) - MONTH ( [@StartDate] ) + 1
    )
VAR _MitWerten =
    ADDCOLUMNS (
        _MitLaufzeit,
        "@ITY_Value", DIVIDE ( [@WeightedIty], [@ITY_Months], 0 ),
        "@ARO_Value", DIVIDE ( [@WeightedAro], 12, 0 )
    )
VAR _Expandiert =
    FILTER ( GENERATE ( _MitWerten, _Horizont ), [Period_Date] >= [@StartDate] )
RETURN
    SELECTCOLUMNS (
        _Expandiert,
        "opportunityid", fct_opportunity[opportunityid],
        "sap_unit", [@SapUnit],
        "Period_Date", [Period_Date],
        // Stichtag der Clusterung: wann die Opportunity abschliesst.
        "Referenzdatum", fct_opportunity[estimatedclosedate],
        // Roll  = schliesst im Basisjahr, wirkt als Rolleffekt ins Folgejahr
        // ITY   = schliesst im Folgejahr, wirkt dort unterjaehrig
        "ity_cluster",
            SWITCH (
                TRUE (),
                fct_opportunity[estimatedclosedate] <= _BasisFY_Ende, "Roll",
                fct_opportunity[estimatedclosedate] <= _FolgeFY_Ende, "ITY",
                BLANK ()
            ),
        "Calc_ITY_Months", [@ITY_Months],
        // Grenze zwischen ITY- und ARO-Phase DIESER Opportunity.
        // Bewusst zeilenbezogen und nicht aus dem Filterkontext: sonst
        // wird jedes gefilterte Jahr komplett zur ITY-Phase und damit
        // durchgaengig negativ.
        "Phasenwechsel", [@FirstFYEnd],
        // Beide Betraege vorzeichenlos - das Measure entscheidet.
        "ITY_Value", [@ITY_Value],
        "ARO_Value", [@ARO_Value]
    )


// ---------------------------------------------------------------------
// fct_retention_phasing
// Grain: 1 Zeile je (cgplc_cgcontractid, Period_Date)
// Maximal 12 Perioden ab dem Monat nach Vertragsende.
//
// Die Retention kennt keine ITY/ARO-Trennung - ein verlorener Vertrag
// wirkt in jeder Periode gleich. Beide Wertspalten tragen deshalb
// denselben positiven Betrag; das Vorzeichen setzt das Measure.
// ---------------------------------------------------------------------
fct_retention_phasing =
VAR _Horizont =
    DISTINCT (
        SELECTCOLUMNS (
            dim_date,
            "Period_Date", DATE ( YEAR ( dim_date[Datum] ), MONTH ( dim_date[Datum] ), 1 )
        )
    )
VAR _Fenster_Ab = MIN ( dim_date[Datum] )
VAR _BasisFY_Ende = DATE ( YEAR ( EDATE ( _Fenster_Ab, -9 ) ) + 1, 9, 30 )
VAR _FolgeFY_Ende = DATE ( YEAR ( _BasisFY_Ende ) + 1, 9, 30 )
// Vertragsende ersatzweise aus dem Entscheidungsdatum ableiten,
// wenn im CRM kein Enddatum gepflegt ist (Logik aus dem Altmodell).
VAR _Basis =
    ADDCOLUMNS (
        FILTER ( fct_retention, fct_retention[statuscodename] = "Aktiv" ),
        "@EndDateRaw",
            IF (
                NOT ISBLANK ( fct_retention[cgplc_contractenddate] ),
                fct_retention[cgplc_contractenddate],
                EDATE ( fct_retention[cgplc_decisiondate], 3 )
            )
    )
VAR _MitEckdaten =
    ADDCOLUMNS (
        FILTER (
            _Basis,
            NOT ISBLANK ( [@EndDateRaw] ) && [@EndDateRaw] >= _Fenster_Ab
        ),
        // Wirkung beginnt im Monat NACH dem Vertragsende
        "@EndDate",
            EDATE ( DATE ( YEAR ( [@EndDateRaw] ), MONTH ( [@EndDateRaw] ), 1 ), 1 ),
        "@FirstFYEnd",
            DATE ( YEAR ( EDATE ( [@EndDateRaw], -9 ) ) + 1, 9, 30 ),
        "@WeightedLyAro",
            fct_retention[cgplc_lastfyrevenuearo]
                * ( 1 - COALESCE ( fct_retention[cgplc_retentionprobability], 0 ) )
    )
VAR _MitWerten =
    ADDCOLUMNS ( _MitEckdaten, "@Monatswert", DIVIDE ( [@WeightedLyAro], 12, 0 ) )
VAR _Expandiert =
    FILTER (
        GENERATE ( _MitWerten, _Horizont ),
        [Period_Date] >= [@EndDate] && [Period_Date] <= EDATE ( [@EndDate], 11 )
    )
RETURN
    SELECTCOLUMNS (
        _Expandiert,
        "cgplc_cgcontractid", fct_retention[cgplc_cgcontractid],
        "sap_unit", fct_retention[cgplc_sapid],
        "Period_Date", [Period_Date],
        "Referenzdatum", [@EndDateRaw],
        "ity_cluster",
            SWITCH (
                TRUE (),
                [@EndDateRaw] <= _BasisFY_Ende, "Roll",
                [@EndDateRaw] <= _FolgeFY_Ende, "ITY",
                BLANK ()
            ),
        "Calc_ITY_Months", 12,
        "Phasenwechsel", [@FirstFYEnd],
        "ITY_Value", [@Monatswert],
        "ARO_Value", [@Monatswert]
    )


// ---------------------------------------------------------------------
// fct_budget_effect
// Grain: 1 Zeile je (effect_type, entity_id, Period_Date)
//
// Harmonisierung der beiden Phasing-Tabellen auf ihre gemeinsame Achse:
// Periode und SAP-Betrieb. Nur hier ist die Vereinigung fachlich korrekt -
// die Quelltabellen bleiben getrennt, weil Opportunity und Contract
// unterschiedliche Geschaeftsobjekte mit disjunkten Attributen sind.
// ---------------------------------------------------------------------
fct_budget_effect =
UNION (
    SELECTCOLUMNS (
        fct_opp_phasing,
        "effect_type", "New Business",
        "entity_id", fct_opp_phasing[opportunityid],
        "sap_unit", fct_opp_phasing[sap_unit],
        "Period_Date", fct_opp_phasing[Period_Date],
        "Referenzdatum", fct_opp_phasing[Referenzdatum],
        "ity_cluster", fct_opp_phasing[ity_cluster],
        "Phasenwechsel", fct_opp_phasing[Phasenwechsel],
        "ITY_Value", fct_opp_phasing[ITY_Value],
        "ARO_Value", fct_opp_phasing[ARO_Value]
    ),
    SELECTCOLUMNS (
        fct_retention_phasing,
        "effect_type", "Retention",
        "entity_id", fct_retention_phasing[cgplc_cgcontractid],
        "sap_unit", fct_retention_phasing[sap_unit],
        "Period_Date", fct_retention_phasing[Period_Date],
        "Referenzdatum", fct_retention_phasing[Referenzdatum],
        "ity_cluster", fct_retention_phasing[ity_cluster],
        "Phasenwechsel", fct_retention_phasing[Phasenwechsel],
        // Explizit auf DOUBLE: die Opportunity-Seite liefert das Ergebnis
        // von DIVIDE, die Retention-Seite einen Waehrungswert. UNION
        // verlangt vergleichbare Typen je Position.
        "ITY_Value", CONVERT ( fct_retention_phasing[ITY_Value], DOUBLE ),
        "ARO_Value", CONVERT ( fct_retention_phasing[ARO_Value], DOUBLE )
    )
)
