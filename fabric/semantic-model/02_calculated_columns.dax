// =====================================================================
// Berechnete Spalten und Dimensionen im Semantic Model
//
// Ersetzt die Klassifizierungs- und Textspalten, die bisher in Power
// Query erzeugt wurden (win_status, Ret_Status, ity_cluster,
// LY_ARO_Status, Info) sowie die separaten dim_* Queries gegen das CRM.
// Damit bleibt der Dataflow der einzige Kontaktpunkt zum CRM.
// =====================================================================


// ---------------------------------------------------------------------
// Berechnete Spalten auf fct_opportunity
// ---------------------------------------------------------------------

fct_opportunity[win_status] =
SWITCH (
    TRUE (),
    ISBLANK ( fct_opportunity[cgplc_win] ), "Ohne Wahrscheinlichkeit",
    fct_opportunity[cgplc_win] < 0.80, "Pipeline",
    fct_opportunity[cgplc_win] < 1, "Expected Win",
    "Won"
)

fct_opportunity[weighted_aro] =
fct_opportunity[cgplc_revenuearo] * fct_opportunity[cgplc_win]

fct_opportunity[weighted_ity] =
fct_opportunity[cgplc_revenueity] * fct_opportunity[cgplc_win]

// Ordnet die Opportunity dem Geschaeftsjahr ihres erwarteten Abschlusses zu.
fct_opportunity[close_fy] =
VAR _d = fct_opportunity[estimatedclosedate]
VAR _start = IF ( MONTH ( _d ) >= 10, YEAR ( _d ), YEAR ( _d ) - 1 )
RETURN
    IF (
        ISBLANK ( _d ),
        BLANK (),
        "FY" & _start & "/" & RIGHT ( _start + 1, 2 )
    )

// Dauer von Opening bis erwartetem Abschluss - Basis fuer den Sales Cycle.
fct_opportunity[sales_cycle_days] =
DATEDIFF (
    fct_opportunity[cgplc_openingdate],
    fct_opportunity[estimatedclosedate],
    DAY
)

// Ersetzt die alte Info-Textspalte aus Power Query.
fct_opportunity[Info] =
FORMAT ( fct_opportunity[cgplc_win], "0.00 %" ) & " - "
    & FORMAT ( fct_opportunity[cgplc_revenuearo], "#,##0 €" ) & " - "
    & FORMAT ( fct_opportunity[estimatedclosedate], "dd.MM.yyyy" ) & " - "
    & FORMAT ( fct_opportunity[cgplc_openingdate], "dd.MM.yyyy" )


// ---------------------------------------------------------------------
// Berechnete Spalten auf fct_retention
// ---------------------------------------------------------------------

fct_retention[Ret_Status] =
SWITCH (
    TRUE (),
    ISBLANK ( fct_retention[cgplc_retentionprobability] ), "No %",
    fct_retention[cgplc_retentionprobability] = 0, "Lost",
    fct_retention[cgplc_retentionprobability] <= 0.2, "Expected Loss",
    fct_retention[cgplc_retentionprobability] < 1, "At Risk",
    "No Risk"
)

fct_retention[LY_ARO_Status] =
IF (
    ISBLANK ( fct_retention[cgplc_lastfyrevenuearo] ),
    "No ARO in CRM",
    "ARO in CRM"
)

// Effektives Vertragsende inkl. Ersatzlogik ueber das Entscheidungsdatum.
fct_retention[effective_enddate] =
COALESCE (
    fct_retention[cgplc_contractenddate],
    EDATE ( fct_retention[cgplc_decisiondate], 3 )
)

fct_retention[days_to_decision] =
DATEDIFF (
    TODAY (),
    COALESCE (
        fct_retention[cgplc_forecastdecisiondate],
        fct_retention[cgplc_decisiondate]
    ),
    DAY
)


// ---------------------------------------------------------------------
// Dimensionen aus den Fakten ableiten
// Ersetzt dim_opp_owner, dim_opp_sector, dim_opp_subsector,
// dim_opp_territory, dim_opp_contracttype, dim_opp_currentsupplier,
// dim_opp_account, dim_opp_parent, dim_opp_name, dim_opp_contractid,
// dim_opp_sapid - alle bisher als eigene CRM-Abfragen.
// ---------------------------------------------------------------------

dim_owner =
DISTINCT (
    SELECTCOLUMNS ( fct_opportunity, "ownerid", fct_opportunity[ownerid] )
)

dim_sector =
DISTINCT (
    SELECTCOLUMNS (
        fct_opportunity,
        "sector", fct_opportunity[cgplc_sectorlookup],
        "subsector", fct_opportunity[cgplc_subsector]
    )
)

dim_territory =
DISTINCT (
    SELECTCOLUMNS (
        fct_opportunity,
        "territoryid", fct_opportunity[cgplc_territoryid]
    )
)

dim_contracttype =
DISTINCT (
    SELECTCOLUMNS (
        fct_opportunity,
        "contracttype", fct_opportunity[cgplc_contracttypelookup]
    )
)

dim_currentsupplier =
DISTINCT (
    SELECTCOLUMNS (
        fct_opportunity,
        "currentsupplier", fct_opportunity[cgplc_currentsupplier]
    )
)

dim_account =
DISTINCT (
    UNION (
        SELECTCOLUMNS ( fct_opportunity, "accountid", fct_opportunity[accountid] ),
        SELECTCOLUMNS ( fct_opportunity, "accountid", fct_opportunity[parentaccountid] )
    )
)


// ---------------------------------------------------------------------
// dim_unit
// Konforme Betriebsdimension fuer fct_budget_effect.
//
// Die SAP-Stammdaten kennen nur Betriebe, die es bereits gibt. Genau die
// Units, um die es im Net-New-Budget geht, sind dort noch nicht enthalten:
// sie sind noch nicht gewonnen und werden im Budget- und Forecast-Prozess
// manuell gemappt. Wuerde die Dimension nur aus den SAP-Stammdaten
// aufgebaut, fielen diese Effekte beim Schneiden nach Betrieb in die
// Blank-Zeile - also ausgerechnet der Teil, den der Report zeigen soll.
//
// Deshalb: SAP-Stammdaten vereinigt mit den ausschliesslich im Mapping
// vorkommenden Units, unterschieden ueber unit_status.
// ---------------------------------------------------------------------
dim_unit =
VAR _SapKeys =
    SELECTCOLUMNS (
        dim_sap_master_data_unit,
        "sap_unit", dim_sap_master_data_unit[betrieb]
    )
VAR _SapUnits =
    SELECTCOLUMNS (
        dim_sap_master_data_unit,
        "sap_unit", dim_sap_master_data_unit[betrieb],
        "unit_status", "In Betrieb",
        "bezeichnung", dim_sap_master_data_unit[bezeichnung_betrieb],
        "sektor", dim_sap_master_data_unit[sektor],
        "bezirk", dim_sap_master_data_unit[bezeichnung_bezirk]
    )
VAR _MappedKeys =
    DISTINCT (
        SELECTCOLUMNS ( map_opportunity_unit, "sap_unit", map_opportunity_unit[sap_unit] )
    )
VAR _PlannedUnits =
    ADDCOLUMNS (
        EXCEPT ( _MappedKeys, _SapKeys ),
        "unit_status", "Geplant",
        "bezeichnung", "Noch nicht gewonnen",
        "sektor", BLANK (),
        "bezirk", BLANK ()
    )
RETURN
    UNION ( _SapUnits, _PlannedUnits )


// Sektor der Retention ueber den SAP-Betrieb erben.
// Auf der Opportunity-Seite kommt der Sektor aus dem CRM, auf der
// Retention-Seite gibt es ihn nur ueber die Stammdaten - damit wird der
// Nettoeffekt auch nach Sektor schneidbar, soweit die Unit in SAP existiert.
fct_retention[sektor] =
LOOKUPVALUE (
    dim_sap_master_data_unit[sektor],
    dim_sap_master_data_unit[betrieb], fct_retention[cgplc_sapid]
)
