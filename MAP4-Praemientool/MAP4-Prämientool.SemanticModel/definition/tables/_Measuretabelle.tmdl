/// Zentrale Measure-Tabelle. Alle Kennzahlen liegen hier, gegliedert nach Anzeigeordnern.
/// Grundregel des Modells: Measures filtern ueber die dim_-Tabellen, nie direkt ueber
/// Spalten der Faktentabelle. Dadurch bleibt jeder Filterweg nachvollziehbar.
table _Measuretabelle
	lineageTag: 448d0ed6-170a-40cf-a8a9-fe83c736205a

	/// Rohsumme ueber alle Konten und alle Versionen. Nur als Baustein gedacht -
	/// im Bericht bitte [UP] oder [Revenue] verwenden.
	measure 'Value (Basis)' = SUM(F_SAP[Value])
		formatString: #,0
		displayFolder: 01 Basis
		isHidden
		lineageTag: 6d986c22-e56c-44c3-a578-8176d182bb1b

	/// UP = Summe ueber ALLE Konten der Ergebnisrechnung (Type = "P&L"), ohne Revenue-Filter.
	measure UP =
			CALCULATE(
			    [Value (Basis)],
			    dim_Konto[Type] = "P&L"
			)
		formatString: #,0
		displayFolder: 01 Basis
		lineageTag: 3f2a7c10-1001-4a10-9d31-1f5a2c7e1001

	/// Revenue = UP eingeschraenkt auf den Hierarchieknoten Total Revenue.
	measure Revenue =
			CALCULATE(
			    [UP],
			    dim_Konto[Level_2_Key] = "IS10000_T - Total Revenue inkl. IFRS/ NEUTRA/MGMT"
			)
		formatString: #,0
		displayFolder: 01 Basis
		lineageTag: cae6e3cf-b264-41a7-ae22-51036da26a44

	/// Budget = SAP-Version 20 ueber alle Perioden.
	/// REMOVEFILTERS(dim_Szenario) setzt eine ggf. am Visual haengende Szenarioauswahl zurueck,
	/// damit Budget und FC nebeneinander in derselben Matrix stehen koennen.
	measure 'Revenue Budget' =
			CALCULATE(
			    [Revenue],
			    REMOVEFILTERS(dim_Szenario),
			    dim_Szenario[Szenario] = "Budget"
			)
		formatString: #,0
		displayFolder: 02 Szenario\Revenue
		lineageTag: 6e48972d-e94e-4880-a783-ea46e58eb2e5

	/// FC = YTD aus SAP-Version 0 (Actuals) + YTG aus SAP-Version RGF und R12.
	/// Die Periodenlogik steckt im Schluessel dim_Szenario[Szenario_Key], nicht in dieser Measure.
	measure 'Revenue FC' =
			CALCULATE(
			    [Revenue],
			    REMOVEFILTERS(dim_Szenario),
			    dim_Szenario[Szenario] = "FC"
			)
		formatString: #,0
		displayFolder: 02 Szenario\Revenue
		lineageTag: 3f2a7c10-1002-4a10-9d31-1f5a2c7e1002

	measure 'Revenue FC vs Budget' = [Revenue FC] - [Revenue Budget]
		formatString: #,0
		displayFolder: 02 Szenario\Revenue
		lineageTag: 3f2a7c10-1003-4a10-9d31-1f5a2c7e1003

	measure 'UP Budget' =
			CALCULATE(
			    [UP],
			    REMOVEFILTERS(dim_Szenario),
			    dim_Szenario[Szenario] = "Budget"
			)
		formatString: #,0
		displayFolder: 02 Szenario\UP
		lineageTag: 3f2a7c10-1004-4a10-9d31-1f5a2c7e1004

	measure 'UP FC' =
			CALCULATE(
			    [UP],
			    REMOVEFILTERS(dim_Szenario),
			    dim_Szenario[Szenario] = "FC"
			)
		formatString: #,0
		displayFolder: 02 Szenario\UP
		lineageTag: 3f2a7c10-1005-4a10-9d31-1f5a2c7e1005

	measure 'UP FC vs Budget' = [UP FC] - [UP Budget]
		formatString: #,0
		displayFolder: 02 Szenario\UP
		lineageTag: 3f2a7c10-1006-4a10-9d31-1f5a2c7e1006

	/// Der Split Pacht/Mandat funktioniert im Regelfall einfach dadurch, dass
	/// dim_PachtMandat[Pacht/Mandat] in Zeilen, Spalten oder Slicer gezogen wird.
	/// Die folgenden Measures sind fuer feste Gegenueberstellungen gedacht, bei denen
	/// beide Auspraegungen nebeneinander in einem Visual stehen sollen.
	measure 'Revenue Budget Pacht' =
			CALCULATE(
			    [Revenue Budget],
			    REMOVEFILTERS(dim_PachtMandat),
			    dim_PachtMandat[Pacht/Mandat] = "Pacht"
			)
		formatString: #,0
		displayFolder: 03 Pacht-Mandat\Revenue
		lineageTag: 3f2a7c10-1010-4a10-9d31-1f5a2c7e1010

	measure 'Revenue Budget Mandat' =
			CALCULATE(
			    [Revenue Budget],
			    REMOVEFILTERS(dim_PachtMandat),
			    dim_PachtMandat[Pacht/Mandat] = "Mandat"
			)
		formatString: #,0
		displayFolder: 03 Pacht-Mandat\Revenue
		lineageTag: 3f2a7c10-1011-4a10-9d31-1f5a2c7e1011

	measure 'Revenue FC Pacht' =
			CALCULATE(
			    [Revenue FC],
			    REMOVEFILTERS(dim_PachtMandat),
			    dim_PachtMandat[Pacht/Mandat] = "Pacht"
			)
		formatString: #,0
		displayFolder: 03 Pacht-Mandat\Revenue
		lineageTag: 3f2a7c10-1012-4a10-9d31-1f5a2c7e1012

	measure 'Revenue FC Mandat' =
			CALCULATE(
			    [Revenue FC],
			    REMOVEFILTERS(dim_PachtMandat),
			    dim_PachtMandat[Pacht/Mandat] = "Mandat"
			)
		formatString: #,0
		displayFolder: 03 Pacht-Mandat\Revenue
		lineageTag: 3f2a7c10-1013-4a10-9d31-1f5a2c7e1013

	measure 'UP Budget Pacht' =
			CALCULATE(
			    [UP Budget],
			    REMOVEFILTERS(dim_PachtMandat),
			    dim_PachtMandat[Pacht/Mandat] = "Pacht"
			)
		formatString: #,0
		displayFolder: 03 Pacht-Mandat\UP
		lineageTag: 3f2a7c10-1014-4a10-9d31-1f5a2c7e1014

	measure 'UP Budget Mandat' =
			CALCULATE(
			    [UP Budget],
			    REMOVEFILTERS(dim_PachtMandat),
			    dim_PachtMandat[Pacht/Mandat] = "Mandat"
			)
		formatString: #,0
		displayFolder: 03 Pacht-Mandat\UP
		lineageTag: 3f2a7c10-1015-4a10-9d31-1f5a2c7e1015

	measure 'UP FC Pacht' =
			CALCULATE(
			    [UP FC],
			    REMOVEFILTERS(dim_PachtMandat),
			    dim_PachtMandat[Pacht/Mandat] = "Pacht"
			)
		formatString: #,0
		displayFolder: 03 Pacht-Mandat\UP
		lineageTag: 3f2a7c10-1016-4a10-9d31-1f5a2c7e1016

	measure 'UP FC Mandat' =
			CALCULATE(
			    [UP FC],
			    REMOVEFILTERS(dim_PachtMandat),
			    dim_PachtMandat[Pacht/Mandat] = "Mandat"
			)
		formatString: #,0
		displayFolder: 03 Pacht-Mandat\UP
		lineageTag: 3f2a7c10-1017-4a10-9d31-1f5a2c7e1017

	/// Liest den Schalter sw_Ergebnisziel aus. 1 = erreicht, 0 = nicht erreicht.
	/// Ohne Auswahl (oder bei Mehrfachauswahl) gilt bewusst "nicht erreicht".
	measure 'Faktor Ergebnisziel' = SELECTEDVALUE(sw_Ergebnisziel[Faktor], 0)
		formatString: 0
		displayFolder: 04 Prämien\Schalter
		isHidden
		lineageTag: 3f2a7c10-1020-4a10-9d31-1f5a2c7e1020

	/// Liest den Schalter sw_HSE_TRIFR aus. 1 = erreicht, 0 = nicht erreicht.
	measure 'Faktor HSE-TRIFR' = SELECTEDVALUE(sw_HSE_TRIFR[Faktor], 0)
		formatString: 0
		displayFolder: 04 Prämien\Schalter
		isHidden
		lineageTag: 3f2a7c10-1021-4a10-9d31-1f5a2c7e1021

	/// Ergebnisziel Compass Group Deutschland: konzernweite Groesse, wird ueber den
	/// Schalter sw_Ergebnisziel gesetzt.
	measure 'Ziel erreicht Ergebnis CGD' = [Faktor Ergebnisziel]
		formatString: 0
		displayFolder: 04 Prämien\Zielerreichung
		lineageTag: 3f2a7c10-1040-4a10-9d31-1f5a2c7e1040

	/// HSE-TRIFR: konzernweite Groesse, wird ueber den Schalter sw_HSE_TRIFR gesetzt.
	measure 'Ziel erreicht HSE-TRIFR' = [Faktor HSE-TRIFR]
		formatString: 0
		displayFolder: 04 Prämien\Zielerreichung
		lineageTag: 3f2a7c10-1041-4a10-9d31-1f5a2c7e1041

	/// Umsatzziel: erreicht, wenn das Delta aus Revenue FC und Revenue Budget nicht negativ ist.
	/// Die Deltaform (statt FC >= Budget * Schwelle) haelt auch bei negativen Budgets
	/// die Richtung korrekt. Fuer eine Toleranzschwelle die 0 durch
	/// -(ABS(Ziel) * (1 - Schwelle)) ersetzen.
	measure 'Ziel erreicht Umsatz' =
			VAR Ziel = [Revenue Budget]
			VAR Ist = [Revenue FC]
			RETURN
			IF(
			    ISBLANK(Ziel) && ISBLANK(Ist),
			    BLANK(),
			    IF(COALESCE(Ist, 0) - COALESCE(Ziel, 0) >= 0, 1, 0)
			)
		formatString: 0
		displayFolder: 04 Prämien\Zielerreichung
		lineageTag: 3f2a7c10-1042-4a10-9d31-1f5a2c7e1042

	/// UP-Ziel: erreicht, wenn das Delta aus UP FC und UP Budget nicht negativ ist.
	measure 'Ziel erreicht UP' =
			VAR Ziel = [UP Budget]
			VAR Ist = [UP FC]
			RETURN
			IF(
			    ISBLANK(Ziel) && ISBLANK(Ist),
			    BLANK(),
			    IF(COALESCE(Ist, 0) - COALESCE(Ziel, 0) >= 0, 1, 0)
			)
		formatString: 0
		displayFolder: 04 Prämien\Zielerreichung
		lineageTag: 3f2a7c10-1043-4a10-9d31-1f5a2c7e1043

	/// Compliance-Ziel: geht nach Compliance[Status Zielerfuellung] = "ja".
	/// Bei mehreren Betrieben (Abrechnungseinheit oder Person) muessen ALLE Betriebe "ja"
	/// tragen. Fuer eine mildere Regel die letzte Zeile auf DIVIDE(MitJa, Bewertbare) >= 0,5
	/// aendern. DAX vergleicht Text ohne Beachtung der Gross-/Kleinschreibung, "Ja" passt also.
	measure 'Ziel erreicht Compliance' =
			VAR Bewertbare = COUNTROWS(Compliance)
			VAR MitJa =
			    CALCULATE(
			        COUNTROWS(Compliance),
			        FILTER(Compliance, TRIM(Compliance[Status Zielerfüllung]) = "ja")
			    )
			RETURN
			IF(
			    ISBLANK(Bewertbare),
			    BLANK(),
			    IF(COALESCE(MitJa, 0) = Bewertbare, 1, 0)
			)
		formatString: 0
		displayFolder: 04 Prämien\Zielerreichung
		lineageTag: 3f2a7c10-1044-4a10-9d31-1f5a2c7e1044

	/// Generische Zielerreichung: waehlt anhand von dim_Praemienart[Zielart] die passende Logik.
	/// Dafuer gedacht, dass dim_Praemienart[Prämienziel] auf den Zeilen eines Visuals liegt.
	measure 'Ziel erreicht' =
			VAR Zielart = SELECTEDVALUE(dim_Praemienart[Zielart])
			RETURN
			SWITCH(
			    Zielart,
			    "ERGEBNIS_CGD", [Ziel erreicht Ergebnis CGD],
			    "HSE_TRIFR", [Ziel erreicht HSE-TRIFR],
			    "UMSATZ", [Ziel erreicht Umsatz],
			    "UP", [Ziel erreicht UP],
			    "COMPLIANCE", [Ziel erreicht Compliance],
			    BLANK()
			)
		formatString: 0
		displayFolder: 04 Prämien\Zielerreichung
		lineageTag: 3f2a7c10-1045-4a10-9d31-1f5a2c7e1045

	measure 'Ziel erreicht (Text)' =
			VAR Wert = [Ziel erreicht]
			RETURN
			IF(ISBLANK(Wert), BLANK(), IF(Wert = 1, "erreicht", "nicht erreicht"))
		displayFolder: 04 Prämien\Zielerreichung
		lineageTag: 3f2a7c10-1046-4a10-9d31-1f5a2c7e1046

	/// Maximal erreichbare Punkte.
	/// TREATAS beschraenkt die Punktetabelle auf die Vertragsart der Betriebe im Filterkontext.
	/// Noetig, weil dim_Betrieb -> dim_PachtMandat bewusst nur in eine Richtung filtert: ohne
	/// TREATAS wuerden bei einem Pacht-Betrieb auch die Mandats-Punkte mitgezaehlt.
	measure 'Prämienpunkte max' =
			VAR Vertragsarten = CALCULATETABLE(VALUES(dim_Betrieb[Pacht/Mandat]))
			RETURN
			CALCULATE(
			    SUM(tab_Prämienpunkte[Prämienpunkte]),
			    TREATAS(Vertragsarten, tab_Prämienpunkte[Vertragsart])
			)
		formatString: #,0.0
		displayFolder: 04 Prämien
		lineageTag: 3f2a7c10-1022-4a10-9d31-1f5a2c7e1022

	/// Tatsaechlich erreichte Punkte: je Zeile der Punktetabelle wird ueber dim_Praemienart[Zielart]
	/// die passende Zielerreichung bestimmt und mit den Punkten multipliziert.
	/// Die Zielmeasures werden ABSICHTLICH vor dem SUMX in Variablen ausgewertet - sonst
	/// wuerde die Kontextuebertragung sie je Punktezeile neu und falsch berechnen.
	measure 'Prämienpunkte erreicht' =
			VAR Vertragsarten = CALCULATETABLE(VALUES(dim_Betrieb[Pacht/Mandat]))
			VAR ErgebnisCGD = [Ziel erreicht Ergebnis CGD]
			VAR HseTrifr = [Ziel erreicht HSE-TRIFR]
			VAR Umsatz = [Ziel erreicht Umsatz]
			VAR UnitProfit = [Ziel erreicht UP]
			VAR CompStatus = [Ziel erreicht Compliance]
			RETURN
			SUMX(
			    CALCULATETABLE(
			        tab_Prämienpunkte,
			        TREATAS(Vertragsarten, tab_Prämienpunkte[Vertragsart])
			    ),
			    VAR Zielart = RELATED(dim_Praemienart[Zielart])
			    RETURN
			        tab_Prämienpunkte[Prämienpunkte]
			            * COALESCE(
			                SWITCH(
			                    Zielart,
			                    "ERGEBNIS_CGD", ErgebnisCGD,
			                    "HSE_TRIFR", HseTrifr,
			                    "UMSATZ", Umsatz,
			                    "UP", UnitProfit,
			                    "COMPLIANCE", CompStatus,
			                    0
			                ),
			                0
			            )
			)
		formatString: #,0.0
		displayFolder: 04 Prämien
		lineageTag: 3f2a7c10-1023-4a10-9d31-1f5a2c7e1023

	measure 'Zielerreichung %' = DIVIDE([Prämienpunkte erreicht], [Prämienpunkte max])
		formatString: 0.0 %
		displayFolder: 04 Prämien
		lineageTag: 3f2a7c10-1024-4a10-9d31-1f5a2c7e1024

	/// Anzahl der Betriebe im aktuellen Filterkontext.
	measure 'Anzahl Betriebe' = COUNTROWS(dim_Betrieb)
		formatString: 0
		displayFolder: 05 Kontrolle
		lineageTag: 3f2a7c10-1030-4a10-9d31-1f5a2c7e1030

	/// Datenqualitaet: Werte, deren SAP-Version|YTD-YTG in dim_Szenario nicht hinterlegt ist.
	/// Sollte 0 sein - sonst fehlen Versionen in dim_Szenario und die Werte tauchen weder
	/// im Budget noch im FC auf.
	measure 'Kontrolle Wert ohne Szenariozuordnung' =
			SUMX(
			    FILTER(
			        CALCULATETABLE(F_SAP, REMOVEFILTERS(dim_Szenario)),
			        ISBLANK(RELATED(dim_Szenario[Szenario]))
			    ),
			    F_SAP[Value]
			)
		formatString: #,0
		displayFolder: 05 Kontrolle
		lineageTag: 3f2a7c10-1032-4a10-9d31-1f5a2c7e1032

	/// Datenqualitaet: Werte, deren Account in dim_Konto fehlt. Sollte 0 sein -
	/// diese Werte wuerden sonst weder im UP noch im Revenue auftauchen.
	measure 'Kontrolle Wert ohne Kontozuordnung' =
			SUMX(
			    FILTER(
			        CALCULATETABLE(F_SAP, REMOVEFILTERS(dim_Konto)),
			        ISBLANK(RELATED(dim_Konto[Kostenart_Key]))
			    ),
			    F_SAP[Value]
			)
		formatString: #,0
		displayFolder: 05 Kontrolle
		lineageTag: 3f2a7c10-1033-4a10-9d31-1f5a2c7e1033

	/// Datenqualitaet: Werte, deren Object_group in dim_Betrieb fehlt. Sollte 0 sein.
	measure 'Kontrolle Wert ohne Betriebszuordnung' =
			SUMX(
			    FILTER(
			        CALCULATETABLE(F_SAP, REMOVEFILTERS(dim_Betrieb)),
			        ISBLANK(RELATED(dim_Betrieb[betrieb]))
			    ),
			    F_SAP[Value]
			)
		formatString: #,0
		displayFolder: 05 Kontrolle
		lineageTag: 3f2a7c10-1034-4a10-9d31-1f5a2c7e1034

	/// Alle Betriebe der aktuellen Abrechnungseinheit als Text - zur Sichtpruefung des Sets.
	measure 'Betriebe der Abrechnungseinheit' =
			CONCATENATEX(
			    VALUES(dim_Betrieb[Werk - Bezeichnung]),
			    dim_Betrieb[Werk - Bezeichnung],
			    ", ",
			    dim_Betrieb[Werk - Bezeichnung],
			    ASC
			)
		displayFolder: 05 Kontrolle
		lineageTag: 3f2a7c10-1047-4a10-9d31-1f5a2c7e1047

	/// Datenqualitaet: Praemienziele aus der Excel-Datei, die in dim_Praemienart keiner Zielart
	/// zugeordnet sind. Sollte 0 sein - solche Ziele zaehlen mit 0 Punkten.
	measure 'Kontrolle Prämienziele ohne Zielart' =
			CALCULATE(
			    COUNTROWS(dim_Praemienart),
			    REMOVEFILTERS(dim_Praemienart),
			    dim_Praemienart[Zielart] = "UNBEKANNT"
			)
		formatString: 0
		displayFolder: 05 Kontrolle
		lineageTag: 3f2a7c10-1048-4a10-9d31-1f5a2c7e1048

	/// Datenqualitaet Betriebeset: Zuordnungen, die eine KETTE bilden, also einen
	/// Abrechnungsbetrieb nennen, der selbst weiterverwiesen wird (1201 -> 1200, 1200 -> 1100).
	/// Solche Ketten zerreissen das Set. Sollte 0 sein.
	measure 'Kontrolle Betriebeset Ketten' =
			VAR Abrechnungsbetriebe =
			    CALCULATETABLE(VALUES(tab_Betriebeset[Abrechnungsbetrieb]), REMOVEFILTERS(tab_Betriebeset))
			VAR Zugeordnete =
			    CALCULATETABLE(VALUES(tab_Betriebeset[Betrieb]), REMOVEFILTERS(tab_Betriebeset))
			RETURN
			COUNTROWS(
			    FILTER(Abrechnungsbetriebe, tab_Betriebeset[Abrechnungsbetrieb] IN Zugeordnete)
			) + 0
		formatString: 0
		displayFolder: 05 Kontrolle
		lineageTag: 3f2a7c10-1049-4a10-9d31-1f5a2c7e1049

	/// Datenqualitaet Betriebeset: Abrechnungseinheiten, die Pacht- UND Mandats-Betriebe
	/// mischen. Dort zaehlen [Praemienpunkte max] und [Praemienpunkte erreicht] die Punkte
	/// beider Vertragsarten zusammen. Sollte 0 sein.
	measure 'Kontrolle Abrechnungseinheiten gemischte Vertragsart' =
			COUNTROWS(
			    FILTER(
			        VALUES(dim_Betrieb[Abrechnungsbetrieb]),
			        CALCULATE(DISTINCTCOUNT(dim_Betrieb[Pacht/Mandat])) > 1
			    )
			) + 0
		formatString: 0
		displayFolder: 05 Kontrolle
		lineageTag: 3f2a7c10-104a-4a10-9d31-1f5a2c7e104a

	column Spalte1
		dataType: string
		isHidden
		lineageTag: 734f315c-e690-47bc-b516-9e2f8fca5b19
		summarizeBy: none
		sourceColumn: Spalte1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Measuretabelle = m
		mode: import
		source =
				let
				  Quelle = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Spalte1 = _t])
				in
				  Quelle

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
