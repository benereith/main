model Model
	culture: de-DE
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: de-DE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameter

	annotation PBI_QueryGroupOrder = 0

queryGroup Funktionen

	annotation PBI_QueryGroupOrder = 1

queryGroup Staging

	annotation PBI_QueryGroupOrder = 2

queryGroup Dimensionen

	annotation PBI_QueryGroupOrder = 3

queryGroup Fakten

	annotation PBI_QueryGroupOrder = 4

queryGroup Kennzahlen

	annotation PBI_QueryGroupOrder = 5

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Geschäftsjahr","Startperiode","Aktuelle_Periode","Managementbereiche","FC_Versionen","SAP_Versionen","Planbetriebe_Roll","Planbetriebe_ITY","Kommentar_SQL_Endpoint","Kommentar_Datenbank","fnPeriodeStart","Quelle_Unit","Quelle_Übergabe","Quelle_Datenlage","Quelle_SAP","Fakt_SAP","Dim_UnitStatus","Dim_Unit","Dim_Datum","Dim_Konto","Kommentare","_Kennzahlen","p_Zeitbezug","p_Kanne_Abrechnung","p_TopN","p_Kategorie","p_Eingabe"]

annotation PBI_ProTooling = ["WebModelingEdit","DevMode"]

ref table Fakt_SAP
ref table Dim_UnitStatus
ref table Dim_Unit
ref table Dim_Datum
ref table Dim_Konto
ref table Kommentare
ref table _Kennzahlen
ref table p_Zeitbezug
ref table p_Kanne_Abrechnung
ref table p_TopN
ref table p_Kategorie
ref table p_Eingabe

ref cultureInfo de-DE
