/// Alle SAP-Versionen, die als Forecast gelten. Nur für die Datenprüfung (Hat Forecastwerte) in Dim_UnitStatus.
/// Der aktuelle Forecast im Bericht ist ausschließlich RGF + R12 (siehe Measure Forecast).
expression FC_Versionen = {"RF", "RGF", "35", "R12", "RTD"}
	lineageTag: 7f995a88-6f33-5c46-9873-4358e25eee3a
