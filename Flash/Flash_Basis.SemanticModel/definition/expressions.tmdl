/// Wandelt Geschäftsjahr + SAP-Periode in den ersten Kalendertag des Monats um.
/// Periode 1-3 = Oktober bis Dezember des Geschäftsjahres, Periode 4-12 = Januar bis September des Folgejahres.
/// Einzige Quelle dieser Regel in Power Query: Dim_Datum und Dim_UnitStatus rechnen damit exakt gleich.
expression fnPeriodeStart = ```
		(Jahr as number, Periode as number) as date =>
		let
		    Monat = if Periode <= 3 then Periode + 9 else Periode - 3,
		    Kalenderjahr = if Periode <= 3 then Jahr else Jahr + 1
		in
		    #date(Kalenderjahr, Monat, 1)
		```
	lineageTag: de798f41-7bb5-5fb0-bc0a-608a78a3f62d
	queryGroup: Funktionen

	annotation PBI_ResultType = Function

/// Stammdaten der Units aus dem Dataflow, gefiltert auf die Managementbereiche. Nicht geladen (Staging).
/// Basis für Dim_Unit, Dim_UnitStatus und die Bereinigung von Fakt_SAP.
expression Quelle_Unit = ```
		let
		    Quelle = PowerPlatform.Dataflows(null),
		    Workspaces = Quelle{[Id = "Workspaces"]}[Data],
		    Workspace = Workspaces{[workspaceId = "ddc66bda-5a20-49f0-be6e-b68e17a1cc90"]}[Data],
		    Dataflow = Workspace{[dataflowId = "a65e47b1-6a8b-4cf2-8131-c90e55bf14c7"]}[Data],
		    Stammdaten = Dataflow{[entity = "sap_master_data_unit", version = ""]}[Data],

		    // Zuerst filtern, damit alle weiteren Schritte weniger Zeilen sehen
		    Gefiltert = Table.SelectRows(Stammdaten, each List.Contains(Managementbereiche, [bezeichnung_management])),
		    Spalten = Table.SelectColumns(Gefiltert, {"betrieb", "bezeichnung_betrieb", "buchungskreis", "sektor", "vertragsart", "innenauftragsart", "bezirk", "service", "bezeichnung_management", "verantwortungsbereich", "bezeichnung_region"})
		in
		    Spalten
		```
	lineageTag: 1fe06c49-c5c5-5711-9158-6f06b0162b1e
	queryGroup: Staging

	annotation PBI_ResultType = Table

/// Späteste FIBU- und Flash-Übergabe je Werk aus IA_Stammdaten.XLSX (SharePoint Group Controlling). Nicht geladen (Staging).
/// Achtung: Die Datei enthält nur den jeweils aktuellen Stand, keine Historie. Für vergangene Monate wird der Status
/// daher aus diesem einen Datum abgeleitet (siehe Dim_UnitStatus).
expression Quelle_Übergabe = ```
		let
		    Quelle = SharePoint.Contents("https://cpgplc.sharepoint.com/sites/GroupControlling", [ApiVersion = 15]),
		    SharedDocuments = Quelle{[Name = "Shared Documents"]}[Content],
		    GroupControlling = SharedDocuments{[Name = "Group Controlling"]}[Content],
		    Flash = GroupControlling{[Name = "Flash"]}[Content],
		    Input = Flash{[Name = "01_Input"]}[Content],
		    Stammdaten = Input{[Name = "IA_Stammdaten.XLSX"]}[Content],
		    Arbeitsmappe = Excel.Workbook(Stammdaten),
		    Blatt = Arbeitsmappe{[Item = "Sheet1", Kind = "Sheet"]}[Data],
		    Kopfzeile = Table.PromoteHeaders(Blatt, [PromoteAllScalars = true]),
		    Spalten = Table.SelectColumns(Kopfzeile, {"Werk", "FibuübergFaktKalJahr", "FlashÜbergabedatum"}),
		    Typen = Table.TransformColumnTypes(Spalten, {{"Werk", Int64.Type}, {"FibuübergFaktKalJahr", type date}, {"FlashÜbergabedatum", type date}}),
		    MitWerk = Table.SelectRows(Typen, each [Werk] <> null),

		    // Je Werk das jeweils späteste Übergabedatum. Die Bewertung gegen einen Monat
		    // passiert bewusst erst in Dim_UnitStatus - dort je Periode.
		    Gruppiert = Table.Group(MitWerk, {"Werk"}, {
		        {"FIBU_Übergabe", each List.Max([FibuübergFaktKalJahr]), type nullable date},
		        {"Flash_Übergabe", each List.Max([FlashÜbergabedatum]), type nullable date}
		    })
		in
		    Gruppiert
		```
	lineageTag: 9fc27a80-6534-58ae-9c30-e21f9c4c841e
	queryGroup: Staging

	annotation PBI_ResultType = Table

/// Je Werk und Periode: liegen Actuals (Version 0), Budget (Version 20) oder Forecastwerte (FC_Versionen) mit Wert <> 0 vor?
/// Wird im Warehouse aggregiert, damit nur eine Zeile je Werk und Periode ins Modell kommt. Nicht geladen (Staging).
expression Quelle_Datenlage = ```
		let
		    Quelle = Sql.Database("3w3wftkijo6ujehh4fb2eleovu-tuq7lxe5lznu7hpei5nzy67o3e.datawarehouse.pbidedicated.windows.net", "Reporting"),
		    FC_Liste = Text.Combine(List.Transform(FC_Versionen, each "'" & _ & "'"), ", "),
		    Abfrage = Value.NativeQuery(
		        Quelle,
		        "SELECT
		            Object_group AS Werk,
		            CAST(Period AS INT) AS Periode,
		            MAX(CASE WHEN SAP_Version = '0'  AND [Value] <> 0 THEN 1 ELSE 0 END) AS Hat_Actuals,
		            MAX(CASE WHEN SAP_Version = '20' AND [Value] <> 0 THEN 1 ELSE 0 END) AS Hat_Budget,
		            MAX(CASE WHEN SAP_Version IN (" & FC_Liste & ") AND [Value] <> 0 THEN 1 ELSE 0 END) AS Hat_Forecast
		         FROM V_SAP_EXPORTS_cleansed
		         WHERE Object_type = 'OR'
		           AND CAST(Fiscal_Year AS INT) = @Jahr
		           AND CAST(Period AS INT) BETWEEN @VonPeriode AND @BisPeriode
		         GROUP BY Object_group, CAST(Period AS INT)",
		        [Jahr = Geschäftsjahr, VonPeriode = Startperiode, BisPeriode = Aktuelle_Periode]
		    ),
		    Typen = Table.TransformColumnTypes(Abfrage, {"Werk", Int64.Type}, {"Periode", Int64.Type}, {"Hat_Actuals", Int64.Type}, {"Hat_Budget", Int64.Type}, {"Hat_Forecast", Int64.Type}),
		    Logisch = Table.TransformColumns(Typen, {"Hat_Actuals", each _ = 1, type logical}, {"Hat_Budget", each _ = 1, type logical}, {"Hat_Forecast", each _ = 1, type logical})
		in
		    Logisch
		```
	lineageTag: 85726fe6-726a-5e20-8ebd-8bda677e8fcc
	queryGroup: Staging

	annotation PBI_ResultType = Table

/// SAP-Export (Objekttyp OR) für die geladenen Perioden, im Warehouse auf Werk x Periode x Konto x Version aggregiert
/// und auf die benötigten Spalten reduziert. Nicht geladen (Staging).
/// Der Status_Key (Werk * 1.000.000 + Geschäftsjahr * 100 + Periode) muss exakt wie in Dim_UnitStatus und
/// dbo.Flash_Kommentare gebildet werden.
expression Quelle_SAP = ```
		let
		    Quelle = Sql.Database("3w3wftkijo6ujehh4fb2eleovu-tuq7lxe5lznu7hpei5nzy67o3e.datawarehouse.pbidedicated.windows.net", "Reporting"),
		    VersionsListe = Text.Combine(List.Transform(SAP_Versionen, each "'" & _ & "'"), ", "),
		    Abfrage = Value.NativeQuery(
		        Quelle,
		        "SELECT
		            Object_group AS Werk,
		            CAST(Object_group AS BIGINT) * 1000000 + CAST(Fiscal_Year AS BIGINT) * 100 + CAST(Period AS BIGINT) AS Status_Key,
		            Account AS Konto,
		            SAP_Version AS [Version],
		            SUM([Value]) AS Wert
		         FROM V_SAP_EXPORTS_cleansed
		         WHERE Object_type = 'OR'
		           AND CAST(Fiscal_Year AS INT) = @Jahr
		           AND CAST(Period AS INT) BETWEEN @VonPeriode AND @BisPeriode
		           AND SAP_Version IN (" & VersionsListe & ")
		         GROUP BY Object_group, Fiscal_Year, Period, Account, SAP_Version",
		        [Jahr = Geschäftsjahr, VonPeriode = Startperiode, BisPeriode = Aktuelle_Periode]
		    ),
		    Typen = Table.TransformColumnTypes(Abfrage, {"Werk", Int64.Type}, {"Status_Key", Int64.Type}, {"Konto", type text}, {"Version", type text}, {"Wert", Currency.Type})
		in
		    Typen
		```
	lineageTag: 5107e4eb-af6d-56ee-bdb7-1ba9565f04f0
	queryGroup: Staging

	annotation PBI_ResultType = Table
