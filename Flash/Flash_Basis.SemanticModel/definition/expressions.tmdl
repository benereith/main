/// Alle SAP-Versionen, die in die Faktentabelle geladen werden: Actuals (0), Budget (20), Version V und alle Forecast-Stände.
expression SAP_Versionen = List.Combine({{"0", "20", "V"}, FC_Versionen})
	lineageTag: d290cf46-7fc3-528c-b012-8ece008baf06
