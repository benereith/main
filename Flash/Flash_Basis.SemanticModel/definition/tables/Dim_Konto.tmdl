	partition Dim_Konto = m
		mode: import
		queryGroup: Dimensionen
		source = ```
				let
				    Quelle = Sql.Databases("3w3wftkijo6ujehh4fb2eleovu-tuq7lxe5lznu7hpei5nzy67o3e.datawarehouse.fabric.microsoft.com"),
				    Reporting = Quelle{[Name = "Reporting"]}[Data],
				    Konten = Reporting{[Schema = "dbo", Item = "tab_accounts_hierarchy"]}[Data],
				    Spalten = Table.SelectColumns(Konten, {"Kostenart", "Kostenart_Beschreibung", "Level_2_Key", "Level_3_Key", "Level_4_Key", "Level_5_Key", "Level_6_Key", "Level_7_Key", "Level_8_Key", "Level_9_Key", "Type"}),
				    Kennzahl = Table.AddColumn(Spalten, "Kennzahl", each
				        if Text.StartsWith([Level_2_Key] ?? "", "IS10000_T") then "Umsatz"
				        else if Text.StartsWith([Level_2_Key] ?? "", "IS20000_T") then "CoS"
				        else if Text.StartsWith([Level_2_Key] ?? "", "IS40000_T") then "Overhead"
				        else null, type nullable text),
				    Umbenannt = Table.RenameColumns(Kennzahl, {
				        {"Kostenart", "Konto"}, {"Kostenart_Beschreibung", "Konto Bezeichnung"}, {"Type", "Typ"},
				        {"Level_2_Key", "GuV Ebene 2"}, {"Level_3_Key", "GuV Ebene 3"}, {"Level_4_Key", "GuV Ebene 4"}, {"Level_5_Key", "GuV Ebene 5"},
				        {"Level_6_Key", "GuV Ebene 6"}, {"Level_7_Key", "GuV Ebene 7"}, {"Level_8_Key", "GuV Ebene 8"}, {"Level_9_Key", "GuV Ebene 9"}
				    }),
				    Ergebnis = Table.SelectColumns(Umbenannt, {"Konto", "Konto Bezeichnung", "GuV Ebene 2", "GuV Ebene 3", "GuV Ebene 4", "GuV Ebene 5", "GuV Ebene 6", "GuV Ebene 7", "GuV Ebene 8", "GuV Ebene 9", "Typ", "Kennzahl"})
				in
				    Ergebnis
				```

	annotation PBI_ResultType = Table
