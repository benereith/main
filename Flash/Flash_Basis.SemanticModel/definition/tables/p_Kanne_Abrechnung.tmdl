/// Steuertabelle ohne Beziehung: Schalter für den Managementbereich Kanne.
/// Kanne wird abweichend abgerechnet. Bei 'Ja' zählen alle Kanne-Units mit ihren Ist-Werten (SAP-Version 0),
/// unabhängig vom Übergabestatus; bei 'Nein' gilt dieselbe Logik wie für alle anderen Bereiche.
/// Wirkt ausschließlich über die Measure Flash und braucht keinen Refresh.
table p_Kanne_Abrechnung
	lineageTag: f79c52bc-1682-59e4-bde6-259b8678a8ef

	/// Auswahlwert: 'Nein' (Standard, Statuslogik) oder 'Ja' (Kanne komplett als Actuals).
	column 'Kanne abgerechnet'
		dataType: string
		lineageTag: edb8752f-cdcc-51d6-9386-1034fbf1bc0a
		summarizeBy: none
		sourceColumn: [Kanne abgerechnet]
		sortByColumn: Sortierung

		annotation SummarizationSetBy = Automatic

	/// Sortierung, damit 'Nein' vor 'Ja' steht.
	column Sortierung
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e43d1de4-b132-502a-8160-7f0eceb62e1c
		summarizeBy: none
		sourceColumn: [Sortierung]

		annotation SummarizationSetBy = Automatic

	partition p_Kanne_Abrechnung = calculated
		mode: import
		source = ```
				DATATABLE(
				    "Kanne abgerechnet", STRING,
				    "Sortierung", INTEGER,
				    {
				        { "Nein", 1 },
				        { "Ja", 2 }
				    }
				)
				```

	annotation PBI_ResultType = Table
